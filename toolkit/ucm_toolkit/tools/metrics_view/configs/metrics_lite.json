{
  "title": "Metrics Lite",
  "metrics": [
    {
      "name": "total_requests",
      "type": "promql",
      "expr": "sum by () (increase(vllm:time_to_first_token_seconds_count[$__rate_interval]))",
      "value": "requests",
      "aggregate": "sum"
    },
    {
      "name": "e2e_request_latency_s",
      "source": "vllm:e2e_request_latency_seconds",
      "type": "histogram",
      "avg": true,
      "quantiles": [
        0.5,
        0.9,
        0.99
      ],
      "unit": "s",
      "aggregate": "avg"
    },
    {
      "name": "ttft_s",
      "source": "vllm:time_to_first_token_seconds",
      "type": "histogram",
      "avg": true,
      "quantiles": [
        0.5,
        0.9,
        0.99
      ],
      "unit": "s",
      "aggregate": "avg"
    },
    {
      "name": "tpot_s",
      "source": "vllm:request_time_per_output_token_seconds",
      "type": "histogram",
      "avg": true,
      "quantiles": [
        0.5,
        0.9,
        0.99
      ],
      "unit": "s",
      "aggregate": "avg"
    },
    {
      "name": "prefix_cache_hit_rate",
      "type": "promql",
      "expr": "sum by () (rate(vllm:prefix_cache_hits_total[$__rate_interval])) / sum by () (rate(vllm:prefix_cache_queries_total[$__rate_interval]))",
      "value": "hit_rate",
      "unit": "ratio",
      "aggregate": "avg"
    },
    {
      "name": "external_prefix_cache_hit_rate",
      "type": "promql",
      "expr": "sum by () (rate(vllm:external_prefix_cache_hits_total[$__rate_interval])) / sum by () (rate(vllm:prefix_cache_queries_total[$__rate_interval]))",
      "value": "hit_rate",
      "unit": "ratio",
      "aggregate": "avg"
    },
    {
      "name": "hbm_hit_rate",
      "type": "promql",
      "expr": "sum by () (rate(ucm:gpu_hbm_hit_tokens_total[$__rate_interval])) / clamp_min(sum by () (rate(ucm:total_prefix_query_tokens_total[$__rate_interval])), 1e-9)",
      "value": "hit_rate",
      "unit": "ratio",
      "aggregate": "avg"
    },
    {
      "name": "cache_hit_rate",
      "type": "promql",
      "expr": "(sum by () (rate(vllm:external_prefix_cache_hits_total[$__rate_interval])) / clamp_min(sum by () (rate(vllm:prefix_cache_queries_total[$__rate_interval])), 1e-9)) * (clamp_min(sum by () (rate(ucm:cache_load_shards_total[$__rate_interval])) - sum by () (rate(ucm:cache_load_backend_shards_total[$__rate_interval])), 0) / clamp_min(sum by () (rate(ucm:cache_load_shards_total[$__rate_interval])), 1e-9))",
      "value": "hit_rate",
      "unit": "ratio",
      "aggregate": "avg"
    },
    {
      "name": "posix_hit_rate",
      "type": "promql",
      "expr": "(sum by () (rate(vllm:external_prefix_cache_hits_total[$__rate_interval])) / clamp_min(sum by () (rate(vllm:prefix_cache_queries_total[$__rate_interval])), 1e-9)) * clamp_max(sum by () (rate(ucm:cache_load_backend_shards_total[$__rate_interval])) / clamp_min(sum by () (rate(ucm:cache_load_shards_total[$__rate_interval])), 1e-9), 1)",
      "value": "hit_rate",
      "unit": "ratio",
      "aggregate": "avg"
    },
    {
      "name": "cache_backend_load_ratio",
      "type": "promql",
      "expr": "sum by () (rate(ucm:posix_lookup_hit_blocks_total[$__rate_interval])) / (sum by () (rate(ucm:cache_lookup_hit_blocks_total[$__rate_interval])) + sum by () (rate(ucm:posix_lookup_hit_blocks_total[$__rate_interval])))",
      "value": "ratio",
      "unit": "ratio",
      "aggregate": "avg"
    },
    {
      "name": "layerwise_wait_blocking_ms",
      "source": "ucm:layerwise_wait_blocking_ms",
      "type": "histogram",
      "avg": true,
      "quantiles": [
        0.5,
        0.9,
        0.99
      ],
      "unit": "ms",
      "aggregate": "avg"
    },
    {
      "name": "cache_store_load_bandwidth_gbps",
      "type": "promql",
      "expr": "sum by () (rate(ucm:cache_load_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "aggregate": "sum"
    },
    {
      "name": "cache_store_dump_bandwidth_gbps",
      "type": "promql",
      "expr": "sum by () (rate(ucm:cache_dump_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "aggregate": "sum"
    },
    {
      "name": "posix_store_load_bandwidth_gbps",
      "type": "promql",
      "expr": "sum by () (rate(ucm:posix_s2h_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "aggregate": "sum"
    },
    {
      "name": "posix_store_dump_bandwidth_gbps",
      "type": "promql",
      "expr": "sum by () (rate(ucm:posix_h2s_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "aggregate": "sum"
    }
  ]
}
