{
  "title": "UCM Grafana Panels",
  "metrics": [
    {
      "name": "Cache Lookup Hit Rate",
      "type": "promql",
      "expr": "sum by (worker_id) (rate(ucm:cache_lookup_hit_blocks_total[$__rate_interval])) / (sum by (worker_id) (rate(ucm:cache_lookup_hit_blocks_total[$__rate_interval])) + sum by (worker_id) (rate(ucm:cache_lookup_miss_blocks_total[$__rate_interval])))",
      "value": "hit_rate",
      "group_by": ["worker_id"]
    },
    {
      "name": "Connector Load Throughput",
      "type": "promql",
      "expr": "sum by (model_name, worker_id) (rate(ucm:load_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "group_by": ["model_name", "worker_id"]
    },
    {
      "name": "Connector Save Throughput",
      "type": "promql",
      "expr": "sum by (model_name, worker_id) (rate(ucm:save_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "group_by": ["model_name", "worker_id"]
    },
    {
      "name": "Connector Load Duration p90",
      "type": "promql",
      "expr": "histogram_quantile(0.9, sum by (le, model_name, worker_id) (rate(ucm:load_duration_bucket[$__rate_interval])))",
      "value": "p90",
      "unit": "ms",
      "group_by": ["model_name", "worker_id"]
    },
    {
      "name": "Connector Load Duration p99",
      "type": "promql",
      "expr": "histogram_quantile(0.99, sum by (le, model_name, worker_id) (rate(ucm:load_duration_bucket[$__rate_interval])))",
      "value": "p99",
      "unit": "ms",
      "group_by": ["model_name", "worker_id"]
    },
    {
      "name": "Connector Load Duration Avg",
      "type": "promql",
      "expr": "sum by (model_name, worker_id) (rate(ucm:load_duration_sum[$__rate_interval])) / sum by (model_name, worker_id) (rate(ucm:load_duration_count[$__rate_interval]))",
      "value": "avg",
      "unit": "ms",
      "group_by": ["model_name", "worker_id"]
    },
    {
      "name": "Connector Save Duration p90",
      "type": "promql",
      "expr": "histogram_quantile(0.9, sum by (le, model_name, worker_id) (rate(ucm:save_duration_bucket[$__rate_interval])))",
      "value": "p90",
      "unit": "ms",
      "group_by": ["model_name", "worker_id"]
    },
    {
      "name": "Connector Save Duration p99",
      "type": "promql",
      "expr": "histogram_quantile(0.99, sum by (le, model_name, worker_id) (rate(ucm:save_duration_bucket[$__rate_interval])))",
      "value": "p99",
      "unit": "ms",
      "group_by": ["model_name", "worker_id"]
    },
    {
      "name": "Cache Load Throughput",
      "type": "promql",
      "expr": "sum by (worker_id) (rate(ucm:cache_load_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "group_by": ["worker_id"]
    },
    {
      "name": "Cache Dump Throughput",
      "type": "promql",
      "expr": "sum by (worker_id) (rate(ucm:cache_dump_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "group_by": ["worker_id"]
    },
    {
      "name": "Cache Load Duration p99",
      "type": "promql",
      "expr": "histogram_quantile(0.99, sum by (le, worker_id) (rate(ucm:cache_load_duration_ms_bucket[$__rate_interval])))",
      "value": "p99",
      "unit": "ms",
      "group_by": ["worker_id"]
    },
    {
      "name": "Cache Dump Duration p99",
      "type": "promql",
      "expr": "histogram_quantile(0.99, sum by (le, worker_id) (rate(ucm:cache_dump_duration_ms_bucket[$__rate_interval])))",
      "value": "p99",
      "unit": "ms",
      "group_by": ["worker_id"]
    },
    {
      "name": "Posix Read Throughput",
      "type": "promql",
      "expr": "sum by (worker_id) (rate(ucm:posix_s2h_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "group_by": ["worker_id"]
    },
    {
      "name": "Posix Write Throughput",
      "type": "promql",
      "expr": "sum by (worker_id) (rate(ucm:posix_h2s_bytes_total[$__rate_interval])) / 1e9",
      "value": "gbps",
      "unit": "GB/s",
      "group_by": ["worker_id"]
    }
  ]
}
