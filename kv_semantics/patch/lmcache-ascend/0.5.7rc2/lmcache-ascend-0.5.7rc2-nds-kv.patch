+static constexpr size_t kPageSize = 4096;
+static constexpr const char *kLockFile = "/tmp/lmcache_ascend_reg.lock";
+
+static size_t align_to_page_size(size_t size) {
+  return (size + kPageSize - 1) & ~(kPageSize - 1);
+}
+
+/**
+ * Get current timestamp string for logging
+ */
+static std::string timestamp() {
+  auto now = std::chrono::system_clock::now();
+  auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                now.time_since_epoch()) %
+            1000;
+  auto timer = std::chrono::system_clock::to_time_t(now);
+  struct tm tm_buf;
+  localtime_r(&timer, &tm_buf);
+  std::ostringstream oss;
+  oss << "[" << tm_buf.tm_hour << ":" << tm_buf.tm_min << ":" << tm_buf.tm_sec
+      << "." << ms.count() << "]";
+  return oss.str();
+}
+
+/**
+ * Get process info string for logging
+ */
+static std::string proc_info() {
+  std::ostringstream oss;
+  oss << "[pid=" << getpid() << "]";
+  return oss.str();
+}
+
+/**
+ * Check if the process has permission to lock memory.
+ */
+static bool can_lock_memory() {
+  struct rlimit rlim;
+  if (getrlimit(RLIMIT_MEMLOCK, &rlim) != 0) {
+    return false;
+  }
+  return rlim.rlim_cur == RLIM_INFINITY || rlim.rlim_cur > 0;
+}
+
+/**
+ * Acquire a cross-process file lock to serialize register_ptr calls.
+ * This prevents multiple workers from deadlocking in NPU driver.
+ */
+static int acquire_register_lock() {
+  int fd = open(kLockFile, O_CREAT | O_RDWR, 0666);
+  if (fd < 0) {
+    std::cerr << timestamp() << " mem_alloc: WARN " << proc_info()
+              << " Failed to open lock file: " << strerror(errno) << std::endl;
+    return -1;
+  }
+  // Non-blocking try-lock first
+  int rc = flock(fd, LOCK_EX | LOCK_NB);
+  if (rc < 0) {
+    if (errno == EWOULDBLOCK) {
+      std::cerr << timestamp() << " mem_alloc: INFO " << proc_info()
+                << " Another process is registering memory, waiting..."
+                << std::endl;
+      // Blocking wait with timeout-like behavior by retrying
+      int retries = 0;
+      while (flock(fd, LOCK_EX | LOCK_NB) < 0 && retries < 300) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        retries++;
+      }
+      if (retries >= 300) {
+        std::cerr << timestamp() << " mem_alloc: ERROR " << proc_info()
+                  << " Timeout waiting for register lock (30s)" << std::endl;
+        close(fd);
+        return -1;
+      }
+    } else {
+      std::cerr << timestamp() << " mem_alloc: WARN " << proc_info()
+                << " flock failed: " << strerror(errno) << std::endl;
+      close(fd);
+      return -1;
+    }
+  }
+  return fd; // Return fd so caller can release the lock
+}
+
+static void release_register_lock(int fd) {
+  if (fd >= 0) {
+    flock(fd, LOCK_UN);
+    close(fd);
+  }
+}
 
