+            filtered_objs.append(memory_obj)
+
+        if not filtered_keys:
+            return
+
+        for memory_obj in filtered_objs:
+            memory_obj.ref_count_up()
+
+        def _batched_put_task() -> None:
+            try:
+                self.batched_put_blocking(filtered_keys, filtered_objs)
+                if on_complete_callback is not None:
+                    for key in filtered_keys:
+                        try:
+                            on_complete_callback(key)
