        },
        {
          "expr": "(sum(rate(ucm:dramstore_connect_failures_total{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "Connect failures",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(ucm:dramstore_fence_timeout_triggers_total{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "Fence timeout triggers",
          "refId": "C"
        },
        {
          "expr": "(sum(rate(ucm:dramstore_fence_attempts_total{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "Fence attempts",
          "refId": "D"
        },
        {
          "expr": "(sum(rate(ucm:dramstore_fence_failures_total{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "Fence failures",
          "refId": "E"
        },
        {
          "expr": "(sum(rate(ucm:dramstore_stale_replies_total{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "Stale replies",
          "refId": "F"
        }
      ],
