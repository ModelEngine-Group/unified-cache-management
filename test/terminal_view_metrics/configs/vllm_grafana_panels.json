{
  "title": "vLLM Grafana Panels",
  "metrics": [
    {
      "name": "E2E Request Latency p99",
      "type": "promql",
      "expr": "histogram_quantile(0.99, sum by (le, model_name, instance) (rate(vllm:e2e_request_latency_seconds_bucket[$__rate_interval])))",
      "value": "p99",
      "unit": "s",
      "aggregate": "avg"
    },
    {
      "name": "E2E Request Latency Avg",
      "type": "promql",
      "expr": "sum by (model_name, instance) (rate(vllm:e2e_request_latency_seconds_sum[$__rate_interval])) / sum by (model_name, instance) (rate(vllm:e2e_request_latency_seconds_count[$__rate_interval]))",
      "value": "avg",
      "unit": "s",
      "aggregate": "avg"
    },
    {
      "name": "Time To First Token p99",
      "type": "promql",
      "expr": "histogram_quantile(0.99, sum by (le, model_name, instance) (rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])))",
      "value": "p99",
      "unit": "s",
      "aggregate": "avg"
    },
    {
      "name": "Inter Token Latency p99",
      "type": "promql",
      "expr": "histogram_quantile(0.99, sum by (le, model_name, instance) (rate(vllm:inter_token_latency_seconds_bucket[$__rate_interval])))",
      "value": "p99",
      "unit": "s",
      "aggregate": "avg"
    },
    {
      "name": "Prompt Tokens",
      "type": "promql",
      "expr": "sum by (model_name, instance) (rate(vllm:prompt_tokens_total[$__rate_interval]))",
      "value": "tokens_per_s",
      "unit": "tokens/s",
      "aggregate": "sum"
    },
    {
      "name": "Generation Tokens",
      "type": "promql",
      "expr": "sum by (model_name, instance) (rate(vllm:generation_tokens_total[$__rate_interval]))",
      "value": "tokens_per_s",
      "unit": "tokens/s",
      "aggregate": "sum"
    },
    {
      "name": "Running Requests",
      "type": "promql",
      "expr": "vllm:num_requests_running",
      "value": "running",
      "aggregate": "sum"
    },
    {
      "name": "Waiting Requests",
      "type": "promql",
      "expr": "vllm:num_requests_waiting",
      "value": "waiting",
      "aggregate": "sum"
    },
    {
      "name": "KV Cache Usage",
      "type": "promql",
      "expr": "vllm:kv_cache_usage_perc",
      "value": "usage",
      "aggregate": "avg"
    }
  ]
}
