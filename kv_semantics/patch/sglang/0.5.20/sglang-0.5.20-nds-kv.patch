+# SPDX-License-Identifier: Apache-2.0
+
+import hashlib
+
+# Number of bits used to encode worker_id / tp_rank in the high part of block_id.
+# pynds_kv 1.7+ uses an 80-bit block_key (key_low 64 bits + key_high 16 bits);
+# tp_rank occupies the 16-bit key_high, leaving the full 64-bit key_low for the hash.
+_WORKER_ID_BITS = 16
+
+
+def encode_block_id(hash_str: str, tp_rank: int) -> int:
+    """Convert a SGLang hash string into an 80-bit NDS block_id.
+
+    The high 16 bits (key_high) encode tp_rank to avoid collisions across
+    tensor-parallel ranks; the low 64 bits (key_low) hold the full hash —
+    no truncation, unlike the previous 56-bit scheme.
+
+    The returned value is a flat Python int: ``(tp_rank << 64) | hash64``.
+    pynds_kv splits it into key_low/key_high internally and applies its
+    xxhash scattering (enabled by default) before hitting the NDS box, so
+    disk distribution stays uniform even though all keys of one rank share
+    the same high bits.
+
+    Args:
+        hash_str: The hash key produced by SGLang hicache.
+        tp_rank: Tensor-parallel rank of the current worker.
+
+    Returns:
+        A non-negative int < 2^80 as the block_id for pynds_kv.
+
+    Raises:
+        ValueError: If tp_rank is outside the representable 16-bit range.
+    """
+    if tp_rank < 0 or tp_rank >= (1 << _WORKER_ID_BITS):
+        raise ValueError(
+            f"tp_rank must be in [0, {1 << _WORKER_ID_BITS}), got {tp_rank}"
+        )
+
+    # Use the first 8 bytes of SHA-256 as a stable 64-bit hash (full key_low).
+    digest = hashlib.sha256(hash_str.encode("utf-8")).digest()[:8]
+    low = int.from_bytes(digest, byteorder="little")
+    high = tp_rank << 64
+    return high | low
