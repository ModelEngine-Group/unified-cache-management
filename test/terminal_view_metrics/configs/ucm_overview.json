{
  "title": "UCM Overview",
  "metrics": [
    {
      "name": "ucm:cache_lookup_hit_rate",
      "type": "gauge",
      "op": "last",
      "aggregate": "avg"
    },
    {
      "name": "ucm:load_bytes_total",
      "type": "counter",
      "op": "rate",
      "scale": 1e-09,
      "unit": "GB/s",
      "aggregate": "sum"
    },
    {
      "name": "ucm:save_bytes_total",
      "type": "counter",
      "op": "rate",
      "scale": 1e-09,
      "unit": "GB/s",
      "aggregate": "sum"
    },
    {
      "name": "ucm:load_duration",
      "type": "histogram",
      "avg": true,
      "quantiles": [
        0.5,
        0.9,
        0.99
      ],
      "unit": "ms",
      "aggregate": "sum"
    },
    {
      "name": "ucm:save_duration",
      "type": "histogram",
      "avg": true,
      "quantiles": [
        0.5,
        0.9,
        0.99
      ],
      "unit": "ms",
      "aggregate": "sum"
    }
  ]
}
