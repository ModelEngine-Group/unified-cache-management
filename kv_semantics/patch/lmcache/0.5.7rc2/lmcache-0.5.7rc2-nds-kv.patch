index 0000000000000000000000000000000000000000..a775d32269f556f4201c9ad2df2d651f48db0ce7
--- /dev/null
+++ b/lmcache/v1/storage_backend/nds_numa.py
@@ -0,0 +1,405 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Per-rank NDS config materialization and NUMA-aware start_core placement.
+
+Ported from SGLang ``hicache-kv-backend-0.5.13post1``
+(``python/sglang/srt/mem_cache/storage/kv/pynds_client.py`` and the NUMA
+helpers in ``sglang.srt.utils``), made self-contained for LMCache: no
+sglang/psutil dependencies, heavy imports (torch, pynvml) are lazy so the
+module stays importable in lightweight/test contexts.
+
+Background: the vendor NDS SDK (libndsclient) pins its internal IO threads
+to physical cores starting at the ``start_core`` key in ``nds_config.conf``.
+Multi-GPU launches run one process per TP rank and every process reads the
+same conf, so all ranks pin their SDK threads onto the same cores and
+starve each other. Shifting ``start_core`` by a per-rank offset — ideally
+into the GPU's own NUMA node — gives each process its own core window.
+"""
+
+# Standard
+from typing import Any, Optional
+import ctypes
+import glob
+import logging
+import math
+import os
+import re
+import subprocess
+import tempfile
+
+logger = logging.getLogger(__name__)
+
+_START_CORE_PATTERN = re.compile(r"^(\s*start_core\s*=\s*)(\d+)(.*)$")
+
+
+def _read_base_start_core(base_path: str) -> int:
+    """Return the base ``start_core`` value from ``nds_config.conf``."""
+    with open(base_path, "r", encoding="utf-8") as f:
+        for line in f:
+            m = _START_CORE_PATTERN.match(line.rstrip("\n"))
+            if m:
+                return int(m.group(2))
+    raise ValueError(f"start_core not found in {base_path}")
+
+
+def _write_conf_with_start_core(base_path: str, new_core: int) -> str:
+    """Write a per-rank copy of ``base_path`` with ``start_core = new_core``.
+
+    The rewritten copy is placed **next to the original file** (same
+    directory) because pynds_kv loads ``nds_wrapper.conf`` from the
+    directory containing the nds_config path — copying elsewhere would
+    silently drop the wrapper IO tuning.
+
+    The per-rank copy is a derived artifact whose source of truth is the
+    base conf the deployer edits, so an existing copy is always overwritten
+    to avoid reusing stale core assignments.
+
+    The write is atomic (tmp file + ``os.replace`` in the same directory)
+    because processes that compute the same ``start_core`` target the same
+    file name. A naive ``open(w)`` truncate+write could let a concurrent
+    reader observe a torn or empty file.
+    """
+    with open(base_path, "r", encoding="utf-8") as f:
+        lines = f.readlines()
+
+    base_core: Optional[int] = None
+    for i, line in enumerate(lines):
+        m = _START_CORE_PATTERN.match(line.rstrip("\n"))
+        if m:
+            base_core = int(m.group(2))
+            lines[i] = f"{m.group(1)}{new_core}{m.group(3)}\n"
+            break
+    if base_core is None:
+        raise ValueError(f"start_core not found in {base_path}")
+
+    root, ext = os.path.splitext(base_path)
+    new_path = f"{root}.core{new_core}{ext}"
+    fd, tmp_path = tempfile.mkstemp(
+        prefix=f".{os.path.basename(new_path)}.",
+        dir=os.path.dirname(new_path) or ".",
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.write("".join(lines))
+        os.replace(tmp_path, new_path)
+    except BaseException:
+        try:
+            os.unlink(tmp_path)
+        except OSError:
+            pass
+        raise
+    logger.info(
+        "wrote per-rank NDS config %s (start_core %d -> %d)",
+        new_path,
+        base_core,
+        new_core,
+    )
+    return new_path
+
+
+def materialize_per_rank_nds_config(base_path: str, core_offset: int) -> str:
+    """Write a copy of ``nds_config.conf`` with ``start_core`` shifted.
+
+    Prefer NUMA-aware placement (``numa_local_start_core`` +
+    ``materialize_per_rank_nds_config_absolute``) when the topology is
+    available; this linear offset mode is the fallback for hosts where the
+    NUMA topology cannot be queried.
+
+    Args:
+        base_path: Path to the shared ``nds_config.conf``.
+        core_offset: Value added to the base ``start_core``.  0 returns
+            ``base_path`` unchanged (no rewrite needed).
+
+    Returns:
+        Path to the conf the caller should pass to ``pynds_kv.init`` —
+        ``base_path`` itself when ``core_offset == 0``, otherwise the
+        per-rank copy named ``<base>.core<new_start_core><ext>``.
+
+    Raises:
+        ValueError: If ``core_offset > 0`` but no ``start_core`` key exists
+            in the base conf (a deployment error that must stay loud).
+    """
+    if core_offset == 0:
+        return base_path
+    if core_offset < 0:
+        raise ValueError(f"core_offset must be non-negative, got {core_offset}")
+
+    try:
+        base_core = _read_base_start_core(base_path)
+    except ValueError as e:
+        raise ValueError(
+            f"{e}; cannot apply per-rank core offset {core_offset}"
+        ) from e
+    return _write_conf_with_start_core(base_path, base_core + core_offset)
+
+
+def materialize_per_rank_nds_config_absolute(
+    base_path: str, start_core: int
+) -> str:
+    """Write a copy of ``nds_config.conf`` with an absolute ``start_core``.
+
+    Unlike :func:`materialize_per_rank_nds_config` (which shifts the base
+    value by an offset), this sets ``start_core`` verbatim — used with
+    :func:`numa_local_start_core`, which computes a core id inside the
+    GPU's NUMA node directly from the host topology.
+
+    Raises:
+        ValueError: If ``start_core`` is negative or the base conf has no
+            ``start_core`` key (a deployment error that must stay loud).
+    """
+    if start_core < 0:
+        raise ValueError(f"start_core must be non-negative, got {start_core}")
+    return _write_conf_with_start_core(base_path, start_core)
+
+
+def parse_lscpu_topology():
+    """Parse ``lscpu -p=CPU,Core,Socket,Node`` into (cpu, core, socket, node)
+    tuples.  Raises RuntimeError when lscpu is unavailable."""
+    try:
+        output = subprocess.check_output(
+            ["lscpu", "-p=CPU,Core,Socket,Node"], text=True
+        )
+    except Exception as e:
+        raise RuntimeError(f"Unexpected error running 'lscpu': {e}")
+
+    cpu_info = []
+    for line in output.splitlines():
+        if not line.startswith("#"):
+            parts = line.strip().split(",")
+            if len(parts) != 4:
+                logger.warning("Skipping malformed lscpu line: %s", line.strip())
+                continue
+            cpu = int(parts[0])
+            core, socket, node = [int(p) if p else 0 for p in parts[1:]]
+            cpu_info.append((cpu, core, socket, node))
+    return cpu_info
+
+
+def get_physical_cpus_by_numa():
+    """Map NUMA node -> sorted list of physical core CPU ids visible to this
+    process (hyperthread siblings excluded, intersected with the process
+    affinity mask so numactl-bound deployments adapt automatically)."""
+    cpu_info = parse_lscpu_topology()
+
+    # node -> {(core_id, socket): cpu_id}; first CPU seen per physical core
+    physical_by_node: dict[int, dict] = {}
+    for cpu, core, socket, node in cpu_info:
+        node_map = physical_by_node.setdefault(node, {})
+        key = (core, socket)
+        if key not in node_map:
+            node_map[key] = cpu
+
+    # CPUs the current process is allowed to run on
+    try:
+        cpus_allowed = set(os.sched_getaffinity(0))
+    except (AttributeError, OSError):
+        # Non-Linux or restricted environment: no affinity filtering
+        cpus_allowed = None
+
+    node_to_cpus = {}
+    for node, core_to_cpu in physical_by_node.items():
+        cpus = sorted(core_to_cpu.values())
+        if cpus_allowed is not None:
+            cpus = sorted(set(cpus).intersection(cpus_allowed))
+        node_to_cpus[node] = cpus
+    return node_to_cpus
+
+
+def _get_nvml_device_index(device_id: int) -> int:
+    """Map a CUDA logical device index to the NVML index, honoring
+    CUDA_VISIBLE_DEVICES reordering (via torch's internal helper when
+    available)."""
+    # Third Party
+    import torch
+
+    get_nvml_device_index = getattr(torch.cuda, "_get_nvml_device_index", None)
+    if get_nvml_device_index is None:
+        logger.warning(
+            "torch.cuda._get_nvml_device_index is unavailable; falling back "
+            "to device_id=%d as the NVML device index. This may select the "
+            "wrong physical GPU when CUDA_VISIBLE_DEVICES reorders devices "
+            "(CUDA_VISIBLE_DEVICES=%s).",
+            device_id,
+            os.environ.get("CUDA_VISIBLE_DEVICES", ""),
+        )
+        return device_id
+    return get_nvml_device_index(device_id)
+
+
+def _query_numa_node_for_gpu(device_id: int):
+    """List of NUMA node IDs that have memory affinity with the GPU at
+    CUDA logical index ``device_id``.  Returns [] when pynvml is missing
+    or the query fails."""
+    try:
+        # Third Party
+        import pynvml
+    except ModuleNotFoundError:
+        logger.warning("pynvml not installed, cannot query NUMA node for GPU")
+        return []
+
+    try:
+        pynvml.nvmlInit()
+
+        nvml_device_id = _get_nvml_device_index(device_id)
+        handle = pynvml.nvmlDeviceGetHandleByIndex(nvml_device_id)
+        numa_node_count = len(glob.glob("/sys/devices/system/node/node[0-9]*"))
+
+        c_ulong_bits = ctypes.sizeof(ctypes.c_ulong) * 8
+        node_set_size = max(1, math.ceil(numa_node_count / c_ulong_bits))
+        node_set = pynvml.nvmlDeviceGetMemoryAffinity(
+            handle,
+            node_set_size,
+            pynvml.NVML_AFFINITY_SCOPE_NODE,
+        )
+
+        numa_nodes = []
+        for node_id in range(numa_node_count):
+            mask_array_index = node_id // c_ulong_bits
+            mask_bit_index = node_id % c_ulong_bits
+            if node_set[mask_array_index] & (1 << mask_bit_index):
+                numa_nodes.append(node_id)
+        return numa_nodes
+    except Exception as e:
+        logger.warning("Failed to query NUMA node for GPU %d: %s", device_id, e)
+        return []
+
+
+def numa_local_start_core(gpu_ordinal: int, stride: Any) -> Optional[int]:
+    """Absolute ``start_core`` for this rank inside its GPU's NUMA node.
+
+    The vendor SDK pins its IO threads to physical cores starting at
+    ``start_core``; those cores must live in the same NUMA node as the GPU
+    (and as the RDMA NIC's PCIe attachment) or every RDMA touchdown crosses
+    the inter-socket link.  Worse, when the serving engine numactl-confines
+    the worker process to the GPU's node, an SDK ``pthread_setaffinity``
+    targeting cores outside that node fails outright and the threads float
+    unbound.
+
+    GPUs sharing a NUMA node are assigned disjoint windows of ``stride``
+    physical cores each, in device-ordinal order: the p-th GPU on the node
+    gets ``cores[p*stride]`` as its ``start_core``.  Hyperthread siblings
+    are excluded (physical cores only, via lscpu topology).
+
+    Args:
+        gpu_ordinal: The process's CUDA device index on the local node.
+        stride: Number of physical cores reserved per process, or the
+            string ``"auto"`` to derive the window from the node's
+            affinity-visible physical core count divided by its GPU count
+            (no manual sizing; the operator caps the vendor SDK's
+            pinned-thread count at the derived stride).  A manual stride
+            must be >= the number of cores the SDK pins per process.
+
+    Returns:
+        The absolute core id for this rank's ``start_core``, or ``None``
+        when the topology cannot be determined (no CUDA, pynvml missing,
+        lscpu failure, unknown GPU->node mapping) — the caller then falls
+        back to the legacy linear offset mode (manual stride) or passes
+        the base conf through unchanged (``"auto"``).
+
+    Raises:
+        ValueError: If a manual ``stride <= 0``, or the GPU's NUMA node
+            does not have enough physical cores for all its GPUs at the
+            effective stride — a deployment error that must stay loud
+            rather than silently overlapping two ranks onto the same cores.
+    """
+    if stride == "auto":
+        pass  # effective stride derived below from the node topology
+    elif stride <= 0:
+        raise ValueError(f"stride must be positive, got {stride}")
+
+    # Lazy import: keeps this module importable without torch.
+    try:
+        # Third Party
+        import torch
+    except ModuleNotFoundError:
+        logger.warning(
+            "torch not installed; cannot query NUMA topology, falling back "
+            "to linear start_core offset"
+        )
+        return None
+
+    try:
+        gpu_count = torch.cuda.device_count()
+        node_by_gpu: dict[int, Optional[int]] = {}
+        for dev in range(gpu_count):
+            nodes = _query_numa_node_for_gpu(dev)
+            node_by_gpu[dev] = nodes[0] if nodes else None
+        node_cores_map = get_physical_cpus_by_numa()
+    except Exception as e:
+        logger.warning(
+            "NUMA topology query failed (%s); falling back to linear "
+            "start_core offset",
+            e,
+        )
+        return None
+
+    my_node = node_by_gpu.get(gpu_ordinal)
+    if my_node is None or any(n is None for n in node_by_gpu.values()):
+        logger.warning(
+            "NUMA node unknown for some GPUs (gpu %d -> %s); falling back "
+            "to linear start_core offset",
+            gpu_ordinal,
+            node_by_gpu,
+        )
+        return None
+
+    cores = sorted(node_cores_map.get(my_node) or [])
+    if not cores:
+        logger.warning(
+            "no physical cores found for NUMA node %d; falling back to "
+            "linear start_core offset",
+            my_node,
+        )
+        return None
+
+    peers = sorted(d for d, n in node_by_gpu.items() if n == my_node)
+    pos = peers.index(gpu_ordinal)
+
+    if stride == "auto":
+        # Derive the per-process window from the node's affinity-visible
+        # physical core count instead of requiring a manual stride.  The
+        # core list is already intersected with the process affinity mask
+        # (get_physical_cpus_by_numa), so this adapts to numactl-bound
+        # deployments automatically: node-level binds share the full node
+        # (cores // peers per rank), per-rank binds see only their own
+        # subset (any window inside it stays disjoint from other ranks).
+        # The operator is expected to cap the vendor SDK's pinned-thread
+        # count at the resulting stride.
+        stride = len(cores) // len(peers)
+        if stride == 0:
+            raise ValueError(
+                f"NUMA node {my_node} has only {len(cores)} physical cores "
+                f"for {len(peers)} GPUs; cannot assign even one core per "
+                f"process (kv_storage_nds_core_stride=auto)"
+            )
+        logger.info(
+            "kv_storage_nds_core_stride=auto: node %d has %d physical "
+            "cores for %d GPUs -> stride %d",
+            my_node,
+            len(cores),
+            len(peers),
+            stride,
+        )
+
+    first = pos * stride
+    if first + stride > len(cores):
+        raise ValueError(
+            f"NUMA node {my_node} has only {len(cores)} physical cores, but "
+            f"GPU {gpu_ordinal} (position {pos} among {len(peers)} GPUs on "
+            f"the node) needs cores [{first}, {first + stride}) at stride "
+            f"{stride}; reduce kv_storage_nds_core_stride or rebalance GPUs "
+            f"across nodes"
+        )
+
+    start = cores[first]
+    logger.info(
+        "NUMA-aware NDS start_core: GPU %d on node %d, position %d/%d, "
+        "cores [%d, %d), start_core=%d",
+        gpu_ordinal,
+        my_node,
+        pos,
+        len(peers),
+        first,
+        first + stride,
+        start,
+    )
+    return start
