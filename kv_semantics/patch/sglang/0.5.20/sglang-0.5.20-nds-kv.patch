index 0000000000000000000000000000000000000000..35ff660977046e121ddf2af9bd133e746e10549a
--- /dev/null
+++ b/python/sglang/srt/mem_cache/storage/kv/config.py
@@ -0,0 +1,448 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import logging
+from dataclasses import dataclass
+from typing import Optional
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class KVStorageBackendConfig:
+    """Configuration for the HiCache KV storage backend.
+
+    Args:
+        nsid: Namespace ID for NDS, must be a positive integer.
+        nds_config_path: Path to the NDS configuration file (nds_config.conf).
+        nds_core_stride: Per-process CPU-core stride used to place the vendor
+            SDK ``start_core`` in ``nds_config.conf``.  Multi-GPU launches one
+            scheduler process per GPU (TP, PP, and DP alike) and every
+            process reads the same ``nds_config.conf``; the vendor SDK pins
+            its internal IO threads from ``start_core``, so all processes
+            pile onto the same physical cores and starve each other.  When
+            > 0, each process initializes NDS with a rewritten per-process
+            conf.  Placement is NUMA-aware when the host topology can be
+            queried (see ``pynds_client.numa_local_start_core``): GPUs
+            sharing a NUMA node get disjoint windows of ``nds_core_stride``
+            physical cores each inside that node, keeping the SDK threads
+            local to the GPU (and compatible with SGLANG_NUMA_BIND_V2's
+            numactl confinement); a node with too few cores raises a loud
+            ValueError at startup.  When the topology is unavailable, falls
+            back to ``start_core = base + gpu_ordinal * nds_core_stride``
+            (see ``pynds_client.materialize_per_rank_nds_config`` and
+            ``HiCacheKVStorage._local_gpu_index``).  The stride must be
+            >= the number of cores the SDK pins per process.  The string
+            ``"auto"`` derives the stride at init time from the node's
+            affinity-visible physical core count divided by its GPU count
+            (e.g. 48 cores / 4 GPUs -> 12), adapting to numactl-bound
+            deployments without manual sizing; the operator then caps the
+            SDK's pinned-thread count at the derived stride.  0 (default)
+            disables the rewrite and keeps the single shared conf.
+        timeout: Timeout in seconds for each pynds_kv call.
+        pynds_workers: Maximum number of concurrent pynds_kv calls.
+        get_io_threads: Maximum number of sub-batches of a single
+            ``batch_get`` executed concurrently.  The prefetch path issues one
+            ``batch_get`` per request per TP rank and each rank's prefetch IO
+            thread is serial, so without intra-call parallelism each rank has
+            at most one ``batchGet`` in flight and the NIC idles between
+            calls.  Sub-batches that need the staging buffer always fall back
+            to serial execution (the staging window is reused per sub-batch).
+            1 disables parallel reads; default 4.
+        failure_threshold: Consecutive failures before marking backend unhealthy.
+        indexer_nsid: Optional separate namespace ID for the DSA indexer pool.
+            DSA models store two payloads per page (MLA latent KV and the
+            indexer K cache) whose sizes differ; the KV box namespaces backing
+            them can therefore be configured with different valueSize. When
+            set, all INDEXER-pool keys are routed to this nsid (whose
+            valueSize should match the indexer page size); when unset, the
+            indexer keys share ``nsid`` with the KV pool.
+        pool_nsid: Per-pool namespace routing for models whose sub-pools have
+            different page sizes (e.g. DeepSeek-V4: SWA / C4 / C128 / state
+            pools differ by 100x).  Two forms:
+            - a dict ``{"<pool_name>": <nsid>}`` routing the named pools to
+              the given namespaces (pool names are the PoolName values, e.g.
+              ``"swa"``, ``"deepseek_v4_c4"``); pools not listed keep the
+              default routing;
+            - the string ``"auto"``: every extra pool that uses NDS is
+              assigned ``pool_nsid_base + n`` in registration order, and the
+              assignment (pool name + page size + nsid) is logged at startup
+              so the box-side namespaces can be created without knowing the
+              model's pool names up front.
+            Explicit dict entries take precedence over ``indexer_nsid``;
+            ``indexer_nsid`` takes precedence over auto assignment for the
+            indexer pools.  Unset (default) keeps every pool on ``nsid``.
+            Multiple pools MAY share one nsid (a warning is logged): the
+            shared namespace's valueSize must cover the largest page among
+            them, and smaller-page pools are padded up to it on write
+            (write amplification ~valueSize/page_bytes).
+        pool_nsid_base: Base namespace for ``pool_nsid="auto"``; required in
+            auto mode, must not collide with ``nsid`` / ``indexer_nsid``
+            (colliding candidates are skipped and logged).  Ignored otherwise.
+        pool_nsid_align_kb: Alignment multiple (KB) for the suggested
+            per-namespace valueSize printed in the assignment log and the
+            provisioning guide.  Box-side valueSize values are easier to
+            manage on round boundaries (e.g. 6289 KB -> 6400 KB), so the
+            suggestion is ``ceil(page_bytes/1024)`` rounded up to this
+            multiple.  Default 128; 1 disables rounding (raw ceil value).
+            Only affects the suggestion text — routing itself does not
+            depend on it.
+        pool_nsid_guide_path: File path of the provisioning guide written at
+            startup when ``pool_nsid`` is configured (default
+            ``pool_nsid_guide.txt`` in the process CWD).  With 8 GPUs each
+            scheduler process logs its own copy of the auto assignments and
+            the output interleaves; the guide is written once (atomic
+            rename, tp_rank 0 process) and contains the full pool -> nsid ->
+            suggested valueSize table plus ready-to-paste
+            ``value_size_kb_nsid<N>`` lines for nds_wrapper.conf.  Set to an
+            empty string to disable the file.
+        unhealthy_probe_interval: When the pynds client is unhealthy, writes
+            are short-circuited to fail fast; one write is let through every
+            this many seconds as a probe (a successful probe flips the client
+            back to healthy).  Should be larger than ``timeout`` to keep
+            failed probes rare; default 60s.
+        read_failure_threshold: Consecutive read-path failures (batch_get /
+            batch_exists, each counted after its internal retries) before
+            reads are gated.  While the box is down, every ungated read can
+            cost up to ``timeout`` seconds per rank and prefetch is paralyzed;
+            gating degrades reads to an immediate cache miss instead.  With
+            the default get_retry_count=3, one fully-failed logical read
+            trips it; flow-control blips that recover on retry never reach
+            the threshold.  Default 3.
+        read_probe_interval: While reads are gated, one read is let through
+            every this many seconds as a probe; a successful probe resets the
+            counter and reopens reads (via ``_record_success`` it also
+            recovers the write gate).  Matched to the NDS client
+            auto-reconnect window (~10-15s: reconnect sleep 5s plus
+            TCP/RDMA re-handshake plus slow-failure drain), so reads resume
+            shortly after the box is back.  Default 15s.
+        get_retry_count: Total attempts for a failed ``batch_get`` sub-batch.
+            Transient NDS read rejections (e.g. flow-control errors when all
+            TP ranks of an MLA model read the same rank-replicated key space
+            at once) usually recover on retry, and a read failure only
+            degrades to a cache miss.  1 disables retries; default 3.
+        get_retry_backoff: Base backoff in seconds between ``batch_get``
+            retries.  Retry i sleeps ``backoff * 2**(i-1)`` plus uniform
+            jitter in ``[0, backoff * 2**(i-1)]``.  Default 0.2s.
+        indexer_storage: Optional storage target override for the DSA INDEXER
+            pool.  Currently only ``"file"`` is supported: indexer pages are
+            written as local files under ``indexer_storage_path`` instead of
+            the KV box, and the indexer host buffer is not registered as an
+            NDS MR.  Unset (default) keeps indexer pages on the KV box.
+        indexer_storage_path: Directory for indexer page files; required when
+            ``indexer_storage="file"``.  Files persist across restarts (no
+            capacity management — watch disk usage).
+        indexer_file_io_threads: Threads used for indexer local-file IO when
+            ``indexer_storage="file"``.  Each indexer page is an independent
+            file, so per-key reads/writes parallelize cleanly; the controller
+            already overlaps extra-pool IO with the KV-pool NDS transfer, and
+            this pool keeps the file side from becoming the long pole.  1
+            restores the previous serial per-key behavior.  Default 4.
+        pool_storage: Per-pool storage target override, a dict
+            ``{"<pool_name>": "file"}`` routing the named extra pools to
+            local-file storage instead of the KV box (e.g. DeepSeek-V4's
+            small miscellaneous pools C4 / C4_state / C128 whose tiny pages
+            gain little from RDMA and waste box namespaces / write
+            amplification).  Only ``"file"`` is supported.  Files live in a
+            per-pool subdirectory beneath ``indexer_storage_path`` (required
+            when any entry is set), keyed by the component-suffixed storage
+            key, with a per-pool format stamp that wipes the subdirectory
+            once when the pool geometry changes.  Such pools skip NDS MR
+            registration and ``pool_nsid`` routing.  Unset (default) keeps
+            every non-indexer pool on the KV box.
+        warmup_io_on_init: When True (default), run small real
+            batch_put/batch_get round-trips right after NDS init (eager at
+            startup and on lazy fallback init).  Init/is_exists only use the
+            control path; the round-trips exercise the data path (MRs, RDMA
+            connection setup, scatter IO) before the first serving request
+            and pre-establish lazily-created connections.  Failures are
+            logged and degrade to cache miss; they never block startup.
+        warmup_io_keys: Number of warmup round-trip keys (default 16; 1
+            round-trips a single key).  The NDS client opens per-endpoint
+            RDMA connections lazily, so the keys are spread across the hash
+            ring to force every endpoint's connection up at init time,
+            avoiding concurrent connection setup under live IO.
+            One-time cost is warmup_io_keys slots on the box plus
+            warmup_io_keys x value_size of write traffic (short writes are
+            padded to the full slot).
+    """
+
+    nsid: int
+    nds_config_path: Optional[str] = None
+    nds_core_stride: object = 0  # int (manual stride, 0 = off) or "auto"
+    timeout: float = 30.0
+    pynds_workers: int = 32
+    get_io_threads: int = 4
+    failure_threshold: int = 1
+    indexer_nsid: Optional[int] = None
+    pool_nsid: Optional[object] = None  # dict[str, int] or the string "auto"
+    pool_nsid_base: Optional[int] = None
+    pool_nsid_align_kb: int = 128
+    pool_nsid_guide_path: Optional[str] = None
+    unhealthy_probe_interval: float = 60.0
+    read_failure_threshold: int = 3
+    read_probe_interval: float = 15.0
+    get_retry_count: int = 3
+    get_retry_backoff: float = 0.2
+    indexer_storage: Optional[str] = None
+    indexer_storage_path: Optional[str] = None
+    indexer_file_io_threads: int = 4
+    pool_storage: Optional[dict] = None  # dict[str, "file"]
+    warmup_io_on_init: bool = True
+    warmup_io_keys: int = 16
+
+    @classmethod
+    def from_extra_config(cls, extra_config: dict) -> "KVStorageBackendConfig":
+        """Parse backend configuration from hicache extra_config dict."""
+        if not isinstance(extra_config, dict):
+            raise ValueError(
+                f"extra_config must be a dict, got {type(extra_config).__name__}"
+            )
+
+        nsid = extra_config.get("nsid")
+        if not isinstance(nsid, int) or nsid <= 0:
+            raise ValueError(f"nsid must be a positive integer, got {nsid}")
+
+        timeout = float(extra_config.get("timeout", 30.0))
+        if timeout <= 0:
+            raise ValueError(f"timeout must be positive, got {timeout}")
+
+        nds_core_stride_raw = extra_config.get("nds_core_stride", 0)
+        if isinstance(nds_core_stride_raw, str) and nds_core_stride_raw == "auto":
+            # Derive the per-process window from the NUMA node's
+            # affinity-visible physical core count / GPU count at init
+            # time (see pynds_client.numa_local_start_core).
+            nds_core_stride = "auto"
+        else:
+            nds_core_stride = int(nds_core_stride_raw)
+            if nds_core_stride < 0:
+                raise ValueError(
+                    f"nds_core_stride must be non-negative, got {nds_core_stride}"
+                )
+        if nds_core_stride and not extra_config.get("nds_config_path"):
+            raise ValueError(
+                "nds_core_stride requires nds_config_path: the per-rank "
+                "start_core rewrite needs a concrete nds_config.conf file "
+                "to copy and modify"
+            )
+
+        pynds_workers = int(extra_config.get("pynds_workers", 32))
+        if pynds_workers <= 0:
+            raise ValueError(
+                f"pynds_workers must be a positive integer, got {pynds_workers}"
+            )
+
+        get_io_threads = int(extra_config.get("get_io_threads", 4))
+        if get_io_threads <= 0:
+            raise ValueError(
+                f"get_io_threads must be a positive integer, got {get_io_threads}"
+            )
+
+        failure_threshold = int(extra_config.get("failure_threshold", 1))
+        if failure_threshold <= 0:
+            raise ValueError(
+                f"failure_threshold must be a positive integer, got {failure_threshold}"
+            )
+
+        indexer_nsid = extra_config.get("indexer_nsid")
+        if indexer_nsid is not None:
+            if not isinstance(indexer_nsid, int) or indexer_nsid <= 0:
+                raise ValueError(
+                    f"indexer_nsid must be a positive integer, got {indexer_nsid}"
+                )
+
+        pool_nsid = extra_config.get("pool_nsid")
+        pool_nsid_base = extra_config.get("pool_nsid_base")
+        if pool_nsid is not None:
+            if isinstance(pool_nsid, str):
+                if pool_nsid != "auto":
+                    raise ValueError(
+                        f'pool_nsid must be a dict or "auto", got {pool_nsid}'
+                    )
+                if not isinstance(pool_nsid_base, int) or pool_nsid_base <= 0:
+                    raise ValueError(
+                        'pool_nsid="auto" requires pool_nsid_base to be a '
+                        f"positive integer, got {pool_nsid_base}"
+                    )
+            elif isinstance(pool_nsid, dict):
+                for k, v in pool_nsid.items():
+                    if not isinstance(k, str) or not k:
+                        raise ValueError(
+                            f"pool_nsid keys must be non-empty pool name "
+                            f"strings, got {k!r}"
+                        )
+                    if not isinstance(v, int) or v <= 0:
+                        raise ValueError(
+                            f"pool_nsid[{k!r}] must be a positive integer, "
+                            f"got {v}"
+                        )
+                reserved = {nsid} | (
+                    {indexer_nsid} if indexer_nsid is not None else set()
+                )
+                for k, v in pool_nsid.items():
+                    if v in reserved:
+                        raise ValueError(
+                            f"pool_nsid[{k!r}]={v} collides with the reserved "
+                            f"nsid of the KV/indexer pool"
+                        )
+                value_counts = {}
+                for v in pool_nsid.values():
+                    value_counts[v] = value_counts.get(v, 0) + 1
+                shared = {v: c for v, c in value_counts.items() if c > 1}
+                if shared:
+                    shared_pools = {
+                        v: sorted(k for k, pv in pool_nsid.items() if pv == v)
+                        for v in shared
+                    }
+                    logger.warning(
+                        "pool_nsid values are shared by multiple pools: %s. "
+                        "This is allowed, but the shared namespace's valueSize "
+                        "must cover the LARGEST page among those pools, and "
+                        "smaller-page pools will be padded up to it on write "
+                        "(write amplification ~valueSize/page_bytes).",
+                        shared_pools,
+                    )
+            else:
+                raise ValueError(
+                    f'pool_nsid must be a dict or "auto", got '
+                    f"{type(pool_nsid).__name__}"
+                )
+
+        pool_nsid_align_kb = int(extra_config.get("pool_nsid_align_kb", 128))
+        if pool_nsid_align_kb <= 0:
+            raise ValueError(
+                "pool_nsid_align_kb must be a positive integer, "
+                f"got {pool_nsid_align_kb}"
+            )
+
+        pool_nsid_guide_path = extra_config.get("pool_nsid_guide_path")
+        if pool_nsid_guide_path is not None and not isinstance(
+            pool_nsid_guide_path, str
+        ):
+            raise ValueError(
+                "pool_nsid_guide_path must be a file path string (empty "
+                f"string disables the guide), got {pool_nsid_guide_path!r}"
+            )
+
+        unhealthy_probe_interval = float(
+            extra_config.get("unhealthy_probe_interval", 60.0)
+        )
+        if unhealthy_probe_interval <= 0:
+            raise ValueError(
+                "unhealthy_probe_interval must be positive, "
+                f"got {unhealthy_probe_interval}"
+            )
+
+        read_failure_threshold = int(extra_config.get("read_failure_threshold", 3))
+        if read_failure_threshold <= 0:
+            raise ValueError(
+                "read_failure_threshold must be a positive integer, "
+                f"got {read_failure_threshold}"
+            )
+
+        read_probe_interval = float(extra_config.get("read_probe_interval", 15.0))
+        if read_probe_interval <= 0:
+            raise ValueError(
+                f"read_probe_interval must be positive, got {read_probe_interval}"
+            )
+
+        get_retry_count = int(extra_config.get("get_retry_count", 3))
+        if get_retry_count <= 0:
+            raise ValueError(
+                f"get_retry_count must be a positive integer, got {get_retry_count}"
+            )
+
+        get_retry_backoff = float(extra_config.get("get_retry_backoff", 0.2))
+        if get_retry_backoff < 0:
+            raise ValueError(
+                f"get_retry_backoff must be non-negative, got {get_retry_backoff}"
+            )
+
+        indexer_storage = extra_config.get("indexer_storage")
+        indexer_storage_path = extra_config.get("indexer_storage_path")
+        if indexer_storage is not None:
+            if indexer_storage != "file":
+                raise ValueError(
+                    f'indexer_storage must be "file" or unset, got {indexer_storage}'
+                )
+            if not isinstance(indexer_storage_path, str) or not indexer_storage_path:
+                raise ValueError(
+                    "indexer_storage_path must be a non-empty directory path "
+                    'when indexer_storage="file"'
+                )
+
+        indexer_file_io_threads = int(extra_config.get("indexer_file_io_threads", 4))
+        if indexer_file_io_threads <= 0:
+            raise ValueError(
+                "indexer_file_io_threads must be a positive integer, "
+                f"got {indexer_file_io_threads}"
+            )
+
+        pool_storage = extra_config.get("pool_storage")
+        if pool_storage is not None:
+            if not isinstance(pool_storage, dict):
+                raise ValueError(
+                    f'pool_storage must be a dict of {{"<pool_name>": "file"}}, '
+                    f"got {type(pool_storage).__name__}"
+                )
+            for k, v in pool_storage.items():
+                if not isinstance(k, str) or not k:
+                    raise ValueError(
+                        f"pool_storage keys must be non-empty pool name "
+                        f"strings, got {k!r}"
+                    )
+                if v != "file":
+                    raise ValueError(
+                        f'pool_storage[{k!r}] must be "file" (the only '
+                        f"supported backend), got {v!r}"
+                    )
+            if pool_storage and (
+                not isinstance(indexer_storage_path, str)
+                or not indexer_storage_path
+            ):
+                raise ValueError(
+                    "pool_storage with \"file\" entries requires "
+                    "indexer_storage_path (the file store root directory); "
+                    "each pool gets a per-pool subdirectory beneath it"
+                )
+
+        warmup_io_on_init = extra_config.get("warmup_io_on_init", True)
+        if isinstance(warmup_io_on_init, str):
+            warmup_io_on_init = warmup_io_on_init.strip().lower() in (
+                "1",
+                "true",
+                "yes",
+                "on",
+            )
+        warmup_io_on_init = bool(warmup_io_on_init)
+
+        warmup_io_keys = int(extra_config.get("warmup_io_keys", 16))
+        if warmup_io_keys <= 0:
+            raise ValueError(
+                f"warmup_io_keys must be a positive integer, got {warmup_io_keys}"
+            )
+
+        return cls(
+            nsid=nsid,
+            nds_config_path=extra_config.get("nds_config_path"),
+            nds_core_stride=nds_core_stride,
+            timeout=timeout,
+            pynds_workers=pynds_workers,
+            get_io_threads=get_io_threads,
+            failure_threshold=failure_threshold,
+            indexer_nsid=indexer_nsid,
+            pool_nsid=pool_nsid,
+            pool_nsid_base=pool_nsid_base,
+            pool_nsid_align_kb=pool_nsid_align_kb,
+            pool_nsid_guide_path=pool_nsid_guide_path,
+            unhealthy_probe_interval=unhealthy_probe_interval,
+            read_failure_threshold=read_failure_threshold,
+            read_probe_interval=read_probe_interval,
+            get_retry_count=get_retry_count,
+            get_retry_backoff=get_retry_backoff,
+            indexer_storage=indexer_storage,
+            indexer_storage_path=indexer_storage_path,
+            indexer_file_io_threads=indexer_file_io_threads,
+            pool_storage=pool_storage,
+            warmup_io_on_init=warmup_io_on_init,
+            warmup_io_keys=warmup_io_keys,
+        )
