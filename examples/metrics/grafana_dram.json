        {
          "expr": "(sum(rate(ucm:dramstore_load_tasks_submitted_total{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "LOAD tasks/s",
          "refId": "C"
        }
      ],
      "title": "DramStore task throughput",
      "type": "timeseries"
