+# behavior.  Larger values let one backend IO call cover a whole request
+# (with the kv backend this means one big batchGet instead of many serial
+# 128-page calls), at the cost of coarser increment/terminate granularity
+# and a larger all-or-nothing failure unit.
+def _load_storage_batch_size() -> int:
+    value = envs.SGLANG_HICACHE_STORAGE_BATCH_SIZE.get()
+    if value is None:
+        return 128
