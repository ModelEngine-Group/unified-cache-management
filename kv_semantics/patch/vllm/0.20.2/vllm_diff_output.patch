+
+    def _send_save_complete_layer_to_scheduler(self, req_ids: list[str], layer_idx: int,
+        connector_metadata: OdKvStorageConnectorMetadata):
+
+        # logger.warning(f"income layer completion: req_id {req_ids}, layer_num {layer_idx}")
+
+        self._shared_memory[self._tp_rank] = layer_idx
+
+        # fist check if req is last prefill chunk
+        need_send = False
+        for req_id in req_ids:
+            if connector_metadata.request_meta[req_id].is_last_chunk:
+                need_send = True
+                break
+        
+        if not need_send:
+            return
+
+        if self._kv_role == "kv_producer":
+            for req_id in req_ids:
+                self._req_complete_layer_num[req_id] = layer_idx
+
+        if self._kv_role == "kv_producer" and layer_idx == int(self._total_num_hidden_layers * G_BEST_LAYER_RATE):
+            # to adjust pp, pipe is not a proper choice
+            # os.write(self._early_reqponse_write_event_fd, b'\x01')
+            path = make_zmq_path("tcp", self._scheduler_host, self._scheduler_port + self._dp_rank)
+            logger.warning(
+                f"income early response layer completion: req_id {req_ids}, layer_idx {layer_idx}, "
+                f"send to {path}"
+            )
+            with zmq_ctx(zmq.DEALER, path) as sock:
+                # here we just make it simple
+                pay_load = b"done"
+                sock.send_multipart([b"", pay_load])
+
+    
+    def _handle_store_failure(
+        self,
+        layer_idx: int,
+        failed_block_ids: list[int],
+        connector_metadata: OdKvStorageConnectorMetadata,  
+    ) -> None:
+        if self._kv_role != "kv_producer":
+            return
+
+        # only producer needs to handle store failure
+        failed_block_id_set = set(failed_block_ids)
+        req_metas = connector_metadata.request_meta
+
+        for req_id, req_meta in req_metas.items():
+            if len(req_meta.persistent_block_ids[0]) == 0:
+                continue
+            block_id_len = len(req_meta.full_block_ids[0])
+            for idx, block_id in enumerate(req_meta.full_block_ids[1]):
+                if block_id in failed_block_id_set:
+                    self._store_failure_block_ids[req_id][layer_idx].append(idx - block_id_len)
+            if self._enable_failure_escape:
+                self._mooncake_plugin.update_need_send(req_id,
+                    req_meta.full_block_ids[1], layer_idx, self._store_failure_block_ids[req_id][layer_idx])
+
+
+    def _save_layer_wait_task(
+        self,
+        layer_idx: int,
+        connector_metadata: OdKvStorageConnectorMetadata
+    ) -> None:
+        best_layer = int(self._total_num_hidden_layers * G_BEST_LAYER_RATE)
+        layers_to_wait:list[int] = []
+        # if layer_idx == best_layer:
+        #     layers_to_wait.extend(list(range(0, best_layer + 1)))
+        # elif layer_idx > best_layer:
+        #     layers_to_wait.append(layer_idx)
+        
+        # op is too weak to optimize
+        layers_to_wait.append(layer_idx)
+        
+        for idx in layers_to_wait:
+            failed_block_ids = []
+            for io_metadata in self._store_input[idx]:
+                ret, result_list = self._storage_interface.xds_wait(
+                    io_metadata.batch_io_name,
+                    io_metadata.io_num,
+                    self._store_stream_id
+                )
+                if ret != 0:
+                    logger.error(f"put failed! io: {io_metadata.batch_io_name}, result list: {result_list}")
+                    fail_idx = [index for index, val in enumerate(result_list) if val > 0]
+                    failed_block_ids.extend([io_metadata.block_id_list[i] for i in fail_idx])
+            self._handle_store_failure(idx, failed_block_ids, connector_metadata)
+            req_ids = self._batch_to_req[self._batch_id]
+            self._send_save_complete_layer_to_scheduler(req_ids, idx, connector_metadata)
+
+
+    def _sync_and_submit_save(self,end_event, layer_idx:int, connector_metadata: OdKvStorageConnectorMetadata):
+        with get_module().stream(self._store_stream):
+            target_npu_stream = self._store_stream.npu_stream
+            ret = acl.rt.stream_wait_event(target_npu_stream, end_event)
+            if ret != 0:
+                raise RuntimeError(f"acl.rt.stream_wait_event failed: {ret}")
+
+            for io_metadata in self._store_input[layer_idx]:
+                ret = self._storage_interface.xds_put(
+                    req_id=io_metadata.batch_io_name,
+                    mr_id_list=io_metadata.mr_id_list,
+                    block_hash_list=io_metadata.block_hash_list,
+                    hbm_addr_list=io_metadata.hbm_addr_list,
+                    storage_offset_list=io_metadata.storage_offset_list,
+                    length_list=io_metadata.length_list,
+                    stream_id=self._store_stream_id,
+                )
+            self._save_layer_wait_task(layer_idx, connector_metadata)
+
+
+    @timeit
+    def save_kv_layer(self, layer_name: str, kv_layer: torch.Tensor,
+                      attn_metadata: "AttentionMetadata", connector_metadata: OdKvStorageConnectorMetadata, **kwargs) -> None:
+        """Start saving the KV cache of the layer from vLLM's paged buffer 
+        to the connector.
+
+        Args:
+            layer_name (str): the name of the layer.
+            kv_layer (torch.Tensor): the paged KV buffer of the current 
+                layer in vLLM.
+            attn_metadata (AttentionMetadata): the attention metadata.
+            **kwargs: additional arguments for the save operation.
+        """
+        layer_idx = extract_layer_index(layer_name)
+
+        # no store
+        if len(self._store_input) == 0:
+            req_ids = self._batch_to_req[self._batch_id]
+            self._send_save_complete_layer_to_scheduler(req_ids, layer_idx, connector_metadata)
+            return
+
+        # print("[Prefill] save_kv_layer")
+        # sync hbm (reshape_and_cache is async fun)
+        # end_event = getattr(attn_metadata, "end_event", None)
+        # if not end_event:
+        #     end_event = get_module().Event()
+        #     end_event.record()
+ 
+        end_event, ret = acl.rt.create_event()
+        if ret != 0:
+            raise RuntimeError(f"acl.rt.create_event failed: {ret}")
+        # acl.rt.record_event needs the raw ACL stream handle, not a torch.npu.Stream object
+        current_stream = get_module().current_stream()
+        ret = acl.rt.record_event(end_event, current_stream.npu_stream)
+        if ret != 0:
+            acl.rt.destroy_event(end_event)
+            raise RuntimeError(f"acl.rt.record_event failed: {ret}")
+
+        self._save_queue.enqueue(self._sync_and_submit_save, end_event, layer_idx, connector_metadata)
+        return
+
+
+    @timeit
+    def wait_for_save(self):
+        """
+        Block until all the save operations is done. This is called
+        as the forward context exits to ensure that the async saving
+        from save_kv_layer is complete before finishing the forward.
+
+        This prevents overwrites of paged KV buffer before saving done.
+        """
+        # block
+        # logger.info(f"save queue length {self._save_queue._queue.qsize()}")
+        self._save_queue.join()
+
+        self._batch_to_req.pop(self._batch_id, None)
+        return
+
+
+    @timeit
+    def get_finished(
+        self, finished_req_ids: set[str]
+    ) -> tuple[Optional[set[str]], Optional[set[str]]]:
+        """
+        Notifies worker-side connector ids of requests that have
+        finished generating tokens.
+
+        Returns:
+            ids of requests that have finished asynchronous transfer
+            (requests that previously returned True from request_finished()),
+            tuple of (sending/saving ids, recving/loading ids).
+            The finished saves/sends req ids must belong to a set provided in a
+            call to this method (this call or a prior one).
+        """
+
+        # in OdKvStorageConnector we only process done recv, as data is in storage
+        done_recving = set()
+        recv_to_del = []
+        #logger.error(f"rank {self._tp_rank} {self._recv_pd_resource_tracker.request_resources}")
+        for req_id, req_resource in self._recv_pd_resource_tracker.request_resources.items():
+            if req_resource.local_complete_layer_num == self._end_layer and req_resource.reported == False:
+                done_recving.add(req_id)
+                req_resource.reported = True
+                if req_resource.remote_complete_layer_num == self._end_layer:
+                    recv_to_del.append(req_id)
+        
+        done_sending = set()
+        send_to_del = []
+        for req_id in self._req_send_finish_set:
+            done_sending.add(req_id)
+            send_to_del.append(req_id)
+
+        # pop resources for all completed task
+        for req_id in recv_to_del:
+            self._recv_pd_resource_tracker.request_resources.pop(req_id)
+
+        for req_id in send_to_del:
+            self._req_send_finish_set.remove(req_id)
+        
+        return done_sending, done_recving
+
+
+    @timeit
+    def get_block_ids_with_load_errors(self) -> set[int]:
+        """
+        Get the set of block IDs that failed to load.
+
+        Returns:
+            Set of block IDs that encountered load errors.
+            Empty set if no load errors occurred.
+
+        Notes:
+            - Applies to both sync- and async-loading requests.
+            - Async loading: failed blocks may be reported in any forward pass
+              up to and including the pass where the request ID is returned by
+              `get_finished()`. Even if failures occur, the request must still
+              be reported via `get_finished()`, and the failed block IDs must
+              appear here no later than that same pass.
+            - Sync loading: failed blocks should be reported in the forward
+              pass in which they are detected.
+        """
+        load_fail_block_ids = self._load_failure_block_ids.copy()
+        
+        # logger.warning(f"{load_fail_block_ids=}")
+        
+        for block_id in load_fail_block_ids:
+            self._load_failure_block_ids.remove(block_id)
+        return load_fail_block_ids
