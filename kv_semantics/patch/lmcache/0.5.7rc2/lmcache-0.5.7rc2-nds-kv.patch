+
+    def wait_until_exists(
+        self,
+        keys: Sequence[CacheEngineKey],
+        timeout: float,
+        poll_interval: float = 0.01,
+        stop_event: Optional[threading.Event] = None,
+    ) -> bool:
+        """Wait until every key is visible in the shared NDS namespace.
+
+        ``is_exists`` reports only the length of the visible prefix. This
+        method therefore succeeds only when its return value equals the full
+        key count; partial prefixes and negative error returns never pass the
+        barrier. It is used as the publication/read fence for NDS-backed PD.
+
+        :param keys: Keys that must all be visible before transfer proceeds.
+        :param timeout: Maximum wall-clock wait in seconds.
+        :param poll_interval: Delay between visibility probes in seconds.
+        :param stop_event: Optional event that interrupts the wait on shutdown.
+        :return: ``True`` only when all keys are visible; ``False`` on timeout,
+            cancellation, or an empty key sequence.
+        """
+        if not keys:
+            return False
+
+        self._ensure_nds_initialized()
+        block_ids = [self._encode_block_id(key) for key in keys]
+        deadline = time.monotonic() + timeout
+        while True:
+            if stop_event is not None and stop_event.is_set():
+                return False
+
+            visible = self._is_exists_logged(block_ids)
+            if visible == len(block_ids):
+                self._record_pynds_success()
+                return True
+            if visible < 0:
+                self._record_read_failure("is_exists failed during PD fence")
+
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                logger.warning(
+                    "Timed out after %.1fs waiting for all %d NDS keys; "
+                    "last is_exists result=%d",
+                    timeout,
+                    len(keys),
+                    visible,
+                )
+                return False
+
+            delay = min(poll_interval, remaining)
+            if stop_event is None:
+                time.sleep(delay)
+            elif stop_event.wait(delay):
+                return False
+
+    def batched_get_blocking(
+        self,
+        keys: list[CacheEngineKey],
