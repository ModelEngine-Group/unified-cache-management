+    @timeit
+    def wait_for_layer_load(self, layer_name: str) -> None:
+        """Blocking until the KV for a specific layer is loaded into vLLM's
+        paged buffer. 
+        
+        This interface will be useful for layer-by-layer pipelining.
+
+        Args:
+            layer_name: the name of that layer
+        """
+        # no load
+        if len(self._load_input) == 0:
+            #logger.error(f"wait_for_layer_load return immediately")
+            return
+
+        layer_idx = extract_layer_index(layer_name)
+
+        for io_metadata in self._load_input[layer_idx]:
+            ret, result_list = self._storage_interface.xds_wait(
+                io_metadata.batch_io_name,
+                io_metadata.io_num,
+                stream_id=self._load_wait_stream_id
+            )
+
+            if self._device_type == "cuda":
+                # wait for load finish
+                g = self._done_record_event_queue.get()
+
+            # TODO: add failure management
+            if ret != 0:
+                logger.error(f"get failed! io: {io_metadata.batch_io_name}, result_list: {result_list}")
+                fail_idx = [index for index, val in enumerate(result_list) if val > 0]
+                failed_block_ids = [io_metadata.block_id_list[i] for i in fail_idx]
+                self._load_failure_block_ids.update(failed_block_ids)
+
+        # print("[Decde] wait_for_layer_load")
+        return
