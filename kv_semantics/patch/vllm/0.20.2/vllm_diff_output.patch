+                storage_offset_list: list[int], length_list: list[int], stream_id: int) -> int:
+        '''
+            同步接口, 调用2层接口
+
+            INPUT:
+                req_id:                 框架request id或自定义batch id
+                mr_id_list:             kvcache base地址idx list
+                block_hash_list:        待存的block key list
+                hbm_addr_list:          待存的block相对base地址的偏移list
+                storage_offset_list:    block 在存储侧的偏移list
+                length_list:            每一个block的长度
+
+                tips: k/v用同一个key，对应block hash list放入两个相同key，对应不同的offset等值
+            OUTPUT:
+                status (0 failed, 1 succeed)
+                TODO：算子接口待回复out tensor在该接口内感知每个block的IO成功/失败情况
+        '''
+        
+        id = self._str_to_int_id(req_id)
+        
+        if self.device_type == "npu":
+            block_key_list = self.batch_get_block_key(block_hash_list)
+            ret = rdma.aiv_put_batch(
+                stream_id,
+                id,
+                mr_id_list,
+                self.kvnsid,
+                block_key_list,
+                hbm_addr_list,
+                storage_offset_list,
+                length_list
+            )
+        elif self.device_type == "cuda":
+            output = [0] * len(mr_id_list)
+            ret = kvs_torch.kvcache_put_batch(
+                stream_id,
+                id,
+                mr_id_list,
+                self.kvnsid,
+                block_hash_list,
+                hbm_addr_list,
+                storage_offset_list,
+                length_list,
+                output # TODO: this output makes no sense
+            )
+            pass
+        # CPU has already warned
+
+        # logger.error(f"id {id} put ret: {ret}")
+        return ret
+        pass
+
+
+    def xds_wait(self, req_id: str, output_len: int, stream_id: int, record_event=None) -> int:
+        id = self._str_to_int_id(req_id)
+        # logger.error(f"wait for task {id}")
+
+        if self.device_type == "npu":
+            ret, result = rdma.aiv_wait(
+                stream_id,
+                id,
+                output_len,
+                rdma.AivWaitMode.Block)
+        elif self.device_type == "cuda":
+            # currently cuda doesn't provide way to get result
+            record_event.synchronize()
+            ret = 0
+            result = [0] * output_len
+            pass
+        # CPU has already warned
+
+        # logger.error(f"id {id} wait ret: {ret}")
+        return ret, result
+
+
+    def get_knsid(self):
+        m1 = hashlib.sha256(self.model_name.encode('utf-8')).hexdigest()
+        return int(m1, 16)
+
+    
+    def _str_to_int_id(self, req_id_str: str) -> int:
+        """将字符串 ID 转换为 4 字节无符号整数"""
+        return zlib.crc32(req_id_str.encode()) & 0xFFFFFFFF
