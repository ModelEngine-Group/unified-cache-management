+    def _batched_load_from_kv(
+        self,
+        keys: list[CacheEngineKey],
+        memory_objs: list[MemoryObj],
+    ) -> list[MemoryObj]:
+        # Rotate read order by a rank-derived shift so concurrent TP
+        # ranks prefetching the same (MLA rank-replicated) key space
+        # start at different blocks.  memory_objs is returned in the
+        # original order; rotation only affects the IO request order.
+        pairs = self._rotate_for_rank(list(zip(keys, memory_objs, strict=False)))
