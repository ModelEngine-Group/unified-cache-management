+    AsyncPQThreadPoolExecutor,
+)
+from lmcache.v1.storage_backend.local_cpu_backend import LocalCPUBackend
+
+if TYPE_CHECKING:
+    # First Party
+    from lmcache.inprocess.v1.cache_controller.worker import LMCacheWorker
+
+logger = init_logger(__name__)
+
+# Interval (in number of calls) between IO bandwidth summary emissions.
+# The summary is only printed when LMCACHE_KV_DEBUG_LOG is set; the same
+# flag also enables per-call kv_set/kv_get/kv_exists/kv_put debug lines.
+_STATS_LOG_INTERVAL = 50
+
+def _kv_debug() -> bool:
+    """Whether per-call KV IO debug logging is enabled.
+
+    When LMCACHE_KV_DEBUG_LOG is set, every pynds_kv call (batchPut /
+    batchGet / is_exists / single put / single get) emits one info log
+    with nsid, key count, bytes, IO duration, bandwidth, block_id range,
+    attempts and return code -- the per-call counterpart of the 50-call
+    bandwidth summary (parity with SGLANG_HICACHE_KV_DEBUG_LOG).
+    """
+    return bool(os.environ.get("LMCACHE_KV_DEBUG_LOG"))
+
+
+# Global NDS initialization guard
+_nds_initialized = False
+_pynds_init_failed = False
+_nds_init_lock = threading.Lock()
+
+# Stored init parameters for lazy retry when startup init fails
+_init_buffer: Any = None
+_init_buffer_size: int = 0
+_init_nds_config_path: Optional[str] = None
+_init_worker_id: int = 0
+_init_timeout: float = 30.0
+_init_stagger_rank: Optional[int] = None
+
+# Warmup IO: the vendor NDS client establishes its data channels lazily per
+# namespace; round-trips after every successful init (eager or lazy retry)
+# exercise the data path and establish connections before live traffic.
+_WARMUP_IO_BYTES = 1024 * 1024
+# Warmup block_ids live in the reserved key_high space 0xFFFF (real data
+# keys encode worker_id 0..0xFFFE there, or a full 64-bit hash when
+# world_size <= 1).  Keys are deterministic, so a key left over from a
+# previous run holds the same pattern and the read-back check still passes.
+_WARMUP_KEY_HIGH = 0xFFFF
+
+# Post-init warmup hook: registered by KVStorageBackend.__init__ so that
+# every successful NDS init (eager or lazy retry) inside _init_nds_once is
+# followed by the one-shot warmup.  A hook is used because _init_nds_once
+# is module-level while warmup needs backend instance state (timeout
+# executor, health tracking, warmup buffer).
+_warmup_hook: Optional[Callable[[], None]] = None
+
+
+def _call_pynds_init_with_timeout(init_func, timeout, *args):
+    """Run ``init_func`` in a daemon thread with a timeout.
+
+    Unlike :class:`ThreadPoolExecutor` whose ``future.result(timeout)``
+    leaves the underlying thread alive and can block on ``shutdown()``,
+    a daemon thread is simply abandoned on timeout — acceptable for a
+    one-shot init call where the stale thread stays in the background
+    and the process will exit if init never recovers.
+    """
+    result = {"value": -1, "exception": None}
+
+    def _target():
+        try:
+            result["value"] = init_func(*args)
+        except Exception as exc:
+            result["exception"] = exc
+
+    thread = threading.Thread(target=_target, daemon=True)
+    thread.start()
+    thread.join(timeout=timeout)
+    if thread.is_alive():
+        raise TimeoutError(
+            f"pynds_kv.init timed out after {timeout}s"
+        )
+    if result["exception"] is not None:
+        raise result["exception"]
+    return result["value"]
+
+
+def _init_nds_once(buffer, buffer_size, nds_config_path=None,
+                   worker_id=0, timeout=30.0, stagger_rank=None,
+                   force=False):
+    """Initialize pynds_kv exactly once across all backend instances.
+
+    On failure the backend degrades to cache miss (``_pynds_init_failed``
+    flag) instead of crashing the server.  A lazy retry path
+    (``_ensure_nds_initialized``) attempts recovery on the first IO call.
+
+    ``stagger_rank`` overrides ``worker_id`` for the init stagger; callers
+    pass the node-unique GPU index so staggering stays effective even when
+    worker_id collides across DP groups.  ``force`` is used by the lazy
+    retry path: a failed first attempt latches ``_pynds_init_failed`` and
+    non-forced calls return early so concurrent first-time callers do not
+    pile into init; the retry from ``_ensure_nds_initialized`` must bypass
+    that latch, otherwise the latch makes the retry a no-op.
+    """
+    global _nds_initialized, _pynds_init_failed
+    global _init_buffer, _init_buffer_size, _init_nds_config_path
+    global _init_worker_id, _init_timeout, _init_stagger_rank
+
+    # Store parameters before the lock so _ensure_nds_initialized can
+    # retry even when the first init attempt fails inside the lock.
+    _init_buffer = buffer
+    _init_buffer_size = buffer_size
+    _init_nds_config_path = nds_config_path
+    _init_worker_id = worker_id
+    _init_timeout = timeout
+    _init_stagger_rank = stagger_rank
+
+    # Rank-staggered init reduces contention when multiple TP processes
+    # establish their NDS connections concurrently.
+    stagger = float(os.environ.get("LMCACHE_KV_INIT_STAGGER_S", "0"))
+    eff_stagger_rank = stagger_rank if stagger_rank is not None else worker_id
+    if stagger > 0 and eff_stagger_rank > 0:
+        delay = stagger * eff_stagger_rank
+        logger.info(
+            "NDS init stagger: rank %d waiting %.1fs before init",
+            eff_stagger_rank,
+            delay,
+        )
+        time.sleep(delay)
+
+    with _nds_init_lock:
+        if _nds_initialized:
+            return
+        if _pynds_init_failed and not force:
+            return  # wait for lazy retry
+
+        # Alignment check: pynds_kv v1.7 initMulti has a 4096-byte
+        # pre-check that fail-fasts on misaligned buffers.
+        try:
+            buf_addr = buffer.ctypes.data
+        except AttributeError:
+            try:
+                # memoryview: extract the underlying pointer
+                import ctypes as _ctypes
+                buf_addr = _ctypes.c_void_p.from_buffer(
+                    buffer
+                ).value
+            except Exception:
+                buf_addr = None
+        if buf_addr is not None and buf_addr % 4096 != 0:
+            logger.warning(
+                "Host pool buffer base=%#x is not 4096-aligned; "
+                "skipping NDS init (backend will degrade to cache miss).",
+                buf_addr,
+            )
+            _pynds_init_failed = True
+            return
+
+        # Third Party
+        import pynds_kv
+
+        try:
+            ret = _call_pynds_init_with_timeout(
+                pynds_kv.init, timeout, buffer, buffer_size,
+                nds_config_path,
+            )
+        except Exception as e:
+            _pynds_init_failed = True
+            logger.error(
+                "pynds_kv.init failed; KV backend will degrade to "
+                "cache miss: %s",
+                e,
+            )
+            return
+        if ret != 0:
+            _pynds_init_failed = True
+            logger.error(
+                "pynds_kv.init returned %d; KV backend will degrade "
+                "to cache miss",
+                ret,
+            )
+            return
+        _nds_initialized = True
+        logger.info("NDS (pynds_kv) initialized")
+        # One-shot warmup round-trip after every successful init (eager
+        # and lazy retry alike); the hook is a no-op when disabled or
+        # already done.  Runs under _nds_init_lock, which is fine: warmup
+        # only issues pynds_kv IO and never touches the init lock.
+        if _warmup_hook is not None:
+            try:
+                _warmup_hook()
+            except Exception as e:
+                logger.error("NDS warmup IO raised unexpectedly: %s", e)
+
+
+# TODO(Jiayi): handle cases where cache is repetitvely prefetched.
+class KVStorageWorker:
+    def __init__(self, loop: asyncio.AbstractEventLoop) -> None:
+        self.put_lock = threading.Lock()
+        self.put_tasks: List[CacheEngineKey] = []
+
+        self.prefetch_lock = threading.Lock()
+        self.prefetch_tasks: dict[CacheEngineKey, Future] = {}
+
+        # Split put/prefetch into separate executors so that prefetch
+        # does not starve put tasks and vice versa.
+        self.put_executor = AsyncPQThreadPoolExecutor(loop, max_workers=6)
+        self.get_executor = AsyncPQThreadPoolExecutor(loop, max_workers=4)
+        self.loop = loop
+        self._closed = False
+
+    async def submit_task(
+        self,
+        task_type: str,
+        task: Callable,
+        *args,
+        **kwargs,
+    ) -> Any:
+        if task_type == "prefetch":
+            priority = 0
+            executor = self.get_executor
+        elif task_type == "delete":
+            priority = 1
+            executor = self.get_executor
+        elif task_type == "put":
+            priority = 2
+            executor = self.put_executor
+        else:
+            raise ValueError(f"Unknown task type: {task_type}")
+
+        return await executor.submit_job(
+            task,
+            *args,
+            priority=priority,
+            **kwargs,
+        )
+
+    def remove_put_task(self, key: CacheEngineKey):
+        with self.put_lock:
+            if key in self.put_tasks:
+                self.put_tasks.remove(key)
+            else:
+                logger.warning(f"Key {key} not found in put tasks.")
+
+    def insert_put_task(self, key: CacheEngineKey):
+        with self.put_lock:
+            self.put_tasks.append(key)
+
+    def exists_in_put_tasks(self, key: CacheEngineKey) -> bool:
+        with self.put_lock:
+            return key in self.put_tasks
+
+    def close(self):
+        # Gracefully shut down the executors
+        if self._closed:
+            return
+        self._closed = True
+        self.put_executor.shutdown(wait=True)
+        self.get_executor.shutdown(wait=True)
+
+
+class KVStorageBackend(StorageBackendInterface):
+    def __init__(
+        self,
+        config: LMCacheEngineConfig,
+        loop: asyncio.AbstractEventLoop,
+        local_cpu_backend: LocalCPUBackend,
+        dst_device: str = "cuda",
+        lmcache_worker: Optional["LMCacheWorker"] = None,
+        metadata: Optional[LMCacheMetadata] = None,
+    ):
+        if torch.cuda.is_available():
+            super().__init__(dst_device)
+        else:
+            super().__init__("cpu")
+
+        self.cache_policy = get_cache_policy(config.cache_policy)
+        self.dict = self.cache_policy.init_mutable_mapping()
+
+        self.dst_device = dst_device
+        self.local_cpu_backend = local_cpu_backend
+        self.kv_lock = threading.Lock()
+
+        # Read KV-specific configuration
+        self.nsid = config.kv_storage_nsid
+        if self.nsid <= 0:
+            raise ValueError(f"kv_storage_nsid must be > 0, got {self.nsid}")
+
+        self.nds_config_path: Optional[str] = config.kv_storage_nds_config
+
+        # Per-rank NDS start_core shift: "0" = off (shared conf), positive
+        # integer = linear per-rank offset, "auto" = NUMA-derived window.
+        self._nds_core_stride = (
+            str(getattr(config, "kv_storage_nds_core_stride", "0")).strip().lower()
+        )
+        # Warmup IO right after NDS init (see module-level notes).
+        self._warmup_io_on_init = getattr(
+            config, "kv_storage_warmup_io_on_init", True
+        )
+        self._warmup_io_keys = getattr(config, "kv_storage_warmup_io_keys", 16)
+        self._warmup_done = False
+        self._warmup_array: Any = None
+        # Resolve and cache the node-unique GPU index on the main thread:
+        # torch.cuda.current_device() is thread-local and IO threads have
+        # not run the engine's set_device call.
+        self._node_gpu_index = self._resolve_node_gpu_index(
+            metadata.worker_id if metadata is not None else 0
+        )
+        # Register the warmup hook so the lazy retry path inside
+        # _init_nds_once is covered as well (latest instance wins).
+        global _warmup_hook
+        _warmup_hook = self._maybe_warmup_nds_io
+
+        self.max_cache_size = int(config.kv_storage_max_size * 1024**3)
+        self.current_cache_size = 0.0
+
+        self.loop = loop
+
+        # Timeout guard for pynds_kv calls (KV box may hang)
+        self._pynds_timeout = getattr(config, "kv_storage_timeout", 30.0)
+        self._max_workers = getattr(config, "kv_storage_pynds_workers", 32)
+        # Concurrency cap only — each pynds_kv call runs in its own daemon
+        # thread instead of a shared ThreadPoolExecutor, so a timed-out call
+        # leaks one abandoned thread rather than permanently consuming a
+        # shared pool slot (32 stuck calls used to exhaust the whole pool
+        # and take down both the read and write paths).
+        self._pynds_semaphore = threading.Semaphore(self._max_workers)
+
+        # Health state: read and write health are tracked separately.
+        # Write (put/batchPut) failures flip `_healthy`, which gates the
+        # write path (backup is the critical path); read (get/batchGet/
+        # is_exists) failures flip `_read_healthy`, which gates
+        # contains/batched_contains so the scheduler does not stall on
+        # lookups against a dead KV box.  Read failures never gate writes:
+        # the NDS box flow-controls read bursts (e.g. all TP ranks of an
+        # MLA model reading the same rank-replicated key space), and
+        # flapping reads must not stall the backup path.
+        self._healthy = True
+        self._read_healthy = True
+        self._consecutive_failures = 0
+        self._consecutive_read_failures = 0
+        self._failure_threshold = getattr(config, "kv_storage_failure_threshold", 1)
+
+        # Unhealthy short-circuit + probe recovery: while a breaker is open,
+        # one call per `kv_storage_unhealthy_probe_interval` seconds is let
+        # through as a probe; a successful probe recovers both breakers via
+        # _record_pynds_success.  Should be larger than kv_storage_timeout.
+        self._unhealthy_probe_interval = getattr(
+            config, "kv_storage_unhealthy_probe_interval", 60.0
+        )
+        self._probe_lock = threading.Lock()
+        self._last_write_probe = 0.0
+        self._last_read_probe = 0.0
+
+        # Bounded retry for batchGet: the NDS box rejects read bursts under
+        # flow control and such rejections are usually transient.
+        self._get_retry_count = getattr(config, "kv_storage_get_retry_count", 3)
+        self._get_retry_backoff = getattr(config, "kv_storage_get_retry_backoff", 0.2)
+
+        # TP rank info for rank-rotated read order.  MLA latent KV is
+        # rank-replicated (save_only_first_rank collapses key world_size to
+        # 1), so every TP rank reads the same block_ids and tends to issue
+        # identical batchGet bursts simultaneously; rotating each rank's
+        # read order spreads concurrent same-key requests over time.
+        self._worker_id = metadata.worker_id if metadata is not None else 0
+        self._world_size = metadata.world_size if metadata is not None else 1
+        self._lmc_metadata = metadata
+        self._chunk_size = metadata.chunk_size if metadata is not None else 256
+        self._kv_fmt = MemoryFormat.KV_MLA_FMT if (
+            metadata is not None and metadata.use_mla
+        ) else MemoryFormat.KV_2LTD
+
+        # Initialize pynds_kv using the shared CPU buffer.
+        # On failure the init function logs the error and sets a global
+        # flag; startup continues (backend degrades to cache miss).
+        allocator = local_cpu_backend.get_memory_allocator()
+        buffer = allocator.buffer
+        buffer_size = getattr(allocator, "nds_registered_size", allocator.size)
+        if buffer_size - allocator.size >= _WARMUP_IO_BYTES and hasattr(
+            buffer, "numpy"
+        ):
+            # Tail-pad region: registered with NDS but never handed out by
+            # the allocator, so warmup IO is safe even when it runs on the
+            # lazy-init path during traffic.
+            self._warmup_array = buffer.numpy()[allocator.size : buffer_size]
+        try:
+            eff_nds_config_path = self._materialize_rank_nds_config()
+            if hasattr(buffer, "numpy"):
+                _init_nds_once(
+                    memoryview(buffer.numpy()),
+                    buffer_size,
+                    eff_nds_config_path,
+                    worker_id=metadata.worker_id if metadata is not None else 0,
+                    stagger_rank=self._node_gpu_index,
+                    timeout=getattr(config, "kv_storage_timeout", 30.0),
+                )
+            else:
+                _init_nds_once(
+                    memoryview(buffer),
+                    buffer_size,
+                    eff_nds_config_path,
+                    worker_id=metadata.worker_id if metadata is not None else 0,
+                    stagger_rank=self._node_gpu_index,
+                    timeout=getattr(config, "kv_storage_timeout", 30.0),
+                )
+        except Exception as e:
+            logger.error(
+                "NDS init at startup failed unexpectedly: %s", e
+            )
+        logger.info(f"KVStorageBackend initialized with nsid={self.nsid}")
+
+        self.kv_worker = KVStorageWorker(loop)
+
+        self.lmcache_worker = lmcache_worker
+        self.instance_id = config.lmcache_instance_id
+        self.stats_monitor = LMCStatsMonitor.GetOrCreate()
+        self.usage = 0
+
+
+        # Cumulative IO stats for aggregate bandwidth reporting.
+        # A summary is emitted every _STATS_LOG_INTERVAL calls when
+        # the LMCACHE_KV_DEBUG_LOG environment variable is set.
+        self._get_calls = 0
+        self._get_bytes = 0
+        self._get_time = 0.0
+        self._get_win_bytes = 0
+        self._get_win_start: Optional[float] = None
+        self._get_first_ts: Optional[float] = None
+        self._set_calls = 0
+        self._set_bytes = 0
+        self._set_time = 0.0
+        self._set_win_bytes = 0
+        self._set_win_start: Optional[float] = None
+        self._set_first_ts: Optional[float] = None
+
+        # Batched message sender for controller communication
+        self.batched_msg_sender: Optional[BatchedMessageSender] = None
+        if lmcache_worker and metadata is not None:
+            self.batched_msg_sender = BatchedMessageSender(
+                metadata=metadata,
+                config=config,
+                location=str(self),
+                lmcache_worker=lmcache_worker,
+            )
+        else:
+            logger.warning("Controller message sender is not initialized")
+
+        # to help maintain suffix -> prefix order in the dict
+        self.keys_in_request: List[CacheEngineKey] = []
+
+    def __str__(self) -> str:
+        return "KVStorageBackend"
+
+    def _encode_block_id(self, key: CacheEngineKey) -> int:
+        """Encode worker_id into the high bits of block_id to avoid collisions
+        across tensor-parallel ranks.
+
+        pynds_kv v1.7 起底层 block_key 为 80 位（key_low 64 位 + key_high
+        16 位），wrapper 接受 flat int < 2^80 并默认对 80-bit key 做 xxhash
+        打散（分盘均匀性不依赖高位编码）。因此编码升级为：
+
+        - 高 16 位（key_high，bits [79:64]）：worker_id（支持 TP size 最大 65536）
+        - 低 64 位（key_low）：完整 chunk_hash，不再截断
+
+        当 world_size <= 1 时（单卡或 MLA save_only_first_rank），
+        不做编码，直接返回完整 64 位 chunk_hash。
+        """
+        if key.world_size <= 1:
+            return key.chunk_hash & 0xFFFFFFFFFFFFFFFF
+
+        WORKER_ID_BITS = 16
+        worker_id_mask = (1 << WORKER_ID_BITS) - 1  # 0xFFFF
+        hash_mask = 0xFFFFFFFFFFFFFFFF
+
+        return ((key.worker_id & worker_id_mask) << 64) | (
+            key.chunk_hash & hash_mask
+        )
+
+    def _ensure_nds_initialized(self) -> None:
+        """Retry NDS init on the first IO call after a failed startup init.
+
+        If startup init failed (e.g. KV box temporarily unreachable), the
+        backend starts in degraded mode.  The first IO entry point that
+        calls this method attempts one retry using the parameters stored
+        by the original ``_init_nds_once`` call.
+        """
+        global _nds_initialized, _pynds_init_failed
+        if _nds_initialized:
+            return
+        if not _pynds_init_failed:
+            return
+        if _init_buffer is None:
+            return
+        logger.info(
+            "Retrying NDS init on first IO (startup init failed earlier)"
+        )
+        _init_nds_once(
+            _init_buffer,
+            _init_buffer_size,
+            _init_nds_config_path,
+            worker_id=_init_worker_id,
+            timeout=_init_timeout,
+            stagger_rank=_init_stagger_rank,
+            force=True,
+        )
+
+    @staticmethod
+    def _resolve_node_gpu_index(fallback: int) -> int:
+        """Node-unique GPU index for per-rank conf / stagger / warmup keys.
+
+        Resolved on the main thread at backend construction, after the
+        engine has called ``torch.cuda.set_device`` for this worker; the
+        value is cached so that lazy NDS init on IO threads (where
+        ``torch.cuda.current_device()`` is thread-local and would wrongly
+        report 0) reuses it.  Falls back to ``fallback`` (worker_id /
+        tp_rank) when CUDA is unavailable.
+        """
+        try:
+            if torch.cuda.is_available():
+                return torch.cuda.current_device()
+        except Exception:
+            pass
+        return fallback
+
+    def _materialize_rank_nds_config(self) -> Optional[str]:
+        """Return the nds_config path to use, possibly a per-rank rewrite.
+
+        The NDS SDK pins its IO threads from the conf's ``start_core``;
+        shift this value for each rank to avoid sharing the same cores.
+        NUMA-aware absolute placement is preferred; the linear offset mode
+        is the fallback when the topology cannot be queried; ``"auto"``
+        passes the base conf through when topology is unknown.
+
+        Raises:
+            ValueError: On misconfiguration (loud deployment error); the
+                caller treats it like an init failure and degrades to
+                cache miss.
+        """
+        stride = self._nds_core_stride
+        if stride in ("0", ""):
+            return self.nds_config_path
+        if not self.nds_config_path:
+            raise ValueError(
+                "kv_storage_nds_core_stride requires kv_storage_nds_config"
+            )
+        stride_val = "auto" if stride == "auto" else int(stride)
+        start_core = nds_numa.numa_local_start_core(
+            self._node_gpu_index, stride_val
+        )
+        if start_core is not None:
+            return nds_numa.materialize_per_rank_nds_config_absolute(
+                self.nds_config_path, start_core
+            )
+        if stride == "auto":
+            logger.warning(
+                "kv_storage_nds_core_stride=auto but NUMA topology is "
+                "unavailable; passing the base nds_config through unchanged"
+            )
+            return self.nds_config_path
+        return nds_numa.materialize_per_rank_nds_config(
+            self.nds_config_path, self._node_gpu_index * stride_val
+        )
+
+    def _maybe_warmup_nds_io(self) -> None:
+        """One-shot warmup guard; registered as the post-init hook."""
+        if not self._warmup_io_on_init or self._warmup_done:
+            return
+        # The one-shot guard is set BEFORE the round-trip: a failed warmup
+        # is not retried — the backend is marked unhealthy instead and the
+        # normal IO probe/recovery path takes over.
+        self._warmup_done = True
+        if self._warmup_array is None:
+            logger.warning(
+                "NDS warmup skipped: no reserved tail-pad region in the "
+                "registered host buffer"
+            )
+            return
+        self._warmup_nds_io()
+
+    def _warmup_nds_io(self) -> None:
+        """Round-trip N keys x 1MiB through the KV box right after init.
+
+        Establish the NDS client's lazily-created data channels before live
+        traffic. On any failure the backend is marked unhealthy and degrades
+        to cache miss instead of blocking startup. Requires the box namespace
+        valueSize >= 1MiB.
+        """
+        # Third Party
+        import pynds_kv
+
+        n = self._warmup_io_keys
+        if n > 1024:
+            logger.warning(
+                "kv_storage_warmup_io_keys=%d exceeds the 1024 per-rank key "
+                "budget; truncating to 1024",
+                n,
+            )
+            n = 1024
+        if n <= 0:
+            return
+        arr = self._warmup_array[:_WARMUP_IO_BYTES]
+        rank = self._node_gpu_index % 64
+        for i in range(n):
+            block_id = (_WARMUP_KEY_HIGH << 64) | (rank * 1024 + i)
+            pattern = (i * 7 + rank) & 0xFF
+            arr[:] = pattern
+            ret = self._call_pynds_with_timeout(
+                pynds_kv.batchPut,
+                [block_id],
+                [arr],
+                [0],
+                [_WARMUP_IO_BYTES],
+                [self.nsid],
+            )
+            if ret != 0:
+                logger.error(
+                    "NDS warmup batchPut failed, ret=%d (key %d/%d, nsid=%d). "
+                    "Check that the box namespace valueSize >= %d bytes.",
+                    ret,
+                    i,
+                    n,
+                    self.nsid,
+                    _WARMUP_IO_BYTES,
+                )
+                self._record_pynds_failure("warmup batchPut failed")
+                self._record_read_failure("warmup batchPut failed")
+                return
+            arr[:] = 0
+            ret = self._call_pynds_with_timeout(
+                pynds_kv.batchGet,
+                [block_id],
+                [arr],
+                [0],
+                [_WARMUP_IO_BYTES],
+                [self.nsid],
+            )
+            if ret != 0 or not bool((arr == pattern).all()):
+                logger.error(
+                    "NDS warmup batchGet failed/mismatch, ret=%d (key %d/%d, "
+                    "nsid=%d)",
+                    ret,
+                    i,
+                    n,
+                    self.nsid,
+                )
+                self._record_pynds_failure("warmup batchGet failed")
+                self._record_read_failure("warmup batchGet failed")
+                return
+        logger.info(
+            "NDS warmup IO ok: rank=%d round-tripped %d bytes in %d keys "
+            "nsid=%d",
+            self._node_gpu_index,
+            _WARMUP_IO_BYTES,
+            n,
+            self.nsid,
+        )
+
+    def _call_pynds_with_timeout(self, func, *args, **kwargs) -> int:
+        """Wrap a pynds_kv call with timeout and exception handling.
+
+        Returns the function's return value on success, or -1 on timeout
+        or exception so callers can treat it the same as a pynds_kv
+        error code.
+
+        The call runs in a per-call daemon thread gated by
+        ``self._pynds_semaphore``.  On timeout the daemon thread is
+        abandoned (it may keep running the C++ call in the background,
+        which is harmless for idempotent put/get), but the semaphore is
+        released immediately — unlike ``ThreadPoolExecutor`` +
+        ``future.result(timeout)``, where the stuck worker thread keeps
+        its pool slot forever and enough stuck calls deadlock all
+        subsequent pynds_kv IO.
+        """
+        result = {"value": -1, "exception": None}
+
+        def _target():
+            try:
+                result["value"] = func(*args, **kwargs)
+            except Exception as exc:
+                result["exception"] = exc
+
+        with self._pynds_semaphore:
+            thread = threading.Thread(
+                target=_target, daemon=True, name="pynds_kv_call"
+            )
+            thread.start()
+            thread.join(timeout=self._pynds_timeout)
+            if thread.is_alive():
+                logger.error(
+                    "pynds_kv call %s timed out after %.1fs. "
+                    "The KV service may be unresponsive.",
+                    func.__name__,
+                    self._pynds_timeout,
+                )
+                return -1
+        if result["exception"] is not None:
+            logger.error(
+                "pynds_kv call %s raised exception: %s",
+                func.__name__,
+                result["exception"],
+            )
+            return -1
+        return result["value"]
+
+    def _record_io_stats(
+        self, is_get: bool, nbytes: int, dur: float
+    ) -> None:
+        """Accumulate per-call IO stats and emit a periodic bandwidth summary.
+
+        Called for every batch_get/batch_put (success or failure).  Bytes
+        are only counted on success so aggregate bandwidth reflects
+        actually transferred data.
+
+        Two bandwidth figures are reported: ``agg_bw`` (cumulative bytes
+        over cumulative per-call durations) and ``win_bw`` (bytes since
+        the last summary over elapsed wall time).  With parallel sub-batch
+        reads the per-call durations overlap, so ``win_bw`` is the
+        effective bandwidth comparable to NIC counters.  ``span_bw``
+        covers the whole run: total bytes over wall time from the first
+        call.
+        """
+        if nbytes <= 0:
+            return
+        now = time.monotonic()
+        emit = False
+        win_bytes = 0
+        win_dur = 0.0
+        span = 0.0
+        if is_get:
+            self._get_calls += 1
+            self._get_bytes += nbytes
+            self._get_time += dur
+            if self._get_first_ts is None:
+                self._get_first_ts = now
+            if self._get_win_start is None:
+                self._get_win_start = now
+            self._get_win_bytes += nbytes
+            tag = "kv_get_total"
+            calls = self._get_calls
+            total_bytes = self._get_bytes
+            total_time = self._get_time
+            if calls % _STATS_LOG_INTERVAL == 0:
+                win_bytes = self._get_win_bytes
+                win_dur = now - self._get_win_start
+                span = now - self._get_first_ts
+                self._get_win_bytes = 0
+                self._get_win_start = now
+                emit = True
+        else:
+            self._set_calls += 1
+            self._set_bytes += nbytes
+            self._set_time += dur
+            if self._set_first_ts is None:
+                self._set_first_ts = now
+            if self._set_win_start is None:
+                self._set_win_start = now
+            self._set_win_bytes += nbytes
+            tag = "kv_set_total"
+            calls = self._set_calls
+            total_bytes = self._set_bytes
+            total_time = self._set_time
+            if calls % _STATS_LOG_INTERVAL == 0:
+                win_bytes = self._set_win_bytes
+                win_dur = now - self._set_win_start
+                span = now - self._set_first_ts
+                self._set_win_bytes = 0
+                self._set_win_start = now
+                emit = True
+        if not emit:
+            return
+        if not os.environ.get("LMCACHE_KV_DEBUG_LOG"):
+            return
+        agg_bw = total_bytes / total_time / 1e6 if total_time > 0 else 0.0
+        win_bw = win_bytes / win_dur / 1e6 if win_dur > 0 else 0.0
+        span_bw = total_bytes / span / 1e6 if span > 0 else 0.0
+        logger.info(
+            "%s calls=%d total_bytes=%d total_time=%.3fs "
+            "agg_bw=%.1fMB/s win_bytes=%d win_dur=%.3fs "
+            "win_bw=%.1fMB/s span=%.3fs span_bw=%.1fMB/s",
+            tag,
+            calls,
+            total_bytes,
+            total_time,
+            agg_bw,
+            win_bytes,
+            win_dur,
+            win_bw,
+            span,
+            span_bw,
+        )
+
+    def _mark_unhealthy(self, reason: str = "") -> None:
+        if self._healthy:
+            logger.error("KVStorageBackend write path marked as unhealthy: %s", reason)
+            self._healthy = False
+
+    def _mark_read_unhealthy(self, reason: str = "") -> None:
+        if self._read_healthy:
+            logger.error("KVStorageBackend read path marked as unhealthy: %s", reason)
+            self._read_healthy = False
+
+    def _mark_healthy(self) -> None:
+        if not self._healthy or not self._read_healthy:
+            logger.info("KVStorageBackend recovered to healthy")
+            self._healthy = True
+            self._read_healthy = True
+        self._consecutive_failures = 0
+        self._consecutive_read_failures = 0
+
+    def _record_pynds_failure(self, reason: str = "") -> None:
+        """Record a write-path (put/batchPut) failure.
+
+        Only write failures flip the write breaker: the backup path is
+        critical and must not be dragged down by read-side flakiness.
+        """
+        self._consecutive_failures += 1
+        if self._consecutive_failures >= self._failure_threshold:
+            self._mark_unhealthy(
+                f"{reason} ({self._consecutive_failures} consecutive failures)"
+            )
+
+    def _record_read_failure(self, reason: str = "") -> None:
+        """Record a read-path (get/batchGet/is_exists) failure.
+
+        Read failures degrade to cache misses and flip only the read
+        breaker (gating contains/batched_contains so the scheduler does
+        not stall on timeouts against a dead KV box); they never gate
+        the write path.
+        """
+        self._consecutive_read_failures += 1
+        if self._consecutive_read_failures % 10 == 1:
+            logger.warning(
+                "KV read path failing: %d consecutive failures "
+                "(reads degrade to cache miss; writes stay enabled)",
+                self._consecutive_read_failures,
+            )
+        if self._consecutive_read_failures >= self._failure_threshold:
+            self._mark_read_unhealthy(
+                f"{reason} ({self._consecutive_read_failures} "
+                "consecutive read failures)"
+            )
+
+    def _record_pynds_success(self) -> None:
+        if self._consecutive_failures > 0:
+            self._consecutive_failures = 0
+        if self._consecutive_read_failures > 0:
+            self._consecutive_read_failures = 0
+        if not self._healthy or not self._read_healthy:
+            self._mark_healthy()
+
+    def _write_allowed(self) -> bool:
+        """Return True when a write should be attempted.
+
+        Healthy: always allowed.  Unhealthy: fail fast, but let one
+        write through every ``_unhealthy_probe_interval`` seconds as a
+        probe — a successful probe flips the backend back to healthy
+        via ``_record_pynds_success``.  The lock ensures at most one
+        probe per interval even with concurrent put workers.
+        """
+        if self._healthy:
+            return True
+        now = time.monotonic()
+        with self._probe_lock:
+            if now - self._last_write_probe < self._unhealthy_probe_interval:
+                return False
+            self._last_write_probe = now
+            return True
+
+    def _read_allowed(self) -> bool:
+        """Return True when a lookup (contains) should be attempted.
+
+        Mirrors ``_write_allowed`` for the read breaker: while the read
+        path is unhealthy, lookups short-circuit to miss, with one probe
+        allowed per ``_unhealthy_probe_interval`` seconds for recovery.
+        """
+        if self._read_healthy:
+            return True
+        now = time.monotonic()
+        with self._probe_lock:
+            if now - self._last_read_probe < self._unhealthy_probe_interval:
+                return False
+            self._last_read_probe = now
+            return True
+
+    def _batch_get_with_retry(
+        self,
+        block_ids: list,
+        buffers: list,
+        offsets: list,
+        lengths: list,
+        nsids: list,
+    ) -> int:
+        """batchGet with bounded retry (exponential backoff + jitter).
+
+        The NDS box rejects read bursts under flow control (seen when
+        all TP ranks of an MLA model read the same rank-replicated key
+        space at once), and such rejections are usually transient.
+        Buffers are fully overwritten by a successful retry, so reusing
+        them is safe.  Returns 0 on success, or the last non-zero return
+        code after all attempts are exhausted.
+        """
+        # Third Party
+        import pynds_kv
+
+        t0 = time.monotonic()
+        ret = -1
+        attempts = 0
+        for attempt in range(self._get_retry_count):
+            attempts = attempt + 1
+            ret = self._call_pynds_with_timeout(
+                pynds_kv.batchGet, block_ids, buffers, offsets, lengths, nsids
+            )
+            if ret == 0:
+                if attempt > 0:
+                    logger.info(
+                        "pynds_kv.batchGet succeeded on retry attempt %d/%d",
+                        attempt + 1,
+                        self._get_retry_count,
+                    )
+                break
+            if attempt + 1 < self._get_retry_count:
+                delay = self._get_retry_backoff * (2**attempt)
+                time.sleep(delay + random.uniform(0, delay))
+        if _kv_debug():
+            io_dur = time.monotonic() - t0
+            nbytes = sum(len(b) for b in buffers)
+            logger.info(
+                "kv_get nsid=%d keys=%d total_bytes=%d io=%.3fs "
+                "bw=%.1fMB/s attempts=%d first_block_id=%d "
+                "last_block_id=%d ret=%d",
+                nsids[0] if nsids else -1,
+                len(block_ids),
+                nbytes,
+                io_dur,
+                nbytes / io_dur / 1e6 if io_dur > 0 else 0.0,
+                attempts,
+                block_ids[0] if block_ids else -1,
+                block_ids[-1] if block_ids else -1,
+                ret,
+            )
+        return ret
+
+    def _rotate_for_rank(self, items: list) -> list:
+        """Rotate read order by a rank-derived shift.
+
+        MLA latent KV is rank-replicated, so every TP rank reads the
+        same block_ids and ranks tend to issue identical batchGet bursts
+        simultaneously; the NDS box flow-controls many concurrent
+        requests for the same block.  Rotating each rank's read order
+        makes concurrent ranks start at different blocks.  The caller's
+        result mapping is index-based and therefore unaffected.
+        """
+        n = len(items)
+        if n <= 1 or self._world_size <= 1:
+            return items
+        shift = ((n * self._worker_id) // self._world_size) % n
+        if shift == 0:
+            return items
+        return items[shift:] + items[:shift]
+
+    def _is_exists_logged(self, block_ids: list) -> int:
+        """is_exists with timeout wrapper + per-call debug log.
+
+        Centralizes the pynds_kv.is_exists call so every existence probe
+        (contains / batched_contains / disk-meta recovery / SSD restore)
+        gets the same ``kv_exists`` debug line when LMCACHE_KV_DEBUG_LOG
+        is set.
+        """
+        # Third Party
+        import pynds_kv
+
+        t0 = time.monotonic()
+        ret = self._call_pynds_with_timeout(pynds_kv.is_exists, block_ids, self.nsid)
+        if _kv_debug():
+            logger.info(
+                "kv_exists nsid=%d keys=%d first_block_id=%d "
+                "last_block_id=%d ret=%d dur=%.3fs",
+                self.nsid,
+                len(block_ids),
+                block_ids[0] if block_ids else -1,
+                block_ids[-1] if block_ids else -1,
+                ret,
+                time.monotonic() - t0,
+            )
+        return ret
+
+    def _make_disk_meta(self, key: CacheEngineKey) -> DiskCacheMetadata:
+        """Build DiskCacheMetadata on-the-fly from LMCacheMetadata.
+
+        Shape/dtype/fmt are model-intrinsic and can be derived from the
+        engine metadata without per-chunk .meta files.  The size is the
+        full-chunk byte count; partial chunks over-account slightly but
+        this only affects eviction timing, not correctness.
+        """
+        md = self._lmc_metadata
+        shapes = md.get_shapes(self._chunk_size) if md is not None else None
+        dtypes = md.get_dtypes() if md is not None else None
+        size = 0
+        if shapes and dtypes:
+            for s, d in zip(shapes, dtypes, strict=False):
+                size += s.numel() * d.itemsize
+        return DiskCacheMetadata(
+            "",
+            size,
+            shapes[0] if shapes else None,
+            dtypes[0] if dtypes else None,
+            None,
+            self._kv_fmt,
+            0,
+            shapes=shapes,
+            dtypes=dtypes,
+        )
+
+    def _probe_key(self, key: CacheEngineKey) -> Optional[DiskCacheMetadata]:
+        """Probe the KV box for a single key via is_exists.
+
+        Returns a freshly constructed DiskCacheMetadata if the key exists,
+        None otherwise.  Does NOT touch self.dict or kv_lock.
+        """
+        block_id = self._encode_block_id(key)
+        exists = self._is_exists_logged([block_id])
+        if exists == 1:
+            self._record_pynds_success()
+            return self._make_disk_meta(key)
+        if exists < 0:
+            self._record_read_failure("is_exists timeout/error")
+        return None
+
+    def _probe_batched(
+        self, keys: List[CacheEngineKey], pin: bool = False
+    ) -> int:
+        """Probe the KV box for a prefix of keys via batched is_exists.
+
+        Recovers hits into self.dict.  Must be called while holding kv_lock.
+        """
+        if not keys:
+            return 0
+        block_ids = [self._encode_block_id(k) for k in keys]
+        exists = self._is_exists_logged(block_ids)
+        if exists < 0:
+            self._record_read_failure("is_exists (batched) timeout/error")
+            return 0
+        recovered = 0
+        for i in range(exists):
+            key = keys[i]
+            disk_meta = self._make_disk_meta(key)
+            self.dict[key] = disk_meta
+            if pin:
+                self.dict[key].pin()
+                self.keys_in_request.append(key)
+            recovered += 1
+        return recovered
+
+    def contains(self, key: CacheEngineKey, pin: bool = False) -> bool:
+        if not self._read_allowed():
+            return False
+        with self.kv_lock:
+            if key in self.dict:
+                # The local dict may be stale after a KV box disconnect.
+                # Verify the key is still reachable before claiming a hit.
+                # Third Party
+                import pynds_kv
+
+                block_id = self._encode_block_id(key)
+                exists = self._is_exists_logged([block_id])
+                if exists <= 0:
+                    self._record_read_failure(
+                        "is_exists verification failed in contains"
+                    )
+                    return False
+                self._record_pynds_success()
+                if pin:
+                    self.dict[key].pin()
+                    self.keys_in_request.append(key)
+                return True
+
+            # Dict miss: probe the KV box directly via is_exists.
+            disk_meta = self._probe_key(key)
+            if disk_meta is not None:
+                self.dict[key] = disk_meta
+                if pin:
+                    self.dict[key].pin()
+                    self.keys_in_request.append(key)
+                return True
+
+            return False
+
+    def batched_contains(self, keys: List[CacheEngineKey], pin: bool = False) -> int:
+        if not self._read_allowed():
+            return 0
+        hit_chunks = 0
+        with self.kv_lock:
+            for key in keys:
+                if key not in self.dict:
+                    break
+                if pin:
+                    self.dict[key].pin()
+                    self.keys_in_request.append(key)
+                hit_chunks += 1
+
+            if hit_chunks > 0:
+                # The local dict may be stale after a KV box disconnect.
+                # Verify the last hit key is still reachable before claiming
+                # the prefix hit.
+                # Third Party
+                import pynds_kv
+
+                last_key = keys[hit_chunks - 1]
+                block_id = self._encode_block_id(last_key)
+                exists = self._is_exists_logged([block_id])
+                if exists <= 0:
+                    self._record_read_failure(
+                        "is_exists verification failed in batched_contains"
+                    )
+                    return 0
+                self._record_pynds_success()
+
+            # Local dict prefix broken, probe KV box for remaining keys
+            remaining = keys[hit_chunks:]
+            if remaining:
+                recovered = self._probe_batched(remaining, pin=pin)
+                hit_chunks += recovered
+
+        return hit_chunks
+
+    def touch_cache(self):
+        # flip the order of the keys in the request
+        with self.kv_lock:
+            for key in reversed(self.keys_in_request):
+                self.cache_policy.update_on_hit(key, self.dict)
+            self.keys_in_request = []
+
+    def exists_in_put_tasks(self, key: CacheEngineKey) -> bool:
+        return self.kv_worker.exists_in_put_tasks(key)
+
+    def pin(self, key: CacheEngineKey) -> bool:
+        with self.kv_lock:
+            if key in self.dict:
+                self.dict[key].pin()
+                return True
+            return False
+
+    def unpin(self, key: CacheEngineKey) -> bool:
+        with self.kv_lock:
+            if key in self.dict:
+                self.dict[key].unpin()
+                return True
+            return False
+
+    def remove(self, key: CacheEngineKey, force: bool = True) -> bool:
+        if force:
+            self.kv_lock.acquire()
+
+        meta = self.dict.pop(key, None)
+        if meta is None:
+            if force:
+                self.kv_lock.release()
+            return False
+
+        size = meta.size
+        self.usage -= size
+        self.stats_monitor.update_local_storage_usage(self.usage)
+
+        if force:
+            self.current_cache_size -= size
+            self.cache_policy.update_on_force_evict(key)
+            self.kv_lock.release()
+
+        # Push kv evict msg with batching
+        if self.batched_msg_sender is not None:
+            self.batched_msg_sender.add_kv_op(
+                op_type=OpType.EVICT,
+                key=key.chunk_hash,
+            )
+
+        return True
+
+    def batched_remove(self, keys: list[CacheEngineKey], force: bool = True) -> int:
+        num_removed = 0
+        for key in keys:
+            num_removed += self.remove(key, force=force)
+        return num_removed
+
+    def insert_key(
+        self,
+        key: CacheEngineKey,
+        size: int,
+        shape: torch.Size,
+        dtype: torch.dtype,
+        fmt: MemoryFormat,
+        cached_positions: Optional[torch.Tensor] = None,
+        shapes: Optional[list] = None,
+        dtypes: Optional[list] = None,
+    ) -> None:
+        has_stored = False
+        with self.kv_lock:
+            if key in self.dict:
+                self.cache_policy.update_on_hit(key, self.dict)
+                has_stored = True
+            else:
+                self.dict[key] = DiskCacheMetadata(
+                    "",
+                    size,
+                    shape,
+                    dtype,
+                    cached_positions,
+                    fmt,
+                    0,
+                    shapes=shapes,
+                    dtypes=dtypes,
+                )
+
+        # Push kv admit msg with batching
+        if self.batched_msg_sender is not None and not has_stored:
+            self.batched_msg_sender.add_kv_op(
+                op_type=OpType.ADMIT,
+                key=key.chunk_hash,
+            )
+
+    def submit_put_task(
+        self,
+        key: CacheEngineKey,
+        memory_obj: MemoryObj,
+        on_complete_callback: Optional[Callable[[CacheEngineKey], None]] = None,
+    ):
+        # NOTE: use raw_tensor instead of the tensor property: for
+        # multi-KV-group MemoryObjs (e.g. GLM-5 DSA full-attn + indexer
+        # packed in one blob) the single-shape `tensor` view raises.
+        assert memory_obj.raw_tensor is not None
+
+        # skip repeated save
+        if self.exists_in_put_tasks(key):
+            logger.debug(f"Put task for {key} is already in progress.")
+            return None
+
+        self.kv_worker.insert_put_task(key)
+
+        # Evict until we have enough space.
+        # Account in the actual bytes about to be written
+        # (len(byte_array) == logical get_size()), not
+        # get_physical_size(): phy_size is alignment-padded by the CPU
+        # allocator and drifts from the real on-wire footprint (notably
+        # for multi-KV-group MLA/DSA blobs), which breaks eviction
+        # accounting. Mirrors the approach of upstream PR #2951.
+        required_size = len(memory_obj.byte_array)
+        all_evict_keys = []
+        evict_success = True
+        with self.kv_lock:
+            while self.current_cache_size + required_size > self.max_cache_size:
+                evict_keys = self.cache_policy.get_evict_candidates(
+                    self.dict, num_candidates=1
+                )
+                if not evict_keys:
+                    logger.warning(
+                        "No eviction candidates found. KV storage space under pressure."
+                    )
+                    evict_success = False
+                    break
+                for evict_key in evict_keys:
+                    self.current_cache_size -= self.dict[evict_key].size
+                self.batched_remove(evict_keys, force=False)
+                all_evict_keys.extend(evict_keys)
+            if evict_success:
+                self.current_cache_size += required_size
+                self.cache_policy.update_on_put(key)
+
+        if not evict_success:
+            return None
+
+        memory_obj.ref_count_up()
+
+        asyncio.run_coroutine_threadsafe(
+            self.kv_worker.submit_task(
+                "put",
+                self._save_to_kv,
+                key=key,
+                memory_obj=memory_obj,
+                on_complete_callback=on_complete_callback,
+            ),
+            self.loop,
+        )
+
+    def _save_to_kv(
+        self,
+        key: CacheEngineKey,
+        memory_obj: MemoryObj,
+        on_complete_callback: Optional[Callable[[CacheEngineKey], None]] = None,
+    ) -> None:
+        # Third Party
+        import pynds_kv
+
+        self._ensure_nds_initialized()
+
+        # Write breaker: fail fast while the KV box is known-unhealthy
+        # (one probe per interval is let through for recovery).  Roll
+        # back the cache-size reservation made in submit_put_task.
+        if not self._write_allowed():
+            logger.info(
+                "put short-circuited (KV backend unhealthy), key=%s skipped", key
+            )
+            with self.kv_lock:
+                self.current_cache_size -= len(memory_obj.byte_array)
+            memory_obj.ref_count_down()
+            self.kv_worker.remove_put_task(key)
+            if on_complete_callback is not None:
+                try:
+                    on_complete_callback(key)
+                except Exception as e:
+                    logger.warning(f"on_complete_callback failed for key {key}: {e}")
+            return
+
+        buffer = memory_obj.byte_array
+        size = len(buffer)
+        self.usage += size
+        self.stats_monitor.update_local_storage_usage(self.usage)
+
+        chunk_hash_uint64 = self._encode_block_id(key)
