      "targets": [
        {
          "expr": "max(ucm:drampool_buffer_pool_usage_ratio{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
