+class EventPool:
+
+    def __init__(self, max_size, num_layers, is_prefill=False):
+        self.max_size = max_size
+        self.free_events = Queue()
+        self.is_prefill = is_prefill
+        if is_prefill:
+            self.layer_events = [get_module().Event() for _ in range(num_layers)]
+            for _event in self.layer_events:
+                _event.record()
+        for _ in range(num_layers):
+            _event = get_module().Event()
+            _event.record()
+            self.free_events.put(_event)
+        self._lock = threading.Lock()
+        logger.debug(f"EventPool create {self.free_events.qsize()} event, max_size: {max_size}, num_layers:{num_layers}")
+
+    def acquire(self):
+        try:
+            return self.free_events.get_nowait()
+        except Empty:
+            logger.warning(f"Pool empty, creating new event for acquire!")
+            return get_module().Event()
+
+    def acquire_layer_event(self, layer_id):
+        assert self.is_prefill, "Only support acquire_layer_event in prefill mode"
+        return self.layer_events[layer_id]
+
+    def acquire_many(self, count):
+        events = []
+        for _ in range(count):
+            try:
+                events.append(self.free_events.get_nowait())
+            except Empty:
+                events.append(get_module().Event())
+        return events
+
+    def release(self, event, need_sync, need_recycle):
+        if need_sync:
+            try:
+                # if not event.query():
+                event.synchronize() # 必须要sync等数据读/写完成
+            except Exception as e:
+                logger.error(f"event synchronize failed, err: {e}")
+        if need_recycle:
+            if self.free_events.qsize() < self.max_size:
+                self.free_events.put_nowait(event)
+            else:
+                del event
+
+    def clean(self):
+        while not self.free_events.empty():
+            self.free_events.get()
+
