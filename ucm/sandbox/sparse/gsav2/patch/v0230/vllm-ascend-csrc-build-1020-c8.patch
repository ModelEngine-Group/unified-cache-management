+    TORCH_CHECK(swap_topk.device().type() == c10::DeviceType::PrivateUse1, "swap_topk must be on NPU");
+    TORCH_CHECK(prefetch_index.device().type() == c10::DeviceType::PrivateUse1, "prefetch_index must be on NPU");
+    TORCH_CHECK(swap_index.device().type() == c10::DeviceType::PrivateUse1, "swap_index must be on NPU");
+    TORCH_CHECK(tmp_tensor.device().type() == c10::DeviceType::PrivateUse1, "swap_index must be on NPU");
+
+    TORCH_CHECK(prefetch_index.dtype() == torch::kInt64, "index must be torch.int64");
+    TORCH_CHECK(swap_index.dtype() == torch::kInt64, "index must be torch.int64");
+
+    TORCH_CHECK(topk_indices.dim() == 2, "topk_indices must be 2D");
+    TORCH_CHECK(prefetch_topk.dim() == 2, "prefetch_topk must be 2D");
+    TORCH_CHECK(swap_topk.dim() == 2, "swap_topk must be 2D");
+    TORCH_CHECK(prefetch_index.dim() == 2, "prefetch_index must be 2D");
+    TORCH_CHECK(swap_index.dim() == 2, "swap_index must be 2D");
+
+    TORCH_CHECK(topk_indices.size(1) == prefetch_topk.size(1), "the second dimension of topk_indices and prefetch_topk must be equal");
+    TORCH_CHECK(expand_len >= topk_indices.size(1), "the second dimension of topk_indices must small than expand_len");
+    constexpr int32_t SIZE = 8;
+    constexpr int32_t DIM_0 = 0;
+    constexpr int32_t DIM_1 = 1;
+
+    int64_t dim = 0;
+    int64_t reduce = 0;
+
+    EXEC_NPU_CMD(
+        aclnnGather,
+        topk_indices,
+        dim,
+        prefetch_index,
+        prefetch_topk);
+
+    EXEC_NPU_CMD(
+        aclnnInplaceFillScalar,
+        tmp_tensor,
+        padValue);
+
+    at::Tensor sliced_view = tmp_tensor.slice(0, 0, topk_indices.size(DIM_0))
+                                       .slice(1, 0, topk_indices.size(DIM_1));
+
+    EXEC_NPU_CMD(
+        aclnnInplaceCopy,
+        sliced_view,
+        topk_indices);
+
+    EXEC_NPU_CMD(
+        aclnnInplaceScatter,
+        tmp_tensor,
+        dim,
+        swap_index,
+        swap_topk,
+        reduce);
+    return tmp_tensor.view({tmp_tensor.size(DIM_0), 1, expand_len}).slice(0, 0, topk_indices.size(DIM_0));
+}
