+                hbm_addr_list,
+                storage_offset_list,
+                length_list,
+                output # TODO: this output makes no sense
+            )
+            pass
+        # CPU has already warned
+
+        # logger.error(f"id {id} get ret: {ret}")
+        return ret
+        pass
+
+
+    #@timeit
