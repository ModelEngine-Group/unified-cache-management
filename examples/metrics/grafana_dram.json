      "targets": [
        {
          "expr": "(sum(rate(ucm:dramstore_connect_attempts_total{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}[$__rate_interval]))) or vector(0)",
