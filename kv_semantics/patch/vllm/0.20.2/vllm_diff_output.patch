+
+
+logger = init_logger(__name__)
+
+G_SCHEDULER_AIV_LINK_BUFFER_SIZE = 4096
+
+
+class OdKvStorageConnectorScheduler:
+    def __init__(self, vllm_config: VllmConfig, engine_id: str):
+        # vllm config
+        self._vllm_config: VllmConfig = vllm_config
+        self._engine_id: str = engine_id
+        self._kv_role: str = vllm_config.kv_transfer_config.kv_role
+
+        # dp_rank
+        self._dp_rank = self._vllm_config.parallel_config.data_parallel_index
+        logger.error(f"scheduler dp_rank is {self._dp_rank}")
+
+        # hasher for re
+        self._request_hasher: RequestHasher = RequestHasher(vllm_config, 0)
+
+        # pd related
+        self._pd_resource_tracker: PdDisaggSchedulerResourceTracker = PdDisaggSchedulerResourceTracker()
+        self._pd_resource_tracker.pd_listen_host = self._vllm_config.kv_transfer_config.get_from_extra_config("pd_listen_host", "localhost")
+        self._pd_resource_tracker.pd_listen_port = self._vllm_config.kv_transfer_config.get_from_extra_config("pd_listen_port", 42343)
+
+        # host and port for scheduler worker transmit
+        self._scheduler_host: str = vllm_config.kv_transfer_config.get_from_extra_config("scheduler_host", "localhost")
+        self._scheduler_port: int = vllm_config.kv_transfer_config.get_from_extra_config("scheduler_port", 64127)
+
+        # connect to od kv storage
+        self._npu_interface: XPUStorageInterface = XPUStorageInterface(
+            device_type=None,
+            vllm_config=vllm_config
+        )
+
+        # total model kv cache layers
+        hf_text_config = self._vllm_config.model_config.hf_text_config
+        self._total_num_hidden_layers: int = getattr(hf_text_config, "num_nextn_predict_layers", 0)
+        if self._total_num_hidden_layers == 0:
+            self._total_num_hidden_layers = getattr(hf_text_config, "num_hidden_layers", 0)
+        
+        # token num in one block
+        self._block_size: int = self._vllm_config.cache_config.block_size
+        
+        # prefix cache request meta
+        self._requests_meta: dict[str, RequestMeta] = {}
+
+        # params for get workers' layer update
+        self._ucm_meta: OdKvStorageConnectorMetadata = None
+        self._raw_shm, self._shared_memory = get_shared_mem_resources(
+            SHM_NAME, self._vllm_config.parallel_config.tensor_parallel_size * 8, self._vllm_config.kv_transfer_config.engine_id) # 8 is for int64
+        get_event_pipe(PIPE_PATH + self._vllm_config.kv_transfer_config.engine_id)
+        self._early_reqponse_read_event_fd: int = os.open(PIPE_PATH + self._vllm_config.kv_transfer_config.engine_id, os.O_RDONLY | os.O_NONBLOCK)
+        self._selector: selectors.DefaultSelector = selectors.DefaultSelector()
+
+        # register layer update event
+        self._selector.register(self._early_reqponse_read_event_fd, selectors.EVENT_READ)
+        self._layer_update_listener_queue: TaskQueue = TaskQueue()
+        self._layer_update_listener_queue.start_worker()
+
+        # layer early response signal and data transmit
+        self._dynamo_early_response_raw_shm: SharedMemory = None
+        self._dynamo_early_response_shared_mempory: memoryview = None
+        self._dynamo_early_response_event_fd: int = None
+
+        # device type
+        self._device_type: str = ""
+        if torch.cuda.is_available():
+            self._device_type = "cuda"
+        elif torch.npu.is_available():
+            self._device_type = "npu"
+        else:
+            self._device_type = "cpu"
+
+        # create aiv link for scheduler. used for exist
+        if self._vllm_config.parallel_config.tensor_parallel_size * self._vllm_config.parallel_config.pipeline_parallel_size \
+            * self._vllm_config.parallel_config.data_parallel_size > 1:
+            device = get_module().current_device()
+            self.rdma_link_tensor: torch.Tensor = torch.zeros(G_SCHEDULER_AIV_LINK_BUFFER_SIZE, dtype=torch.int8, device=device)
+            self._npu_interface.xds_init([self.rdma_link_tensor.data_ptr()], [G_SCHEDULER_AIV_LINK_BUFFER_SIZE])
+
+        # mooncake escape
+        self._enable_failure_escape: bool = self._vllm_config.kv_transfer_config.get_from_extra_config("enable_failure_escape", True)
+
+
+    # currently wait for worker signal and send event
+    def _layer_update_listener(self, ready_event: threading.Event, request_early_response_not_send: set):
+        """Background thread for getting new Mooncake handshakes."""
+
+        tp_size = self._vllm_config.parallel_config.tensor_parallel_size
+        notify_num = 0
+
+        path = make_zmq_path("tcp", self._scheduler_host, self._scheduler_port + self._dp_rank)
+        logger.warning(f"layer_update_lastener set up at {path}, except {tp_size} notifications")
+        with zmq_ctx(zmq.ROUTER, path) as sock:
+            while True:
+                """
+                events = self._selector.select(timeout=None)
+                for key, _ in events:
+                    os.read(key.fd, 1)
+                    notify_num += 1
+                """
+                identity, _, metadata_bytes = sock.recv_multipart()
+                notify_num += 1
+                if notify_num < tp_size:
+                    continue
+                else:
+                    notify_num = 0
+                
+                # all tp send signal
+                for req_id in request_early_response_not_send:
+                    # maybe we still should assign
+                    self._send_early_response_to_proxy(req_id=req_id, layer_num=int(self._total_num_hidden_layers * G_BEST_LAYER_RATE))
+                
+                break
+
+                # shared memory is assigned to certain value, so no need to clean
+                # for idx in range(0, tp_size):
+                #     self._shared_memory[idx] = 0
+
+    
+    def _send_early_response_to_proxy(self, req_id: str, layer_num: int) -> None:
+        logger.warning(f"income early response: req_id {req_id}, layer_num {layer_num}")
+        if layer_num < int(self._total_num_hidden_layers * G_BEST_LAYER_RATE):
+            return False
+        logger.error("_send_early_response_to_proxy successfully comes in")
+        
+        od_kv_block_hashes =self._requests_meta[req_id].od_kv_block_hashes
+        od_kv_block_hashes_low, od_kv_block_hashes_high = self._npu_interface.batch_split_key_low_high(od_kv_block_hashes)
+        
+        request = dict(
+            do_remote_prefill=True,
+            do_remote_decode=False,
+            remote_block_hashes=od_kv_block_hashes_low,
+            remote_block_hashes_high=od_kv_block_hashes_high,
+            remote_engine_id=self._engine_id, # not used
+            remote_host=self._pd_resource_tracker.pd_listen_host,
+            remote_port=self._pd_resource_tracker.pd_listen_port,
+            remote_complete_layer_num=layer_num,
+            transfer_id=req_id
+        )
+
+        if self._enable_failure_escape:
+            request["remote_bootstrap_addr"] = make_zmq_path("http", *get_mooncake_bootstrap_addr(self._vllm_config))
+
+        data = pickle.dumps(request)
+        data_len = len(data)
+
+        self._dynamo_early_response_raw_shm.buf[:4] = data_len.to_bytes(4, byteorder='big')
+        self._dynamo_early_response_raw_shm.buf[4:4+data_len] = data
+
+        os.write(self._dynamo_early_response_event_fd,  b'\x01')
+        return True
+
+    
+    def get_num_new_matched_tokens(
+        self,
+        request: "Request",
+        num_computed_tokens: int,
+    ) -> tuple[int, bool]:
+        """
+        Get number of new tokens that can be loaded from the
+        external KV cache beyond the num_computed_tokens.
+        
+        Args:
+            request (Request): the request object.
+            num_computed_tokens (int): the number of locally
+                computed tokens for this request
+
+        Returns:
+            the number of tokens that can be loaded from the 
+            external KV cache beyond what is already computed.
+        """
+        # NOTE: in this debug implementation, we assume that the prompt is
+        # cached_prompt + newly_generated_single_token
+        # Therefore, we use prompt_token_ids[:-1] to determine the folder name
+
+        # NOTE: in current v1 scheduler, the num_computed_tokens is aligned
+        # with the block granularity. And it expects the returned blocks and
+        # num_computed_tokens to also be aligned with the block granularity.
+        # print(f"[get_num_new_matched_tokens], initial num_computed_tokens {num_computed_tokens}")
+
+        params = request.kv_transfer_params
+        logger.debug(
+            "OdKvStorageConnector get_num_new_matched_tokens: "
+            "num_computed_tokens=%s, kv_transfer_params=%s",
+            num_computed_tokens, params)
+        
+        is_pd_prefill = False
+        
+        # first check pd case
+        if params is not None:
+            if params.get("do_remote_decode"):
+                is_pd_prefill = True
+            if params.get("do_remote_prefill"):
+                # Remote prefill: get all prompt blocks from remote.
+                assert num_computed_tokens % self._block_size == 0
+                count = max(len(request.prompt_token_ids) - num_computed_tokens, 1) - 1 # should always keep at least one token to compute
+                external_hit_block_num = round_down(count, self._block_size) // self._block_size
+                # add meta for decode save
+                self._requests_meta[request.request_id] = RequestMeta(
+                    od_kv_block_hashes=self.generate_hash(self._block_size, request),
+                    hbm_hit_block_num=num_computed_tokens // self._block_size, # no actual use since prefill is skipped
+                    total_hit_block_num=(external_hit_block_num + num_computed_tokens) // self._block_size, # no actual use since prefill is skipped
+                    token_processed=len(request.all_token_ids),
+                    all_token_ids=request.all_token_ids,
+                    is_pd_prefill=False,
+                ) 
+                if count > 0:
+                    return count, True
+                else:
+                    return 0, False
+            # when do_remote_prefill=False, it's in pd prefill case, should go prefix cache
+
+        # then prefill prefix cache
+        all_token_ids = list(request.all_token_ids)
+        hbm_hit_block_num = num_computed_tokens // self._block_size
+
+        padding_size = 0
+        if is_pd_prefill:
+            # in this case request meta will onlt use once, and request token id will pad to full block
+            padding_size = (self._block_size - len(request.all_token_ids) % self._block_size) % self._block_size
+            all_token_ids += [0] * padding_size
+
+        nds_block_ids = self.generate_hash_token_ids(self._block_size, all_token_ids)    #该请求所有block的hash
+        external_block_ids = nds_block_ids[hbm_hit_block_num:] if padding_size == 0 else nds_block_ids[hbm_hit_block_num:-1]
+        
+        external_hit_blocks = 0
+        ret, external_hit_blocks = self._npu_interface.is_kv_exist(request.request_id, external_block_ids)
+        
+        total_hit_block_num = hbm_hit_block_num + external_hit_blocks
+
+        external_hit_tokens = external_hit_blocks * self._block_size
+        num_total_hit_tokens = total_hit_block_num * self._block_size
+
+        if num_total_hit_tokens == request.num_tokens:
+            external_hit_tokens -= 1
+        logger.info(f"External Cache Hit! {total_hit_block_num, external_hit_tokens}")
+
+        self._requests_meta[request.request_id] = RequestMeta(
+            od_kv_block_hashes=nds_block_ids,
+            hbm_hit_block_num=hbm_hit_block_num,
+            total_hit_block_num=total_hit_block_num,
+            token_processed=num_total_hit_tokens,
+            all_token_ids=request.all_token_ids,
+            is_pd_prefill=is_pd_prefill,
+        )
+        return external_hit_tokens, False
+    
+    def update_req_meta(self, request_id: str, req_meta: RequestMeta, num_computed_tokens: int):
+        # decode 阶段更新req meta数据，跟踪推理的token个数等
+        nds_block_ids = self.generate_hash_token_ids(
+            self._block_size, req_meta.all_token_ids, len(req_meta.od_kv_block_hashes) * self._block_size)    #该请求所有block的hash
+        req_meta.od_kv_block_hashes.extend(nds_block_ids)
+        req_meta.spec_decode_accepted_token_num = 0
+        if req_meta.token_processed != num_computed_tokens:
+            req_meta.spec_decode_accepted_token_num = num_computed_tokens - req_meta.token_processed
+        req_meta.token_processed = num_computed_tokens
+
+    
+    def update_state_after_alloc(self, request: "Request",
+                                 blocks: "KVCacheBlocks",
+                                 num_external_tokens: int):
+        """
+        Update KVConnector state after block allocation.
+
+        If blocks were allocated, add to _requests_need_load,
+        such that we load the KVs in the next forward pass.
+        """
+        params = request.kv_transfer_params
+        # logger.info(
+            # "OdKvStorageConnector update_state_after_alloc: "
+            # "num_external_tokens=%s, kv_transfer_params=%s",
+            # num_external_tokens, params)
+
+        if params is not None and params.get("do_remote_prefill"):
+            if params.get("remote_block_hashes"):
+                if all(p in params for p in ("remote_host", "remote_port")):
+                    # If remote_blocks and num_external_tokens = 0, we have
+                    # a full prefix cache hit on the D worker. We need to call
+                    # send_notif in _read_blocks to free the memory on the P.
+                    local_block_ids = (blocks.get_unhashed_block_ids()
+                                       if num_external_tokens > 0 else [])
+                    remote_block_hashes = params.get("remote_block_hashes")
+                    if params.get("remote_block_hashes_high"):
+                        remote_block_hashes_high = params.get("remote_block_hashes_high")
+                        remote_block_hashes = [remote_block_hash + (remote_block_hashes_high[idx] << 64)
+                                               for idx, remote_block_hash in enumerate(remote_block_hashes)]
+                    num_local_blocks = len(local_block_ids)
+                    num_remote_blocks = len(remote_block_hashes)
+                    assert num_remote_blocks >= num_local_blocks, "remote block num should be larger than local"
+                    if num_remote_blocks > num_local_blocks:
+                        remote_block_hashes = remote_block_hashes[-num_local_blocks:]
+                    # Get unhashed blocks to pull from remote.
+                    self._pd_resource_tracker.recv_request_resources[request.request_id] = PdDisaggSchedulerReqResource(
+                        local_complete_layer_num=0,
+                        remote_complete_layer_num=params.get("remote_complete_layer_num"),
+                        remote_host=params.get("remote_host"),
+                        remote_port=params.get("remote_port"),
+                        block_ids=local_block_ids,
+                        block_hashes=remote_block_hashes,
+                        remote_engine_id=params.get("remote_engine_id"),
+                        create_time=time.perf_counter(),
+                        executed=False,
+                        transfer_id=params.get("transfer_id", ""),
+                        remote_bootstrap_addr=params.get("remote_bootstrap_addr", ""),
+                    )
+                else:
+                    logger.warning(
+                        "Got invalid KVTransferParams: %s. This "
+                        "request will not utilize KVTransfer", params)
+            else:
+                assert num_external_tokens == 0
+            # Only trigger 1 KV transfer per request.
+            params["do_remote_prefill"] = False
+        
+        if params is not None and params.get("do_remote_decode"):
+            if self._dynamo_early_response_event_fd is None:
+                # prepare dynamo data transfer
+                self.dynamo_early_response_shm_path = params.get("dynamo_early_response_shm_path")
+                self.dynamo_early_response_shm_size = params.get("dynamo_early_response_shm_size")
+                self.dynamo_early_response_pipe_path = params.get("dynamo_early_response_pipe_path")
+
+                self._dynamo_early_response_raw_shm, self._dynamo_early_response_shared_mempory = \
+                    get_shared_mem_resources(self.dynamo_early_response_shm_path, self.dynamo_early_response_shm_size, "")
+                self._dynamo_early_response_event_fd = os.open(self.dynamo_early_response_pipe_path, os.O_RDWR | os.O_NONBLOCK)
+
+            # prepare need send request meta
+            self._pd_resource_tracker.send_request_resources[request.request_id] = PdDisaggSchedulerReqResource(
+                local_complete_layer_num=0,
+                remote_complete_layer_num=0,
+                remote_host='',
+                remote_port=0,
+                block_ids=0,
+                block_hashes=[],
+                remote_engine_id=0,
+                create_time=time.perf_counter(),
+                executed=False,
+                transfer_id=params.get("transfer_id", ""),
+                remote_bootstrap_addr=params.get("remote_bootstrap_addr", "")
+            )
+
+    
+    def _generate_dispatch_meta(
+        self,
+        req_meta: RequestMeta,
+        new_tokens: int,
+        vllm_block_ids: list[int],
+        need_load: bool = True,
+    ) -> PrefixMeta:
+        """
+        Request Blocks layout:
+        ----------------------------------------------------------------------------------------------------
+        | local_computed_block(HBM hit) | external_computed_block(external hit) | new_block(need to dump)  |
+        ----------------------------------------------------------------------------------------------------
+        |      hbm_hit_block_num        |                 LOAD                  |     new_blocks_num       |
+        ----------------------------------------------------------------------------------------------------
+        |                              total_hit_block_num                      |
+        ----------------------------------------------------------------------------------------------------
+        |                                         scheduled_block_num                                      |
+        """
+        # print(new_tokens, vllm_block_ids)
+        hbm_hit_block_num = req_meta.hbm_hit_block_num
+        total_hit_block_num = req_meta.total_hit_block_num
+        od_kv_block_hashes = req_meta.od_kv_block_hashes
+        # print(vllm_block_ids)
+        
+        # jyf edit
+        if need_load:
+            # here need load is resume from resumed_from_preemption
+            req_meta.vllm_block_ids = vllm_block_ids[:]
+        else:
+            req_meta.vllm_block_ids.extend(vllm_block_ids)
+
+        load_od_kv_block_hashes, load_vllm_block_ids = [], []
+        dump_od_kv_block_hashes, dump_vllm_block_ids = [], []
+        if need_load:
+            load_od_kv_block_hashes = od_kv_block_hashes[hbm_hit_block_num:total_hit_block_num]
+            load_vllm_block_ids = vllm_block_ids[hbm_hit_block_num:total_hit_block_num]
+
+        if req_meta.token_processed < req_meta.num_token_ids:
+            start_idx = (req_meta.token_processed - req_meta.spec_decode_accepted_token_num) // self._block_size
+            if not req_meta.is_pd_prefill:
+                end_idx = (req_meta.token_processed + new_tokens) // self._block_size
+            else:
+                end_idx = len(req_meta.vllm_block_ids)
+            dump_od_kv_block_hashes = od_kv_block_hashes[start_idx:end_idx]
+            dump_vllm_block_ids = req_meta.vllm_block_ids[start_idx:end_idx]
+            req_meta.token_processed += new_tokens
+
+        is_last_chunk = False
+        if self._kv_role == "kv_producer":
+            if req_meta.token_processed == req_meta.num_token_ids:
+                is_last_chunk = True
+
+        return PrefixMeta(
+            (load_od_kv_block_hashes, load_vllm_block_ids),
+            (dump_od_kv_block_hashes, dump_vllm_block_ids),
+            (od_kv_block_hashes, req_meta.vllm_block_ids),
+            is_last_chunk=is_last_chunk
+        )
+
+
+    def build_pd_disagg_connector_meta(
+        self,
+        scheduler_output: SchedulerOutput,
+    ) -> dict[str, PdDisaggReqMeta]:
+        meta = {}
+
+        # Loop through scheduled reqs and convert to ReqMeta.
+        for req_id, req_resource in self._pd_resource_tracker.recv_request_resources.items():
+            if req_resource.executed:
+                continue
+            req_resource.executed = True
+            meta[req_id] = PdDisaggReqMeta(
+                local_block_ids=req_resource.block_ids,
+                remote_block_hashes=req_resource.block_hashes,
+                remote_engine_id=req_resource.remote_engine_id,
+                remote_host=req_resource.remote_host,
+                remote_port=req_resource.remote_port,
+                remote_complete_layer_num=req_resource.remote_complete_layer_num,
+                transfer_id=req_resource.transfer_id,
+                remote_bootstrap_addr=req_resource.remote_bootstrap_addr
+            )
+        return meta
+
+
+    def build_connector_meta(
+        self,
+        scheduler_output: SchedulerOutput,
+    ) -> KVConnectorMetadata:
+        # decode pd case
+        pd_disagg_meta = self.build_pd_disagg_connector_meta(scheduler_output)
+
+        # prefill prefix cache case
+        # print("build_connector_meta Scheduler output:", scheduler_output.num_scheduled_tokens)
+        requests_dispatch_meta = {}
+        for request in scheduler_output.scheduled_new_reqs:
+            request_id, vllm_block_ids = request.req_id, request.block_ids[0]
+            req_meta = self._requests_meta.get(request_id)
+            if req_meta:
+                requests_dispatch_meta[request_id] = self._generate_dispatch_meta(
+                    req_meta,
+                    scheduler_output.num_scheduled_tokens[request_id],
+                    vllm_block_ids,
+                )
+
+        scheduled_cached_reqs = scheduler_output.scheduled_cached_reqs
+        if not isinstance(scheduled_cached_reqs, list):
+            # >= 0.9.2
+            for i, request_id in enumerate(scheduled_cached_reqs.req_ids):
+                req_meta = self._requests_meta.get(request_id)
+                if req_meta:
+                    new_block_ids = []
+                    if scheduled_cached_reqs.new_block_ids[i] != None:
+                        new_block_ids = scheduled_cached_reqs.new_block_ids[i][0]
+                    self.update_req_meta(request_id, self._requests_meta[request_id], scheduled_cached_reqs.num_computed_tokens[i])
+                    requests_dispatch_meta[request_id] = self._generate_dispatch_meta(
+                        req_meta,
+                        # jyf edit
+                        scheduler_output.num_scheduled_tokens[request_id] - scheduler_output.scheduled_spec_decode_tokens.get(request_id, 0),
+                        new_block_ids,
+                        request_id in scheduler_output.scheduled_cached_reqs.resumed_req_ids,
+                    )
+
+        else:
+            for request in scheduled_cached_reqs:
+                request_id = request.req_id
+                req_meta = self._requests_meta.get(request_id)
+                if req_meta:
+                    self.update_req_meta(request_id, self._requests_meta[request_id], request.num_computed_tokens)
+                    requests_dispatch_meta[request_id] = self._generate_dispatch_meta(
+                        req_meta,
+                        # jyf edit
+                        scheduler_output.num_scheduled_tokens[request_id] - scheduler_output.scheduled_spec_decode_tokens.get(request_id, 0),
+                        request.new_block_ids[0],
+                        request.resumed_from_preemption,
+                    )
+        
+        for request_id in scheduler_output.finished_req_ids:
+            self._requests_meta.pop(request_id, None)
+        self._ucm_meta = OdKvStorageConnectorMetadata(request_meta=requests_dispatch_meta, pd_disagg_request_meta=pd_disagg_meta,
+            scheduler_host=self._scheduler_host, scheduler_port=self._scheduler_port)
+
+        request_early_response_not_send = set()
+        for req_id in self._ucm_meta.request_meta:
+            if self._ucm_meta.request_meta[req_id].is_last_chunk:
+                if self._requests_meta[req_id].is_pd_prefill:
+                    request_early_response_not_send.add(req_id)
+        if len(request_early_response_not_send) > 0:
+            self._layer_update_listener_queue.enqueue(self._layer_update_listener, None, request_early_response_not_send)
+        #if self._ucm_meta.pd_disagg_request_meta or self._ucm_meta.pd_disagg_request_meta:
+        # logger.info(f"{self._ucm_meta=}")
+        return self._ucm_meta
+
+
+    def update_connector_output(self, connector_output: KVConnectorOutput) -> set[str]:
+        # pd prefill case
+        self._layer_update_listener_queue.join()
+
+        # pd decode case
+        finished_sending = connector_output.finished_sending or set()
+        finished_recving = connector_output.finished_recving or set()
+
+        for req_id in finished_recving:
+            self._pd_resource_tracker.recv_request_resources.pop(req_id, None)
+        
+        for req_id in finished_sending:
+            self._pd_resource_tracker.send_request_resources.pop(req_id, None)
+        return
+
+
+    # just for original dynamo
+    def request_finished(
+        self,
+        request: "Request",
+        block_ids: list[int],
+    ) -> tuple[bool, Optional[dict[str, Any]]]:
+        """
+        Once a request is finished, determine whether request blocks
+        should be freed now or will be sent asynchronously and freed later.
+        """
+
+        params = request.kv_transfer_params
+        logger.debug(
+            "OdKvStorageConnector request_finished, request_status=%s, "
+            "kv_transfer_params=%s", request.status, params)
+
+        if (params is None or not params.get("do_remote_decode")
+                or request.status != RequestStatus.FINISHED_LENGTH_CAPPED):
+            return False, None
+
+        # Get computed blocks.
+        all_full = request.num_computed_tokens % self._block_size == 0
+
+        req_id = request.request_id
+
+        od_kv_block_hashes = self._requests_meta[req_id].od_kv_block_hashes
+        od_kv_block_hashes_low, od_kv_block_hashes_high = self._npu_interface.batch_split_key_low_high(od_kv_block_hashes)
+        computed_block_ids = block_ids if all_full else block_ids[:-1]
+
+        # If prompt < block_size, no xfer so free blocks immediately.
+        delay_free_blocks = True
+
+        kv_transfer_params = dict(
+            do_remote_prefill=True,
+            do_remote_decode=False,
+            remote_block_hashes=od_kv_block_hashes_low,
+            remote_block_hashes_high=od_kv_block_hashes_high,
+            remote_engine_id=self._vllm_config.kv_transfer_config.engine_id, # not used
+            remote_host=self._pd_resource_tracker.pd_listen_host,
+            remote_port=self._pd_resource_tracker.pd_listen_port,
+            remote_complete_layer_num=self._total_num_hidden_layers,
+            transfer_id=req_id
+        )
+
+        if self._enable_failure_escape:
+            kv_transfer_params["remote_bootstrap_addr"] = make_zmq_path("http", *get_mooncake_bootstrap_addr(self._vllm_config))
+
+        return delay_free_blocks, kv_transfer_params
+
