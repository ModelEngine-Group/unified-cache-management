+class PrefetchStatus(Enum):
+    """Lifecycle of a request's L3 (storage backend) prefetch.
+
+    NONE:    prefetch has never been attempted for this request.
+    ISSUED:  a prefetch operation is in flight (tracked in
+             tree_cache.ongoing_prefetch).
