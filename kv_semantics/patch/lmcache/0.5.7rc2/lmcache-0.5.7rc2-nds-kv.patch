+NDS (KV disk frame) L2 adapter for the LMCache MP server.
+
+Wraps pynds_kv (batchPut/batchGet/is_exists) behind the async
+L2AdapterInterface. Uses 80-bit block keys: key_high is 0 for business
+keys (0xFFFF reserved for warmup), key_low is a SHA-256 truncation of
+(chunk_hash + model_name + cache_salt + kv_rank + object_group_id).
+"""
+
+# Future
+from __future__ import annotations
+
+# Standard
+from concurrent.futures import ThreadPoolExecutor
+from concurrent.futures import TimeoutError as FuturesTimeoutError
+from typing import TYPE_CHECKING, Optional
+import asyncio
+import hashlib
+import os
+import threading
+import time
+
+if TYPE_CHECKING:
+    # First Party
+    from lmcache.lmcache_native import Bitmap
+    from lmcache.v1.distributed.api import ObjectKey
+    from lmcache.v1.distributed.internal_api import L1MemoryDesc
+
+# First Party
+from lmcache.logging import init_logger
+from lmcache.v1.distributed.api import MemoryResidency, MemorySegment, MemoryTags
+from lmcache.v1.distributed.internal_api import L2StoreResult
+from lmcache.v1.distributed.l2_adapters.base import L2AdapterInterface, L2TaskId
+from lmcache.v1.distributed.l2_adapters.config import (
+    L2AdapterConfigBase,
+    register_l2_adapter_type,
+)
+from lmcache.v1.distributed.l2_adapters.factory import (
+    register_l2_adapter_factory,
+)
+from lmcache.v1.platform import create_event_notifier
+
+logger = init_logger(__name__)
+
+
+# Config class
+
+
+class NDSL2AdapterConfig(L2AdapterConfigBase):
+    """Config for the NDS-backed L2 adapter.
+
+    Fields:
+        nsid: NDS namespace ID (required, positive int).
+        nds_config_path: Path to nds_wrapper.conf (required, non-empty str).
+        max_size_gb: NDS capacity in GB for eviction reporting.
+            0 means no global eviction (default).
+        num_workers: Thread pool size for asyncio.to_thread calls (default 4).
+        init_timeout_s: NDS init timeout in seconds (default 30).
+        warmup_on_init: Run warmup write smoke test after init (default
+            True; write-only, no read-back -- the box does not support
+            overwrite).
+        warmup_keys: Number of warmup keys, 1 MiB each (default 16).
+        eager_init_on_start: Run NDS init (+warmup) eagerly in a daemon
+            thread when the adapter is created, instead of waiting for the
+            first IO task (default True).  Server startup is never blocked;
+            failures degrade to the usual unhealthy/lazy-retry path.
+        failure_threshold: Consecutive failures before marking unhealthy
+            (default 3).
+        get_retry_count: Number of batchGet retries on failure (default 0,
+            no retry).
+        get_retry_backoff: Seconds to sleep between get retries (default 0.2).
+        io_timeout_s: Timeout in seconds for a single batchPut/batchGet
+            call (default 60; 0 disables).  Must exceed the reconnect-window
+            slow-failure latency (~8.5s observed for RNR/transport retry
+            during a KV-box outage) so it only trips on genuine hangs.
+            On timeout the worker thread is abandoned (leaked) and the
+            adapter is marked unhealthy immediately.
+        unhealthy_probe_interval: Seconds between background health probes
+            when unhealthy (default 15). Matched to the NDS client
+            auto-reconnect window: the C layer reconnects on its own
+            (sleep 5s + TCP/RDMA re-handshake + slow-failure drain, ~10-15s
+            observed), so a probe cadence in that range recovers the
+            adapter shortly after the box is back without hammering a
+            half-dead client. 0 disables probing, which latches unhealthy
+            forever: all IO fail-fast while unhealthy, so no success can
+            ever be recorded and the adapter never recovers on its own.
+        nds_buffer_size_gb: Size of the dedicated NDS staging buffer in GB.
+            This buffer is mmap'd + mlock'd and registered with NDS for
+            RDMA. Store/load operations copy data through this buffer in
+            chunks that fit the buffer, so tasks larger than the buffer are
+            split automatically; a single object must still fit
+            (default 2).
+        use_l1_zero_copy: Register the L1 buffer itself with NDS
+            (init_multi: MR0 = L1, MR1 = staging) so store/load IO reads
+            and writes MemoryObj memory directly, skipping the staging
+            memcpy entirely.  Objects outside the registered L1 range
+            (e.g. tail of an aligned-down region) fall back to the staging
+            copy.  If init_multi with the L1 buffer fails, init fails with
+            a clear error -- set this to False to force the staging-copy
+            path (default True).
+    """
+
+    def __init__(
+        self,
+        nsid: int,
+        nds_config_path: str,
+        max_size_gb: float = 0,
+        num_workers: int = 4,
+        init_timeout_s: float = 30,
+        warmup_on_init: bool = True,
+        warmup_keys: int = 16,
+        eager_init_on_start: bool = True,
+        failure_threshold: int = 3,
+        get_retry_count: int = 0,
+        get_retry_backoff: float = 0.2,
+        io_timeout_s: float = 60,
+        unhealthy_probe_interval: float = 15,
+        nds_buffer_size_gb: float = 2,
+        use_l1_zero_copy: bool = True,
+    ):
+        self.nsid = nsid
+        self.nds_config_path = nds_config_path
+        self.max_size_gb = max_size_gb
+        self.num_workers = num_workers
+        self.init_timeout_s = init_timeout_s
+        self.warmup_on_init = warmup_on_init
+        self.warmup_keys = warmup_keys
+        self.eager_init_on_start = eager_init_on_start
+        self.failure_threshold = failure_threshold
+        self.get_retry_count = get_retry_count
+        self.get_retry_backoff = get_retry_backoff
+        self.io_timeout_s = io_timeout_s
+        self.unhealthy_probe_interval = unhealthy_probe_interval
+        self.nds_buffer_size_gb = nds_buffer_size_gb
+        self.use_l1_zero_copy = use_l1_zero_copy
+
+    @classmethod
+    def from_dict(cls, d: dict) -> "NDSL2AdapterConfig":
+        nsid = d.get("nsid")
+        if not isinstance(nsid, int) or nsid <= 0:
+            raise ValueError("nsid must be a positive integer")
+
+        nds_config_path = d.get("nds_config_path")
+        if not isinstance(nds_config_path, str) or not nds_config_path:
+            raise ValueError("nds_config_path must be a non-empty string")
+
+        max_size_gb = d.get("max_size_gb", 0)
+        if not isinstance(max_size_gb, (int, float)) or max_size_gb < 0:
+            raise ValueError("max_size_gb must be a non-negative number")
+
+        num_workers = L2AdapterConfigBase._validate_num_workers(d.get("num_workers", 4))
+
+        init_timeout_s = d.get("init_timeout_s", 30)
+        if not isinstance(init_timeout_s, (int, float)) or init_timeout_s <= 0:
+            raise ValueError("init_timeout_s must be a positive number")
+
+        warmup_on_init = d.get("warmup_on_init", True)
+        if not isinstance(warmup_on_init, bool):
+            raise ValueError("warmup_on_init must be a boolean")
+
+        warmup_keys = d.get("warmup_keys", 16)
+        if not isinstance(warmup_keys, int) or warmup_keys <= 0:
+            raise ValueError("warmup_keys must be a positive integer")
+
+        eager_init_on_start = d.get("eager_init_on_start", True)
+        if not isinstance(eager_init_on_start, bool):
+            raise ValueError("eager_init_on_start must be a boolean")
+
+        failure_threshold = d.get("failure_threshold", 3)
+        if not isinstance(failure_threshold, int) or failure_threshold <= 0:
+            raise ValueError("failure_threshold must be a positive integer")
+
+        get_retry_count = d.get("get_retry_count", 0)
+        if not isinstance(get_retry_count, int) or get_retry_count < 0:
+            raise ValueError("get_retry_count must be a non-negative integer")
+
+        get_retry_backoff = d.get("get_retry_backoff", 0.2)
+        if not isinstance(get_retry_backoff, (int, float)) or get_retry_backoff < 0:
+            raise ValueError("get_retry_backoff must be a non-negative number")
+
+        io_timeout_s = d.get("io_timeout_s", 60)
+        if not isinstance(io_timeout_s, (int, float)) or io_timeout_s < 0:
+            raise ValueError("io_timeout_s must be a non-negative number")
+
+        unhealthy_probe_interval = d.get("unhealthy_probe_interval", 15)
+        if not isinstance(unhealthy_probe_interval, (int, float)) or unhealthy_probe_interval < 0:
+            raise ValueError("unhealthy_probe_interval must be a non-negative number")
+
+        nds_buffer_size_gb = d.get("nds_buffer_size_gb", 2)
+        if not isinstance(nds_buffer_size_gb, (int, float)) or nds_buffer_size_gb <= 0:
+            raise ValueError("nds_buffer_size_gb must be a positive number")
+
+        use_l1_zero_copy = d.get("use_l1_zero_copy", True)
+        if not isinstance(use_l1_zero_copy, bool):
+            raise ValueError("use_l1_zero_copy must be a boolean")
+
+        return cls(
+            nsid=nsid,
+            nds_config_path=nds_config_path,
+            max_size_gb=max_size_gb,
+            num_workers=num_workers,
+            init_timeout_s=init_timeout_s,
+            warmup_on_init=warmup_on_init,
+            warmup_keys=warmup_keys,
+            eager_init_on_start=eager_init_on_start,
+            failure_threshold=failure_threshold,
+            get_retry_count=get_retry_count,
+            get_retry_backoff=get_retry_backoff,
+            io_timeout_s=io_timeout_s,
+            unhealthy_probe_interval=unhealthy_probe_interval,
+            nds_buffer_size_gb=nds_buffer_size_gb,
+            use_l1_zero_copy=use_l1_zero_copy,
+        )
+
+    @classmethod
+    def help(cls) -> str:
+        return (
+            "NDS L2 adapter config fields:\n"
+            "- nsid (int): NDS namespace ID (required, >0)\n"
+            "- nds_config_path (str): path to nds_wrapper.conf "
+            "(required)\n"
+            "- max_size_gb (float): NDS capacity in GB for "
+            "eviction reporting; 0 = no global eviction "
+            "(optional, default 0)\n"
+            "- num_workers (int): thread pool size for "
+            "async I/O (optional, default 4)\n"
+            "- init_timeout_s (float): NDS init timeout "
+            "in seconds (optional, default 30)\n"
+            "- warmup_on_init (bool): run warmup write "
+            "smoke test after init (optional, default True; "
+            "write-only, no read-back)\n"
+            "- warmup_keys (int): number of warmup keys, "
+            "1 MiB each (optional, default 16)\n"
+            "- eager_init_on_start (bool): run NDS init "
+            "(+warmup) eagerly in a daemon thread at adapter "
+            "creation instead of on first IO (optional, "
+            "default True)\n"
+            "- failure_threshold (int): consecutive failures "
+            "before marking unhealthy (optional, default 3)\n"
+            "- get_retry_count (int): batchGet retries on "
+            "failure (optional, default 0 = no retry)\n"
+            "- get_retry_backoff (float): seconds between "
+            "get retries (optional, default 0.2)\n"
+            "- io_timeout_s (float): timeout for a single "
+            "batchPut/batchGet call; on timeout the worker "
+            "thread is abandoned and the adapter is marked "
+            "unhealthy immediately; must exceed the "
+            "reconnect-window slow-fail latency (~10s); "
+            "0 = disabled (optional, default 60)\n"
+            "- unhealthy_probe_interval (float): seconds "
+            "between background health probes when unhealthy "
+            "(optional, default 15; matched to the NDS client "
+            "auto-reconnect window, ~10-15s; 0 = disabled, "
+            "which latches unhealthy forever because all IO "
+            "fail-fast while unhealthy)\n"
+            "- nds_buffer_size_gb (float): size of the "
+            "dedicated NDS staging buffer in GB (optional, "
+            "default 2)\n"
+            "- use_l1_zero_copy (bool): register the L1 "
+            "buffer with NDS (init_multi) so store/load IO "
+            "hits MemoryObj memory directly without the "
+            "staging memcpy; objects outside the registered "
+            "range fall back to the staging copy (optional, "
+            "default True)"
+        )
+
+
+# Main class
+
+
+class NDSL2Adapter(L2AdapterInterface):
+    """NDS-backed L2 adapter.
+
+    Wraps pynds_kv (batchPut/batchGet/is_exists) behind the async
+    L2AdapterInterface. Uses an asyncio background loop for non-blocking
+    I/O and event notifiers for completion signaling.
+
+    NDS init is deferred to the first IO operation. If init fails, the
+    adapter degrades gracefully (returns miss) and retries on subsequent
+    IO calls.
+
+    Args:
+        config: NDSL2AdapterConfig instance.
+        l1_memory_desc: L1 memory descriptor (ptr/size/align) for
+            pynds_kv.init(). May be None for testing.
+    """
+
+    def __init__(
+        self,
+        config: NDSL2AdapterConfig,
+        l1_memory_desc: "Optional[L1MemoryDesc]" = None,
+    ) -> None:
+        max_cap = int(config.max_size_gb * (1024**3)) if config.max_size_gb > 0 else 0
+        super().__init__(max_capacity_bytes=max_cap)
+        self._config = config
+        self._l1_memory_desc = l1_memory_desc
+
+        # Event notifiers
+        self._store_efd = create_event_notifier()
+        self._lookup_efd = create_event_notifier()
+        self._load_efd = create_event_notifier()
+
+        # Task bookkeeping
+        self._next_task_id: L2TaskId = 0
+        self._completed_store_tasks: "dict[L2TaskId, L2StoreResult]" = {}
+        self._completed_lookup_tasks: dict = {}
+        self._completed_load_tasks: dict = {}
+        self._lock = threading.Lock()
+
+        # Asyncio background loop
+        self._loop = asyncio.new_event_loop()
+        self._loop.set_default_executor(
+            ThreadPoolExecutor(max_workers=config.num_workers)
+        )
+        self._loop_thread = threading.Thread(target=self._run_loop, daemon=True)
+        self._loop_thread.start()
+
+        # NDS init state (deferred)
+        self._nds_initialized: bool = False
+        self._pynds_init_failed: bool = False
+        # True once pynds_kv.init() + staging mmap succeeded.  Warmup
+        # failures retry only the warmup write instead of re-running
+        # pynds_kv.init in-process (double init can hang the NDS client and
+        # would leak the previous registered mmap).
+        self._nds_client_ready: bool = False
+        self._init_lock = threading.Lock()
+        self._nds_buffer_size: int = int(config.nds_buffer_size_gb * (1024**3))
+        self._nds_mmap = None  # allocated in _init_nds_once
+        # Registered L1 MR range (zero-copy data path); None when the
+        # staging-copy path is in use.
+        self._l1_mr_base: Optional[int] = None
+        self._l1_mr_end: int = 0
+
+        # Health tracking
+        self._healthy: bool = True
+        self._consecutive_failures: int = 0
+        self._failure_threshold: int = config.failure_threshold
+
+        # Background health probe
+        self._probe_stop = threading.Event()
+        self._probe_thread: threading.Thread | None = None
+        if config.unhealthy_probe_interval > 0:
+            self._probe_thread = threading.Thread(
+                target=self._run_health_probe, daemon=True
+            )
+            self._probe_thread.start()
+
+        # Per-call IO detail logging, aligned with kv_storage_backend's
+        # LMCACHE_KV_DEBUG_LOG convention (one info line per pynds_kv call:
+        # op, nsid, keys, bytes, latency, bandwidth, first/last block_id,
+        # attempts, ret).
+        self._debug_io = os.environ.get("LMCACHE_KV_DEBUG_LOG", "").lower() not in (
+            "",
+            "0",
+            "false",
+        )
+
+        # Eager NDS init (+warmup) at adapter creation, so the KV-box
+        # connection is established before the first real request instead
+        # of being triggered lazily by it.  Runs in a daemon thread so
+        # server startup is never blocked; failures degrade to the usual
+        # unhealthy/lazy-retry path.
+        self._closed = threading.Event()
+        self._eager_thread: threading.Thread | None = None
+        if config.eager_init_on_start:
+            self._eager_thread = threading.Thread(
+                target=self._eager_init,
+                daemon=True,
+                name="nds-l2-eager-init",
+            )
+            self._eager_thread.start()
+
+    def _eager_init(self) -> None:
+        """Daemon-thread entry: init NDS eagerly unless already closing."""
+        if self._closed.is_set():
+            return
+        try:
+            self._ensure_nds_initialized()
+        except Exception:
+            logger.exception(
+                "Eager NDS init failed; will retry lazily on first IO"
+            )
+
+    # --------------------
+    # Key Encoding
+    # --------------------
+
+    @staticmethod
+    def _encode_block_id(key: "ObjectKey") -> int:
+        """Encode an ObjectKey into an 80-bit NDS block_id.
+
+        key_high (16 bits) = 0 for business keys (0xFFFF is the reserved
+        warmup domain).
+        key_low (64 bits) = sha256(chunk_hash + model_name + cache_salt
+            + kv_rank + object_group_id)[:8]
+
+        NOTE: ObjectKey.kv_rank is NOT a small rank index -- it is a packed
+        32-bit bitmap ((world_size << 24) | (global_rank << 16) |
+        (local_world_size << 8) | local_rank, see ObjectKey.ComputeKVRank),
+        e.g. 0x01000100 for a single worker.  The previous encoding put
+        ``kv_rank << 4`` into the 16-bit key_high field, which overflows
+        80 bits for ANY real kv_rank and makes pybind's parse_key80 raise
+        on every call.  kv_rank and object_group_id are therefore folded
+        into the key_low hash instead (collision resistance from SHA-256,
+        64-bit truncation), leaving key_high free.
+
+        Args:
+            key: The ObjectKey to encode.
+
+        Returns:
+            An int < 2^80 suitable for pynds_kv block_id.
+        """
+        h = hashlib.sha256()
+        h.update(key.chunk_hash)
+        h.update(key.model_name.encode())
+        h.update(key.cache_salt.encode())
+        h.update(key.kv_rank.to_bytes(4, "little", signed=False))
+        h.update(key.object_group_id.to_bytes(2, "little", signed=False))
+        key_low = int.from_bytes(h.digest()[:8], "little")
+        return key_low
+
+    # --------------------
+    # Event Fd Interface
+    # --------------------
+
+    def get_store_event_fd(self) -> int:
+        return self._store_efd.fileno()
+
+    def get_lookup_and_lock_event_fd(self) -> int:
+        return self._lookup_efd.fileno()
+
+    def get_load_event_fd(self) -> int:
+        return self._load_efd.fileno()
+
+    # --------------------
+    # NDS Init
+    # --------------------
+
+    def _ensure_nds_initialized(self, force: bool = False) -> None:
+        """Ensure NDS is initialized, with lazy retry on failure.
+
+        Args:
+            force: If True, bypass the _pynds_init_failed latch
+                and retry init (used for lazy recovery).
+        """
+        if self._nds_initialized:
+            return
+        if self._pynds_init_failed and not force:
+            return
+        self._init_nds_once(force=force)
+
+    def _init_nds_once(self, force: bool = False) -> None:
+        """Initialize NDS (guarded by lock, single execution).
+
+        Args:
+            force: Bypass the _pynds_init_failed latch.
+        """
+        with self._init_lock:
+            if self._nds_initialized:
+                return
+            if self._pynds_init_failed and not force:
+                return
+
+            if not self._nds_client_ready:
+                import ctypes
+
+                # Lazy import pynds_kv
+                import pynds_kv
+
+                ret = -1
+
+                def _do_init() -> None:
+                    nonlocal ret
+                    # Always allocate a dedicated NDS staging buffer via
+                    # mmap + mlock.  It serves as the fallback MR for
+                    # objects outside the registered L1 range, and as the
+                    # only MR when L1 zero-copy is disabled/unavailable.
+                    import ctypes
+                    import mmap
+
+                    buf_size = self._nds_buffer_size
+                    self._nds_mmap = mmap.mmap(
+                        -1, buf_size, access=mmap.ACCESS_READ | mmap.ACCESS_WRITE
+                    )
+                    # mlock the pages so they stay resident for RDMA
+                    try:
+                        import ctypes.util
+
+                        libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
+                        libc.mlock.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
+                        libc.mlock.restype = ctypes.c_int
+                        addr = ctypes.addressof(ctypes.c_char.from_buffer(self._nds_mmap))
+                        if libc.mlock(addr, buf_size) != 0:
+                            logger.warning(
+                                "mlock failed (errno=%d), NDS may fail if pages are swapped",
+                                ctypes.get_errno(),
+                            )
+                    except Exception:
+                        logger.warning("mlock unavailable, continuing without it")
+
+                    # Touch pages to ensure they're faulted in
+                    chunk = 4096
+                    zero_page = b"\x00" * chunk
+                    for off in range(0, buf_size, chunk):
+                        self._nds_mmap[off : off + chunk] = zero_page
+
+                    buf_addr = ctypes.addressof(
+                        ctypes.c_char.from_buffer(self._nds_mmap)
+                    )
+                    staging_buf = (ctypes.c_char * buf_size).from_address(buf_addr)
+
+                    # Zero-copy: register the L1 buffer itself as MR0 so
+                    # store/load IO hits MemoryObj memory directly (the
+                    # non-MP kv_storage_backend has registered CUDA-pinned
+                    # CPU-pool memory with NDS on this platform all along).
+                    # NOTE: with LazyMemoryAllocator, ibv_reg_mr pins the
+                    # whole final-size region eagerly, trading away the lazy
+                    # expansion (total memory footprint is unchanged).
+                    l1_desc = self._l1_memory_desc
+                    use_l1 = (
+                        self._config.use_l1_zero_copy
+                        and l1_desc is not None
+                        and bool(l1_desc.ptr)
+                        and l1_desc.size > 0
+                    )
+                    if use_l1:
+                        l1_buf = (ctypes.c_char * l1_desc.size).from_address(
+                            l1_desc.ptr
+                        )
+                        ret = pynds_kv.init_multi(
+                            [l1_buf, staging_buf],
+                            [l1_desc.size, buf_size],
+                            self._config.nds_config_path,
+                        )
+                        if ret == 0:
+                            self._l1_mr_base = l1_desc.ptr
+                            self._l1_mr_end = l1_desc.ptr + l1_desc.size
+                            logger.info(
+                                "NDS zero-copy enabled: L1 buffer registered "
+                                "as MR0 (%d bytes), staging MR1 (%d bytes)",
+                                l1_desc.size,
+                                buf_size,
+                            )
+                        else:
+                            logger.error(
+                                "NDS init_multi with L1 zero-copy failed "
+                                "(ret=%d). Set use_l1_zero_copy=false to "
+                                "force the staging-copy path.",
+                                ret,
+                            )
+                    else:
+                        ret = pynds_kv.init(
+                            staging_buf,
+                            buf_size,
+                            self._config.nds_config_path,
+                        )
+
+                # Daemon-thread timeout wrapper
+                t = threading.Thread(target=_do_init, daemon=True)
+                t.start()
+                t.join(timeout=self._config.init_timeout_s)
+
+                if t.is_alive():
+                    logger.error(
+                        "NDS init timed out after %s seconds",
+                        self._config.init_timeout_s,
+                    )
+                    self._pynds_init_failed = True
+                    self._healthy = False
+                    return
+
+                if ret != 0:
+                    logger.error("NDS init failed with ret=%d", ret)
+                    self._pynds_init_failed = True
+                    self._healthy = False
+                    return
+
+                logger.info("NDS init success (nsid=%d)", self._config.nsid)
+                self._nds_client_ready = True
+
+            # Warmup IO
+            if self._config.warmup_on_init:
+                try:
+                    warmup_ok = self._warmup_nds_io()
+                except Exception:
+                    logger.exception("NDS warmup IO raised an exception")
+                    warmup_ok = False
+                if not warmup_ok:
+                    logger.error("NDS warmup IO failed, marking unhealthy")
+                    # Latch so subsequent IO fails fast; lazy retry (force)
+                    # re-runs ONLY this warmup, not pynds_kv.init.
+                    self._pynds_init_failed = True
+                    self._healthy = False
+                    return
+
+            self._pynds_init_failed = False
+            self._healthy = True
+            self._nds_initialized = True
+
+    def _in_l1_mr(self, addr: int, size: int) -> bool:
+        """True when [addr, addr+size) lies fully inside the registered L1
+        MR, i.e. the object can be read/written by NDS directly
+        (zero-copy) without going through the staging buffer."""
+        return (
+            self._l1_mr_base is not None
+            and self._l1_mr_base <= addr
+            and addr + size <= self._l1_mr_end
+        )
+
+    def _call_with_timeout(self, func, *args) -> int:
+        """Call a pynds_kv function with a timeout, returning -1 on failure.
+
+        A hung C++ call must not deadlock the adapter's asyncio loop: the
+        worker thread is abandoned (shutdown(wait=False)) rather than
+        joined, so a stuck RDMA call leaks one thread but the adapter
+        degrades to unhealthy instead of hanging silently.
+        """
+        executor = ThreadPoolExecutor(max_workers=1)
+        try:
+            future = executor.submit(func, *args)
+            return future.result(timeout=self._config.init_timeout_s)
+        except FuturesTimeoutError:
+            logger.error(
+                "pynds_kv call timed out after %s seconds",
+                self._config.init_timeout_s,
+            )
+            return -1
+        except Exception:
+            logger.exception("pynds_kv call raised an exception")
+            return -1
+        finally:
+            executor.shutdown(wait=False)
+
+    async def _run_io_with_timeout(self, func) -> int:
+        """Run a pynds_kv batch call in a worker thread with a timeout.
+
+        A hung C++ call must not deadlock the adapter: on timeout the
+        worker thread is abandoned (leaked) rather than joined, and the
+        adapter is marked unhealthy immediately -- a hang is unambiguous,
+        unlike the reconnect-window slow failure (~8.5s observed for
+        RNR/transport retry during a KV-box outage), which
+        ``io_timeout_s`` must therefore exceed (default 60s; 0 disables).
+
+        Note: the abandoned thread may complete later.  Store-path
+        staging is not reused while unhealthy (tasks fail fast), and the
+        health probe only recovers after NDS answers again, which bounds
+        the quarantine window; late RDMA completion then only touches
+        memory that is still registered and owned by this adapter.
+        """
+        timeout = self._config.io_timeout_s
+        if timeout <= 0:
+            return await asyncio.to_thread(func)
+        try:
+            return await asyncio.wait_for(asyncio.to_thread(func), timeout)
+        except TimeoutError:
+            logger.error(
+                "pynds_kv IO hung beyond %ss; abandoning worker thread "
+                "and marking unhealthy",
+                timeout,
+            )
+            self._healthy = False
+            self._consecutive_failures += 1
+            return -1
+
+    def _log_pynds_io(
+        self,
+        op: str,
+        block_ids: "list[int]",
+        total_bytes: int,
+        elapsed_s: float,
+        ret: int,
+        attempts: int = 1,
+    ) -> None:
+        """Per-call pynds_kv IO detail, gated by LMCACHE_KV_DEBUG_LOG.
+
+        Field layout mirrors kv_storage_backend's kv_set/kv_get/kv_exists
+        lines so the same grep/awk tooling works on MP server logs.
+        """
+        if not self._debug_io:
+            return
+        n = len(block_ids)
+        bw = total_bytes / elapsed_s / 1e9 if elapsed_s > 0 else 0.0
+        logger.info(
+            "%s: nsid=%d keys=%d total_bytes=%d io_ms=%.2f bw=%.2fGB/s "
+            "first_block_id=%d last_block_id=%d attempts=%d ret=%d",
+            op,
+            self._config.nsid,
+            n,
+            total_bytes,
+            elapsed_s * 1000,
+            bw,
+            block_ids[0] if n else -1,
+            block_ids[-1] if n else -1,
+            attempts,
+            ret,
+        )
+
+    def _warmup_nds_io(self) -> bool:
+        """Run warmup write self-test (write-only, no read-back).
+
+        Uses reserved key_high=0xFFFF domain to avoid collision with
+        business keys. Writes warmup_keys x 1 MiB through the registered
+        staging MR (plain Python bytes are NOT registered with the IB
+        driver and would make the RDMA data path hang).
+
+        No read-back verification: the KV box does not support overwrite
+        writes, so on restart the fixed warmup keys already exist and the
+        box keeps the previously written bytes -- a read-back compare
+        against this run's pattern would always mismatch.  The warmup's
+        purpose is to establish the RDMA connections and smoke-test the
+        write path, which the batchPut alone covers.
+
+        Returns:
+            True if warmup passed, False otherwise.
+        """
+        import ctypes
+
+        import pynds_kv
+
+        warmup_size = 1024 * 1024  # 1 MiB
+        nsid = self._config.nsid
+        num_keys = self._config.warmup_keys
+        total = warmup_size * num_keys
+
+        if self._nds_mmap is None or total > self._nds_buffer_size:
+            logger.error(
+                "Warmup needs %d bytes of staging, have %s",
+                total,
+                self._nds_buffer_size if self._nds_mmap is not None else None,
+            )
+            return False
+
+        # Use key_high=0xFFFF (reserved domain)
+        block_ids = [(0xFFFF << 64) + i for i in range(num_keys)]
+        nsids = [nsid] * num_keys
+        offsets = [i * warmup_size for i in range(num_keys)]
+        lengths = [warmup_size] * num_keys
+
+        mr_base = ctypes.addressof(ctypes.c_char.from_buffer(self._nds_mmap))
+        # Per-key views with offset 0: the wrapper's padded-write path
+        # (length < value_size) rejects non-zero write offsets and reads
+        # [base, base + value_size) from each key's base pointer.
+        views = [
+            (ctypes.c_char * warmup_size).from_address(mr_base + i * warmup_size)
+            for i in range(num_keys)
+        ]
+        zeros = [0] * num_keys
+
+        # Fill per-key patterns directly in the registered staging region
+        for i, off in enumerate(offsets):
+            pattern = bytearray(warmup_size)
+            for j in range(0, warmup_size, 256):
+                pattern[j] = (i + j) & 0xFF
+            self._nds_mmap[off : off + warmup_size] = bytes(pattern)
+
+        # Write (5-arg pynds_kv main API: block_ids, buffers, offsets,
+        # lengths, nsids)
+        t0 = time.monotonic()
+        ret = self._call_with_timeout(
+            pynds_kv.batchPut, block_ids, views, zeros, lengths, nsids
+        )
+        self._log_pynds_io("kv_set", block_ids, total, time.monotonic() - t0, ret)
+        if ret != 0:
+            logger.error("Warmup batchPut failed: ret=%d", ret)
+            return False
+
+        logger.info(
+            "NDS warmup IO ok: wrote %d bytes in %d keys (no read-back; "
+            "box does not support overwrite)",
+            total,
+            num_keys,
+        )
+        return True
+
+    # --------------------
+    # Health Tracking
+    # --------------------
+
+    def _record_pynds_failure(self) -> None:
+        """Record a pynds_kv call failure and mark unhealthy if threshold reached."""
+        self._consecutive_failures += 1
+        if self._consecutive_failures >= self._failure_threshold:
+            if self._healthy:
+                logger.error(
+                    "NDSL2Adapter marked unhealthy after %d consecutive failures",
+                    self._consecutive_failures,
+                )
+            self._healthy = False
+
+    def _record_pynds_success(self) -> None:
+        """Record a pynds_kv call success, reset health if recovering."""
+        if not self._healthy:
+            logger.info("NDSL2Adapter recovered to healthy")
+            self._healthy = True
+        self._consecutive_failures = 0
+
+    def _run_health_probe(self) -> None:
+        """Background thread: periodically probe NDS health when unhealthy.
+
+        When the adapter is unhealthy, probes NDS with a known warmup key
+        (reserved key_high=0xFFFF domain).  On success, marks healthy; the
+        init latch (_pynds_init_failed) is intentionally NOT cleared here —
+        if it is set, the next IO's lazy retry re-runs the warmup write,
+        which re-verifies the data path before serving real traffic.
+
+        Two guards keep the probe itself from becoming the hang:
+          - Skip when the NDS client was never initialized
+            (_nds_client_ready False): is_exists on uninitialized global
+            client state is undefined.  That failure mode recovers through
+            the IO paths' lazy retry instead.
+          - Run the call under _call_with_timeout: a client stuck in
+            reconnect must not block the probe thread forever, or the only
+            recovery path dies silently.  A timed-out probe leaks one
+            daemon thread, same abandon policy as the IO paths.
+
+        Note on the success criterion (ret >= 0): is_exists returning 0
+        means "reachable but key absent".  Whether the SDK returns 0 (vs a
+        negative error) on transport failure is unverified with the vendor;
+        if it does, the probe may briefly false-positive, which
+        self-corrects when the next real IO fails and re-latches unhealthy.
+        """
+        import time
+
+        try:
+            import pynds_kv
+        except ImportError:
+            logger.error("NDSL2Adapter health probe: pynds_kv unavailable, probe disabled")
+            return
+
+        interval = self._config.unhealthy_probe_interval
+        while not self._probe_stop.wait(timeout=interval):
+            if self._healthy:
+                continue
+            if not self._nds_client_ready:
+                continue
+            probe_key = [(0xFFFF << 64)]
+            t0 = time.monotonic()
+            ret = self._call_with_timeout(
+                pynds_kv.is_exists, probe_key, self._config.nsid
+            )
+            self._log_pynds_io("kv_exists", probe_key, 0, time.monotonic() - t0, ret)
+            if ret >= 0:
+                self._record_pynds_success()
+                logger.info("NDSL2Adapter health probe: NDS reachable, recovered")
+            else:
+                logger.debug("NDSL2Adapter health probe: NDS still unreachable")
+
+    # --------------------
+    # Store / Load / Lookup (stubs - filled in Task 3+4)
+    # --------------------
+
+    def submit_store_task(
+        self,
+        keys: "list[ObjectKey]",
+        objects: "list",
+    ) -> L2TaskId:
+        """Submit a store task to store a batch of memory objects.
+
+        Schedules an async store coroutine on the background asyncio
+        loop and returns immediately. Completion is signaled via the
+        store event fd and retrieved via ``pop_completed_store_tasks``.
+
+        Args:
+            keys: List of ObjectKeys to store.
+            objects: List of MemoryObj to store (same length as keys).
+
+        Returns:
+            L2TaskId for the submitted task.
+        """
+        task_id = self._get_next_task_id()
+        asyncio.run_coroutine_threadsafe(
+            self._execute_store(keys, objects, task_id), self._loop
+        )
+        return task_id
+
+    def pop_completed_store_tasks(self) -> "dict[L2TaskId, L2StoreResult]":
+        """Pop all completed store tasks.
+
+        Returns:
+            Dict mapping L2TaskId to L2StoreResult. The returned dict
+            is detached from the adapter; a subsequent call returns only
+            tasks that completed since the last pop.
+        """
+        with self._lock:
+            completed = self._completed_store_tasks
+            self._completed_store_tasks = {}
+        return completed
+
+    async def _execute_store(
+        self,
+        keys: "list[ObjectKey]",
+        objects: "list",
+        task_id: L2TaskId,
+    ) -> None:
+        """Execute a store operation in the asyncio loop.
+
+        Encodes block_ids from keys, extracts byte buffers from each
+        MemoryObj, and calls ``pynds_kv.batchPut`` via
+        ``asyncio.to_thread`` so the C++ call does not block the loop.
+        Records the outcome in ``_completed_store_tasks`` and signals
+        the store event fd.
+
+        If the adapter is unhealthy (init failed or failure threshold
+        reached), the task fails fast without touching NDS.
+
+        Any exception during block_id encoding, buffer extraction, or
+        batchPut is caught and recorded as a failure result, preventing
+        the caller from hanging indefinitely on get_store_event_fd().
+        """
+        try:
+            self._ensure_nds_initialized(force=self._pynds_init_failed)
+        except Exception:
+            # Contain init failures: record a failed task instead of
+            # killing the coroutine silently (which would hang the caller
+            # waiting on the store event fd).
+            logger.exception("NDS init raised an exception for store task %s", task_id)
+            self._healthy = False
+        if not self._healthy:
+            with self._lock:
+                self._completed_store_tasks[task_id] = L2StoreResult(False, 0)
+            self._store_efd.notify()
+            return
+
+        try:
+            import ctypes
+            import pynds_kv
+
+            block_ids = [self._encode_block_id(k) for k in keys]
+            sizes = [obj.get_size() for obj in objects]
+
+            mr_base = ctypes.addressof(
+                ctypes.c_char.from_buffer(self._nds_mmap)
+            )
+
+            # Per-key direct-or-staging decision: objects fully inside the
+            # registered L1 MR are handed to batchPut directly (zero-copy);
+            # the rest are staged.  A flush happens when the staging buffer
+            # fills up or at the end.  Per-key views always use offset 0:
+            # the wrapper's padded-write path (length < value_size) rejects
+            # non-zero write offsets and reads [base, base + value_size)
+            # from each key's base pointer.
+            ret = 0
+            pending_ids: list[int] = []
+            pending_views: list = []
+            pending_sizes: list[int] = []
+            pending_copies: list[tuple[int, int, int]] = []  # (dst, src, nbytes)
+            staging_off = 0
+
+            async def _flush() -> int:
+                nonlocal staging_off
+                if not pending_ids:
+                    return 0
+                n = len(pending_ids)
+                ids = list(pending_ids)
+                views = list(pending_views)
+                lens = list(pending_sizes)
+                copies = list(pending_copies)
+                total = sum(lens)
+
+                def _copy_and_put() -> int:
+                    # Staging fallback copies run in the worker thread,
+                    # not on the asyncio loop.
+                    for dst, src, nbytes in copies:
+                        ctypes.memmove(dst, src, nbytes)
+                    return pynds_kv.batchPut(
+                        ids, views, [0] * n, lens, [self._config.nsid] * n
+                    )
+
+                t0 = time.monotonic()
+                r = await self._run_io_with_timeout(_copy_and_put)
+                self._log_pynds_io("kv_set", ids, total, time.monotonic() - t0, r)
+                pending_ids.clear()
+                pending_views.clear()
+                pending_sizes.clear()
+                pending_copies.clear()
+                staging_off = 0
+                return r
+
+            for i, (obj, size) in enumerate(zip(objects, sizes)):
+                src = obj.raw_tensor.data_ptr()
+                if self._in_l1_mr(src, size):
+                    pending_ids.append(block_ids[i])
+                    pending_views.append((ctypes.c_char * size).from_address(src))
+                    pending_sizes.append(size)
+                    continue
+                if size > self._nds_buffer_size:
+                    raise ValueError(
+                        f"object size {size} exceeds NDS staging buffer "
+                        f"{self._nds_buffer_size} bytes; raise nds_buffer_size_gb"
+                    )
+                if staging_off + size > self._nds_buffer_size:
+                    ret = await _flush()
+                    if ret != 0:
+                        break
+                dst = mr_base + staging_off
+                staging_off += size
+                pending_ids.append(block_ids[i])
+                pending_views.append((ctypes.c_char * size).from_address(dst))
+                pending_sizes.append(size)
+                pending_copies.append((dst, src, size))
+            if ret == 0:
+                ret = await _flush()
+        except Exception:
+            logger.exception(
+                "NDS batchPut raised exception for task %s", task_id
+            )
+            self._record_pynds_failure()
+            result = L2StoreResult(False, 0)
+            sizes = []
+        else:
+            if ret == 0:
+                self._record_pynds_success()
+                result = L2StoreResult(True, sum(sizes))
+            else:
+                self._record_pynds_failure()
+                logger.error("NDS batchPut failed: ret=%d", ret)
+                result = L2StoreResult(False, 0)
+
+        if result.is_successful():
+            self._notify_keys_stored(keys, sizes)
+
+        with self._lock:
+            self._completed_store_tasks[task_id] = result
+        self._store_efd.notify()
+
+    def submit_lookup_and_lock_task(
+        self,
+        keys: "list[ObjectKey]",
+        group_layout_descs: "dict",
+    ) -> L2TaskId:
+        """Submit a lookup task to check key existence via is_exists.
+
+        NDS has no lock concept -- this is a pure existence check.
+        ``is_exists`` returns a prefix count (first N blocks exist
+        consecutively), which maps naturally to chunk-sequential
+        cache lookup semantics.
+
+        Args:
+            keys: List of ObjectKeys to look up.
+            group_layout_descs: Layout hints (ignored by NDS).
+
+        Returns:
+            L2TaskId for the submitted task.
+        """
+        task_id = self._get_next_task_id()
+        asyncio.run_coroutine_threadsafe(
+            self._execute_lookup(keys, task_id), self._loop
+        )
+        return task_id
+
+    def query_lookup_and_lock_result(
+        self, task_id: L2TaskId
+    ) -> "Bitmap | None":
+        """Non-blockingly query the result of a lookup task.
+
+        Args:
+            task_id: The task ID from ``submit_lookup_and_lock_task``.
+
+        Returns:
+            Bitmap or None if not yet completed.
+        """
+        with self._lock:
+            return self._completed_lookup_tasks.pop(task_id, None)
+
+    async def _execute_lookup(
+        self,
+        keys: "list[ObjectKey]",
+        task_id: L2TaskId,
+    ) -> None:
+        """Execute a lookup in the asyncio loop.
+
+        Calls ``pynds_kv.is_exists`` (prefix count) and converts to
+        Bitmap: first N bits set, rest unset. When unhealthy, returns
+        an all-zeros bitmap without touching NDS.
+
+        Any exception during block_id encoding or the is_exists call is
+        caught and recorded as an all-zeros bitmap, preventing the caller
+        from hanging indefinitely on ``get_lookup_and_lock_event_fd()``.
+        """
+        from lmcache.lmcache_native import Bitmap
+
+        try:
+            self._ensure_nds_initialized(force=self._pynds_init_failed)
+        except Exception:
+            logger.exception(
+                "NDS init raised an exception for lookup task %s", task_id
+            )
+            self._healthy = False
+        if not self._healthy:
+            bitmap = Bitmap(len(keys))
+            with self._lock:
+                self._completed_lookup_tasks[task_id] = bitmap
+            self._lookup_efd.notify()
+            return
+
+        try:
+            import pynds_kv
+
+            block_ids = [self._encode_block_id(k) for k in keys]
+            t0 = time.monotonic()
+            prefix_count = await asyncio.to_thread(
+                pynds_kv.is_exists, block_ids, self._config.nsid
+            )
+            self._log_pynds_io(
+                "kv_exists", block_ids, 0, time.monotonic() - t0, prefix_count
+            )
+            if prefix_count < 0:
+                self._record_pynds_failure()
+                prefix_count = 0
+
+            bitmap = Bitmap(len(keys))
+            for i in range(min(prefix_count, len(keys))):
+                bitmap.set(i)
+
+            if prefix_count > 0:
+                self._record_pynds_success()
+        except Exception:
+            logger.exception(
+                "NDS is_exists raised exception for task %s", task_id
+            )
+            self._record_pynds_failure()
+            bitmap = Bitmap(len(keys))
+
+        with self._lock:
+            self._completed_lookup_tasks[task_id] = bitmap
+        self._lookup_efd.notify()
+
+    def submit_unlock(self, keys: "list[ObjectKey]") -> None:
+        pass  # No-op: NDS has no lock concept
+
+    def submit_load_task(
+        self,
+        keys: "list[ObjectKey]",
+        objects: "list",
+    ) -> L2TaskId:
+        """Submit a load task to load data via batchGet.
+
+        Schedules an async load coroutine on the background asyncio
+        loop and returns immediately. Completion is signaled via the
+        load event fd and retrieved via ``query_load_result``.
+
+        Args:
+            keys: List of ObjectKeys to load.
+            objects: List of MemoryObj buffers to write into.
+
+        Returns:
+            L2TaskId for the submitted task.
+        """
+        task_id = self._get_next_task_id()
+        asyncio.run_coroutine_threadsafe(
+            self._execute_load(keys, objects, task_id), self._loop
+        )
+        return task_id
+
+    def query_load_result(
+        self, task_id: L2TaskId
+    ) -> "Bitmap | None":
+        """Non-blockingly query the result of a load task.
+
+        Args:
+            task_id: The task ID from ``submit_load_task``.
+
+        Returns:
+            Bitmap or None if not yet completed.
+        """
+        with self._lock:
+            return self._completed_load_tasks.pop(task_id, None)
+
+    async def _execute_load(
+        self,
+        keys: "list[ObjectKey]",
+        objects: "list",
+        task_id: L2TaskId,
+    ) -> None:
+        """Execute a load in the asyncio loop.
+
+        Calls ``pynds_kv.batchGet`` to read data into the provided
+        MemoryObj buffers. On success: all bits set and
+        ``_notify_keys_accessed`` fires. On failure: all bits unset.
+
+        Any exception during block_id encoding, buffer extraction, or
+        batchGet is caught and recorded as an all-zeros bitmap, preventing
+        the caller from hanging indefinitely on ``get_load_event_fd()``.
+        """
+        from lmcache.lmcache_native import Bitmap
+
+        try:
+            self._ensure_nds_initialized(force=self._pynds_init_failed)
+        except Exception:
+            logger.exception("NDS init raised an exception for load task %s", task_id)
+            self._healthy = False
+        if not self._healthy:
+            bitmap = Bitmap(len(keys))
+            with self._lock:
+                self._completed_load_tasks[task_id] = bitmap
+            self._load_efd.notify()
+            return
+
+        success = False
+        try:
+            import ctypes
+            import pynds_kv
+
+            block_ids = [self._encode_block_id(k) for k in keys]
+            sizes = [obj.get_size() for obj in objects]
+
+            mr_base = ctypes.addressof(
+                ctypes.c_char.from_buffer(self._nds_mmap)
+            )
+
+            # Per-key direct-or-staging decision: objects fully inside the
+            # registered L1 MR are read into directly (zero-copy); the rest
+            # go through the staging buffer and are copied back after each
+            # batchGet completes (in the worker thread, not on the loop).
+            ret = 0
+            pending_ids: list[int] = []
+            pending_views: list = []
+            pending_sizes: list[int] = []
+            pending_copybacks: list[tuple[int, int, int]] = []  # (dst, src, nbytes)
+            staging_off = 0
+
+            async def _flush() -> int:
+                nonlocal staging_off
+                if not pending_ids:
+                    return 0
+                n = len(pending_ids)
+                ids = list(pending_ids)
+                views = list(pending_views)
+                lens = list(pending_sizes)
+                copybacks = list(pending_copybacks)
+                total = sum(lens)
+
+                def _get_and_copy() -> int:
+                    return pynds_kv.batchGet(
+                        ids, views, [0] * n, lens, [self._config.nsid] * n
+                    )
+
+                def _copyback() -> None:
+                    for dst, src, nbytes in copybacks:
+                        ctypes.memmove(dst, src, nbytes)
+
+                t0 = time.monotonic()
+                attempts = 0
+                r = -1
+                for attempt in range(self._config.get_retry_count + 1):
+                    attempts = attempt + 1
+                    r = await self._run_io_with_timeout(_get_and_copy)
+                    if r == 0:
+                        break
+                    if not self._healthy:
+                        # IO timeout marked the adapter unhealthy (hung
+                        # call abandoned); retrying would just pile more
+                        # threads into a stuck NDS client.
+                        break
+                    if attempt < self._config.get_retry_count:
+                        logger.warning(
+                            "NDS batchGet attempt %d failed: ret=%d, retrying",
+                            attempt + 1,
+                            r,
+                        )
+                        await asyncio.sleep(self._config.get_retry_backoff)
+                self._log_pynds_io(
+                    "kv_get",
+                    ids,
+                    total if r == 0 else 0,
+                    time.monotonic() - t0,
+                    r,
+                    attempts=attempts,
+                )
+                if r == 0 and copybacks:
+                    await asyncio.to_thread(_copyback)
+                pending_ids.clear()
+                pending_views.clear()
+                pending_sizes.clear()
+                pending_copybacks.clear()
+                staging_off = 0
+                return r
+
+            for i, (obj, size) in enumerate(zip(objects, sizes)):
+                dst = obj.raw_tensor.data_ptr()
+                if self._in_l1_mr(dst, size):
+                    pending_ids.append(block_ids[i])
+                    pending_views.append((ctypes.c_char * size).from_address(dst))
+                    pending_sizes.append(size)
+                    continue
+                if size > self._nds_buffer_size:
+                    raise ValueError(
+                        f"object size {size} exceeds NDS staging buffer "
+                        f"{self._nds_buffer_size} bytes; raise nds_buffer_size_gb"
+                    )
+                if staging_off + size > self._nds_buffer_size:
+                    ret = await _flush()
+                    if ret != 0:
+                        break
+                src = mr_base + staging_off
+                staging_off += size
+                pending_ids.append(block_ids[i])
+                pending_views.append((ctypes.c_char * size).from_address(src))
+                pending_sizes.append(size)
+                pending_copybacks.append((dst, src, size))
+            if ret == 0:
+                ret = await _flush()
+        except Exception:
+            logger.exception(
+                "NDS batchGet raised exception for task %s", task_id
+            )
+            self._record_pynds_failure()
+            bitmap = Bitmap(len(keys))
+        else:
+            bitmap = Bitmap(len(keys))
+            if ret == 0:
+                self._record_pynds_success()
+                for i in range(len(keys)):
+                    bitmap.set(i)
+                success = True
+            else:
+                self._record_pynds_failure()
+                logger.error(
+                    "NDS batchGet failed after %d attempts: ret=%d",
+                    self._config.get_retry_count + 1,
+                    ret,
+                )
+
+        if success:
+            self._notify_keys_accessed(keys)
+
+        with self._lock:
+            self._completed_load_tasks[task_id] = bitmap
+        self._load_efd.notify()
+
+    def delete(self, keys: "list[ObjectKey]") -> None:
+        """Delete a batch of objects from NDS storage.
+
+        NDS does not support per-key deletion. This is a no-op.
+        NDS disk frame manages its own capacity internally.
+
+        Args:
+            keys: List of ObjectKeys to delete (ignored).
+        """
+        logger.debug(
+            "NDSL2Adapter.delete: no-op (NDS has no delete API), %d keys",
+            len(keys),
+        )
+
+    def get_memory_tags(self) -> MemoryTags:
+        """Return remote storage tags for the NDS disk frame."""
+        return MemoryTags(MemorySegment.STORAGE, MemoryResidency.REMOTE)
+
+    def close(self) -> None:
+        """Close the adapter: stop probe, stop asyncio loop, close event notifiers."""
+        self._closed.set()
+        # Wait briefly for an in-flight eager init so we do not close the
+        # staging mmap from under it.  The eager path is bounded by
+        # init_timeout_s; if it is still running after the grace period we
+        # proceed anyway (a dying daemon thread touching a closed mmap just
+        # fails init and latches, which is harmless at shutdown).
+        if self._eager_thread is not None and self._eager_thread.is_alive():
+            self._eager_thread.join(timeout=2)
+            if self._eager_thread.is_alive():
+                logger.warning("Eager NDS init still running at close")
+
+        self._probe_stop.set()
+        if self._probe_thread is not None:
+            self._probe_thread.join(timeout=5)
+
+        async def _stop_tasks() -> None:
+            tasks = [
+                t
+                for t in asyncio.all_tasks(self._loop)
+                if t is not asyncio.current_task()
+            ]
+            for task in tasks:
+                task.cancel()
+            if tasks:
+                await asyncio.gather(*tasks, return_exceptions=True)
+
+        if self._loop.is_running():
+            future = asyncio.run_coroutine_threadsafe(_stop_tasks(), self._loop)
+            try:
+                future.result(timeout=5)
+            except Exception:
+                pass
+            self._loop.call_soon_threadsafe(self._loop.stop)
+
+        self._loop_thread.join()
+        self._loop.close()
+        self._store_efd.close()
+        self._lookup_efd.close()
+        self._load_efd.close()
+        if self._nds_mmap is not None:
+            self._nds_mmap.close()
+
+    def report_status(self) -> dict:
+        """Return a status dict for this adapter."""
+        return {
+            "is_healthy": self._healthy,
+            "type": "NDSL2Adapter",
+            "nsid": self._config.nsid,
+            "nds_initialized": self._nds_initialized,
+            "consecutive_failures": self._consecutive_failures,
+        }
+
+    # --------------------
+    # Helpers
+    # --------------------
+
+    def _run_loop(self) -> None:
+        """Run the asyncio event loop in a background daemon thread."""
+        asyncio.set_event_loop(self._loop)
+        self._loop.run_forever()
+
+    def _get_next_task_id(self) -> L2TaskId:
+        """Get the next task ID and increment the counter."""
+        with self._lock:
+            task_id = self._next_task_id
+            self._next_task_id += 1
+            return task_id
+
+
+# Self-register config type and adapter factory
+register_l2_adapter_type("nds", NDSL2AdapterConfig)
+
+
+def _create_nds_adapter(
+    config: L2AdapterConfigBase,
+    l1_memory_desc: "Optional[L1MemoryDesc]" = None,
+) -> L2AdapterInterface:
+    """Create an NDSL2Adapter from config."""
+    return NDSL2Adapter(config, l1_memory_desc)  # type: ignore[arg-type]
+
+
+register_l2_adapter_factory("nds", _create_nds_adapter)
