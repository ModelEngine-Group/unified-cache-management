@@ -0,0 +1,2769 @@
+# SPDX-License-Identifier: Apache-2.0
+
+"""HiCache KV storage backend for SGLang.
+
+This module provides the HiCacheKVStorage backend backed by pynds_kv / NDS KV
+box. It implements both the generic v1 API (batch_get/batch_set/batch_exists)
+and the zero-copy v1 API (batch_get_v1/batch_set_v1) plus the v2 pool-transfer
+API.
+
+For MHA host pools in page-first layouts every page is stored as two NDS keys
+("<key>.k" / "<key>.v"): the fused K/V leading dim makes full pages
+non-contiguous, but the K and V halves are contiguous in-MR views, so the
+zero-copy v1 path moves them without staging.
+
+Note:
+    ``batch_get`` may return CPU copies for non-contiguous or GPU target
+    tensors. v1 callers should use the returned tensor rather than the
+    original input tensor.
+"""
+
+# Standard
+import logging
+import os
+import random
+import time
+from concurrent.futures import ThreadPoolExecutor
+from threading import Lock
+from typing import Any, List, Optional
+
+# Third Party
+import numpy as np
+import torch
+
+# First Party
+from sglang.srt.environ import envs
+from sglang.srt.mem_cache.hicache_storage import (
+    HiCacheStorage,
+    HiCacheStorageConfig,
+    HiCacheStorageExtraInfo,
+    PoolHitPolicy,
+    PoolName,
+    PoolTransfer,
+    PoolTransferResult,
+    get_io_request_id,
+)
+from sglang.srt.mem_cache.storage.kv.config import KVStorageBackendConfig
+from sglang.srt.mem_cache.storage.kv.pynds_client import (
+    PyndsClient,
+    init_once_multi,
+    materialize_per_rank_nds_config,
+    materialize_per_rank_nds_config_absolute,
+    numa_local_start_core,
+)
+from sglang.srt.mem_cache.storage.kv.utils import encode_block_id
+
+logger = logging.getLogger(__name__)
+
+MAX_BATCH_SIZE = 1024
+STAGING_SIZE_MB_DEFAULT = 256
+
+# Emit a cumulative "kv_get_total"/"kv_set_total" bandwidth summary every
+# this many IO calls when SGLANG_HICACHE_KV_DEBUG_LOG is enabled.
+_STATS_LOG_INTERVAL = 50
+
+# Key suffixes used when an MHA page is stored as two separate NDS keys.
+# An MHA host pool fuses K and V into one buffer whose leading dim is 2, so a
+# page sliced out of it is never contiguous.  The K and V halves, however, are
+# contiguous within their own sub-buffer in page-first layouts, so each half is
+# stored under its own key ("<key>.k" / "<key>.v") and can move zero-copy.
+_KV_SPLIT_SUFFIXES = (".k", ".v")
+_PAGE_FIRST_LAYOUTS = ("page_first", "page_first_direct")
+
+# Format version for the local-file INDEXER store (indexer_storage="file").
+# The store has no other invalidation: files persist across restarts and are
+# never rewritten once present, so files written by an older build (different
+# page geometry/dtype or pre-fix write semantics) would silently poison cache
+# hits forever.  A format stamp recorded in the store directory lets startup
+# detect a mismatch and wipe stale pages once.  Bump when the on-disk
+# semantics change in a way that is not caught by the size check on read.
+INDEXER_FILE_FORMAT_VERSION = 1
+_INDEXER_FORMAT_STAMP_FILE = ".format_version"
+
+# Pool names that carry indexer pages: the DSA sparse indexer pool and the
+# DeepSeek-V4 C4 indexer pool.  Both honor indexer_storage="file" (local
+# files instead of the KV box) and indexer_nsid routing.  PoolName is a str
+# Enum, so plain-string names compare equal to their enum member.
+_INDEXER_POOL_NAMES = (PoolName.INDEXER, PoolName.DEEPSEEK_V4_C4_INDEXER)
+
+
+def _pool_name_str(name: Any) -> str:
+    """Normalize a pool name (PoolName enum member or plain string) to str.
+
+    PoolName is a plain ``str, Enum`` mixin (not StrEnum), so ``str()`` of a
+    member is version-dependent; use ``.value`` for enum members.
+    """
+    value = getattr(name, "value", None)
+    return value if isinstance(value, str) else str(name)
+
+class HiCacheKVStorage(HiCacheStorage):
+    """HiCache storage backend backed by pynds_kv / NDS KV box.
+
+    This backend supports the generic v1 API (batch_get/batch_set/batch_exists)
+    for all hicache memory layouts, and the zero-copy v1 API
+    (batch_get_v1/batch_set_v1) that slices host-pool pages directly.  For MHA
+    pools in page-first layouts each page is stored as two NDS keys
+    ("<key>.k" / "<key>.v") so both halves are contiguous in-MR views.
+
+    Note:
+        Write calls (all funneled into ``_batch_set_raw``) are short-circuited
+        when the pynds client is unhealthy: they fail fast, and one write per
+        ``unhealthy_probe_interval`` seconds is let through as a probe whose
+        success recovers the backend (``PyndsClient._record_success``).  This
+        keeps a dead KV box from stalling every later request for a full
+        ``timeout`` and from wasting write bandwidth on data that cannot be
+        retrieved anyway (prefix-match semantics make trailing keys useless
+        once an earlier key is missing).  Read and exists calls have their
+        own circuit breaker: after ``read_failure_threshold`` consecutive
+        read failures they fail fast to cache miss (scheduler falls back to
+        normal prefill), with one read per ``read_probe_interval`` seconds
+        let through as a probe.  The probe cadence matches the NDS client's
+        auto-reconnect window (~10-15s: reconnect sleep 5s plus TCP/RDMA
+        re-handshake plus slow-failure drain), so both gates reopen shortly
+        after the box recovers — a successful probe calls
+        ``_record_success``, which resets the read counter and flips the
+        client back to healthy.
+    """
+
+    # The pynds client guards NDS calls for concurrent use (worker semaphore,
+    # per-call timeout threads), and local-file indexer IO shares no state
+    # with the NDS path, so batch_get_v2/batch_set_v2 on extra pools may run
+    # concurrently with the KV-pool transfer on the prefetch/backup thread.
+    # The controller consults this flag to overlap extra-pool IO (e.g. DSA
+    # indexer local-file pages) with the KV-pool NDS transfer instead of
+    # running them strictly one after the other.
+    supports_concurrent_pool_io = True
+
+    def __init__(self, storage_config: HiCacheStorageConfig, mem_pool_host: Any):
+        self.storage_config = storage_config
+        self.mem_pool_host = mem_pool_host
+        # MLA pools are rank-replicated: every rank holds identical KV data and
+        # upstream only lets tp_rank 0 back up (cache_controller.backup_skip),
+        # while exists/get run on ALL ranks.  Encoding tp_rank into block_id
+        # would give each rank a disjoint NDS key space, so cross-rank lookups
+        # could never hit and the MIN all-reduce over per-rank hit counts would
+        # always be 0 (prefetch permanently revoked).  Use a fixed rank 0 for
+        # MLA so all ranks share one key space; MHA keeps per-rank encoding
+        # (TP-sharded data).
+        self._key_rank = 0 if storage_config.is_mla_model else storage_config.tp_rank
+        logger.info(
+            "KV block_id key_rank=%d (tp_rank=%d, is_mla_model=%s)",
+            self._key_rank,
+            storage_config.tp_rank,
+            storage_config.is_mla_model,
+        )
+        self.config = KVStorageBackendConfig.from_extra_config(
+            storage_config.extra_config or {}
+        )
+        self._staging_buffer = None
+        self._staging_size = 0
+        # NDS init state: buffers are collected at pool registration time and
+        # registered as NDS memory regions when finalize_registration() is
+        # called by the controller (after all pools are registered).  A lazy
+        # fallback in IO paths (_ensure_nds_initialized) covers cases where
+        # finalize_registration was not called.
+        self._nds_init_lock = Lock()
+        self._nds_init_done = False
+        self._pending_mr_buffers: List[np.ndarray] = []
+        # Parallel to _pending_mr_buffers: the NDS namespace each buffer's
+        # pool actually uses (anchor -> config.nsid; extra pools ->
+        # _pool_nsid_map / indexer_nsid / nsid via _nsid_for_pool).  Warmup
+        # round-trips must use the pool's own nsid — the vendor client
+        # establishes connections per namespace lazily, so warming only the
+        # anchor namespace leaves per-pool namespaces cold until first IO.
+        self._pending_mr_nsids: List[int] = []
+        self._mr_ranges: List[tuple] = []
+        # Cached node-unique GPU ordinal; populated on the main thread at
+        # pool registration time (see _local_gpu_index for why lazy
+        # resolution on IO threads is broken).
+        self._node_gpu_index: Optional[int] = None
+        # Per-pool nsid routing (pool_nsid config): explicit entries are
+        # preloaded; "auto" mode assigns pool_nsid_base+n as pools register.
+        # Lookup order in _nsid_for_pool: this map > indexer_nsid > nsid.
+        if isinstance(self.config.pool_nsid, dict):
+            self._pool_nsid_map: dict = dict(self.config.pool_nsid)
+            self._pool_nsid_auto = False
+        elif self.config.pool_nsid == "auto":
+            self._pool_nsid_map = {}
+            self._pool_nsid_auto = True
+        else:
+            self._pool_nsid_map = {}
+            self._pool_nsid_auto = False
+        self._next_auto_nsid = (
+            self.config.pool_nsid_base if self.config.pool_nsid_base else 0
+        )
+        # Guide rows for the provisioning file: pool name -> (nsid,
+        # page_bytes or None), in registration order.
+        self._pool_nsid_guide_rows: dict = {}
+        self.pynds = PyndsClient(
+            nsid=self.config.nsid,
+            timeout=self.config.timeout,
+            max_workers=self.config.pynds_workers,
+            failure_threshold=self.config.failure_threshold,
+        )
+        # Thread pool for parallel sub-batch reads inside a single
+        # _batch_get_raw call.  Zero-copy reads issue one batchGet per
+        # MAX_BATCH_SIZE chunk (the C++ two-phase submit pipelines all REQs
+        # of a call), so the pool matters when a call spans multiple chunks
+        # (e.g. generic multi-key reads); each TP rank's prefetch IO thread
+        # is otherwise serial.  Sub-batches needing the staging buffer fall
+        # back to serial execution (the staging window is reused per
+        # sub-batch).  get_io_threads=1 disables the pool.
+        self._get_io_pool: Optional[ThreadPoolExecutor] = (
+            ThreadPoolExecutor(
+                max_workers=self.config.get_io_threads,
+                thread_name_prefix="kv_get_io",
+            )
+            if self.config.get_io_threads > 1
+            else None
+        )
+        # Thread pool for per-key local-file IO (indexer_storage="file" and
+        # pool_storage file pools).  Each page is an independent file, so
+        # reads/writes parallelize cleanly across keys; host-pool page copies
+        # stay in the calling thread.  indexer_file_io_threads=1 keeps the
+        # previous serial per-key behavior.
+        self._file_io_pool: Optional[ThreadPoolExecutor] = (
+            ThreadPoolExecutor(
+                max_workers=self.config.indexer_file_io_threads,
+                thread_name_prefix="pool_file_io",
+            )
+            if self._any_file_storage_enabled()
+            and self.config.indexer_file_io_threads > 1
+            else None
+        )
+        # Unhealthy write gate state: when the pynds client is unhealthy,
+        # writes are short-circuited to fail fast; one write is let through
+        # every config.unhealthy_probe_interval seconds as a probe (see
+        # _write_allowed).  _last_probe is the monotonic timestamp of the
+        # last probe start; 0.0 makes the first gated write probe immediately.
+        self._probe_lock = Lock()
+        self._last_probe = 0.0
+        # Read circuit breaker state: reads stay ungated while failures are
+        # rare (flow-control blips must not gate MLA prefetch); after
+        # config.read_failure_threshold consecutive read failures, reads
+        # fail fast to cache miss and one read per config.read_probe_interval
+        # seconds is let through as a probe (see _read_allowed).
+        self._read_probe_lock = Lock()
+        self._last_read_probe = 0.0
+
+        # Cumulative IO stats for aggregate bandwidth reporting.  A
+        # "kv_get_total"/"kv_set_total" summary is emitted every
+        # _STATS_LOG_INTERVAL calls when SGLANG_HICACHE_KV_DEBUG_LOG is on.
+        self._stats_lock = Lock()
+        self._get_calls = 0
+        self._get_bytes = 0
+        self._get_time = 0.0
+        self._set_calls = 0
+        self._set_bytes = 0
+        self._set_time = 0.0
+        # Window stats: bytes transferred since the last summary over elapsed
+        # wall time.  With parallel sub-batch reads the sum of per-call
+        # durations exceeds wall time, so cumulative agg_bw under-reports;
+        # win_bw is the "total bytes / total wall time" figure comparable to
+        # NIC counters (per TP rank).
+        self._get_win_bytes = 0
+        self._get_win_start: Optional[float] = None
+        self._set_win_bytes = 0
+        self._set_win_start: Optional[float] = None
+        # Wall-clock timestamp of the first get/set call, for the whole-run
+        # span ("how long was the KV box busy loading in total").
+        self._get_first_ts: Optional[float] = None
+        self._set_first_ts: Optional[float] = None
+
+        # Optional local-file storage: indexer pages (indexer_storage="file")
+        # and/or pool_storage file pools are written as files under
+        # indexer_storage_path instead of the KV box, and their host buffers
+        # are not registered as NDS MRs.
+        if self._any_file_storage_enabled():
+            if self.config.indexer_storage == "file":
+                if self.config.indexer_nsid is not None:
+                    logger.warning(
+                        "indexer_storage=file: indexer_nsid=%s is ignored; "
+                        "indexer pages are stored as local files, not on the "
+                        "KV box",
+                        self.config.indexer_nsid,
+                    )
+                logger.info(
+                    "indexer pool storage: local files at %s "
+                    "(KV pool still uses NDS nsid=%d)",
+                    self.config.indexer_storage_path,
+                    self.config.nsid,
+                )
+            if self.config.pool_storage:
+                logger.info(
+                    "pool_storage file pools: %s (per-pool subdirectories "
+                    "under %s; these pools skip NDS MR registration)",
+                    sorted(self.config.pool_storage),
+                    self.config.indexer_storage_path,
+                )
+            os.makedirs(self.config.indexer_storage_path, exist_ok=True)
+
+        model_name = (
+            "-".join(storage_config.model_name.split("/"))
+            if storage_config.model_name
+            else ""
+        )
+        enable_pp = storage_config.pp_size > 1
+        self.config_suffix = f"_{model_name}"
+        if not storage_config.is_mla_model:
+            self.config_suffix += f"_{storage_config.tp_rank}_{storage_config.tp_size}"
+        if enable_pp:
+            self.config_suffix += f"_{storage_config.pp_size}_{storage_config.pp_rank}"
+
+        # One-shot guard for the post-init data-plane warmup round-trip.
+        self._warmup_done = False
+    def register_mem_pool_host(self, mem_pool_host: Any) -> None:
+        """Register the host memory pool and collect its buffer for NDS init.
+
+        NDS requires the host buffer used for RDMA to be pinned and registered
+        as a memory region. The buffer is taken from the anchor host pool's
+        ``kv_buffer`` rather than a small dummy buffer, so that every data page
+        accessed by ``batch_get`` / ``batch_set`` lies within the registered
+        region.  The actual ``pynds_kv`` init is triggered by
+        ``finalize_registration`` (called by the controller after all pools are
+        registered), with a lazy fallback on first IO.
+
+        A staging buffer is also allocated inside the host pool so that
+        non-contiguous or out-of-MR tensors can be copied into the registered
+        region before being passed to NDS.
+        """
+        super().register_mem_pool_host(mem_pool_host)
+        # Resolve and cache the node GPU ordinal now, on the scheduler main
+        # thread — pool registration runs at cache-attach time, after the
+        # model runner's set_device().  Lazy NDS init later runs on storage
+        # IO threads where torch.cuda.current_device() is thread-local 0.
+        self._local_gpu_index()
+        buffer = mem_pool_host.kv_buffer
+        if buffer is None:
+            # Logical anchor pool (e.g. the DeepSeek-V4 LogicalHostPool behind
+            # a HostPoolGroup): it manages page indices only and holds no KV
+            # tensor, so there is no anchor MR and no staging buffer to carve
+            # out here.  The real data buffers arrive via
+            # register_mem_host_pool_v2 from the sub-pools (SWA / C4 / C128 /
+            # state pools) before finalize_registration triggers NDS init.
+            anchor = getattr(mem_pool_host, "anchor_entry", None)
+            anchor_pool = getattr(anchor, "host_pool", mem_pool_host)
+            logger.info(
+                "anchor host pool %s is logical (kv_buffer=None); NDS MRs "
+                "will be collected from sub-pool registration",
+                type(anchor_pool).__name__,
+            )
+            return
+        if isinstance(buffer, torch.Tensor):
+            # The NDS memory region must cover the same physical allocation that
+            # _allocate_staging_buffer slices later. Force the host buffer to be
+            # contiguous on CPU so the MR base/size and the staging slice agree.
+            if buffer.device.type != "cpu" or not buffer.is_contiguous():
+                buffer = buffer.detach().cpu().contiguous()
+                mem_pool_host.kv_buffer = buffer
+            # Register up to the storage end so the allocation's tail padding
+            # (alloc_host_pool_buffer) is inside the MR: NDS batch-aligned read
+            # round-ups / value_size-extended writes at the pool's last page
+            # would otherwise overrun the region (find_mr_index out-of-MR).
+            padded = self._numpy_view_to_storage_end(buffer)
+            buffer = (
+                padded if padded is not None else buffer.view(torch.uint8).numpy()
+            )
+        self._mr_base = buffer.ctypes.data
+        self._mr_size = buffer.nbytes
+        self._allocate_staging_buffer(mem_pool_host)
+        # Collect the anchor buffer; actual NDS init is triggered by
+        # finalize_registration (called by the controller after all pools are
+        # registered) with a lazy fallback on first IO (_ensure_nds_initialized).
+        self._pending_mr_buffers.append(buffer)
+        self._pending_mr_nsids.append(self.config.nsid)
+        self._mr_ranges.append((buffer.ctypes.data, buffer.nbytes))
+        if envs.SGLANG_HICACHE_KV_DEBUG_LOG.get():
+            logger.info(
+                "[NDS MR] rank=%d base=%#x size=%d aligned=%s",
+                self.storage_config.tp_rank,
+                self._mr_base,
+                self._mr_size,
+                self._mr_base % 4096 == 0,
+            )
+
+    def register_mem_host_pool_v2(self, host_pool: Any, host_pool_name: Any) -> None:
+        """Register an extra host pool and collect its buffer for multi-MR init.
+
+        The anchor (KV) pool buffer is already registered through
+        ``register_mem_pool_host``.  Extra pools (e.g. the DSA indexer pool)
+        expose their data buffer via ``get_hybrid_pool_buffer``; registering
+        it as an additional NDS memory region lets indexer pages move
+        zero-copy instead of through the staging buffer.
+        """
+        super().register_mem_host_pool_v2(host_pool, host_pool_name)
+        if host_pool_name in (PoolName.KV, "kv", "__default__"):
+            return
+        if self._pool_uses_file_storage(host_pool_name):
+            # Pages go to local files; no NDS MR needed for this pool.
+            pool_dir = self._file_store_dir(host_pool_name)
+            os.makedirs(pool_dir, exist_ok=True)
+            self._check_indexer_file_format(host_pool, host_pool_name)
+            # Record a guide row (nsid=None marks file storage) so the
+            # provisioning guide still lists this pool's page size and the
+            # suggested valueSize — needed when the pool is later moved
+            # back onto the box via pool_nsid.
+            name = _pool_name_str(host_pool_name)
+            if name not in self._pool_nsid_guide_rows:
+                self._pool_nsid_guide_rows[name] = (
+                    None,
+                    self._pool_page_bytes(host_pool),
+                    self._pool_host_bytes(host_pool),
+                    getattr(host_pool, "size_per_token", None),
+                )
+            logger.info(
+                "host pool %s uses local file storage at %s; "
+                "skipping NDS MR registration",
+                host_pool_name,
+                pool_dir,
+            )
+            return
+        # The pool uses NDS; route its keys to a per-pool namespace when
+        # pool_nsid is configured (explicit dict or auto assignment).
+        self._assign_pool_nsid(host_pool_name, host_pool)
+        get_buffers = getattr(host_pool, "get_hybrid_pool_buffer", None)
+        if get_buffers is None:
+            return
+        if self._nds_init_done:
+            logger.warning(
+                "host pool %s registered after NDS init; its buffer will use "
+                "staging copies",
+                host_pool_name,
+            )
+            return
+        for buf in get_buffers() or []:
+            # Register up to the storage end (tail padding included) so NDS
+            # batch-aligned round-ups at the pool's last page stay in-MR.
+            np_buf = self._numpy_view_to_storage_end(buf)
+            if np_buf is None:
+                logger.warning(
+                    "host pool %s buffer is not a contiguous CPU buffer; "
+                    "it will use staging copies",
+                    host_pool_name,
+                )
+                continue
+            if np_buf.ctypes.data % 4096 != 0:
+                logger.warning(
+                    "host pool %s buffer base=%#x is not page-aligned; "
+                    "skipping MR registration (will use staging copies). "
+                    "Root cause: DSAIndexerPoolHost bypasses the 4K alignment "
+                    "in HostKVCache.__init__.",
+                    host_pool_name,
+                    np_buf.ctypes.data,
+                )
+                continue
+            self._pending_mr_buffers.append(np_buf)
+            self._pending_mr_nsids.append(self._nsid_for_pool(host_pool_name))
+            self._mr_ranges.append((np_buf.ctypes.data, np_buf.nbytes))
+            logger.info(
+                "[NDS MR] rank=%d collected %s pool buffer base=%#x size=%d "
+                "for multi-MR init",
+                self.storage_config.tp_rank,
+                host_pool_name,
+                np_buf.ctypes.data,
+                np_buf.nbytes,
+            )
+
+    @staticmethod
+    def _as_numpy_uint8(buffer: Any) -> Optional[np.ndarray]:
+        """Convert a host pool buffer to a contiguous uint8 numpy view.
+
+        Returns None when the buffer cannot be viewed as one contiguous CPU
+        region.  Unlike the anchor registration path this never reallocates or
+        writes back: extra pool buffers are owned by their pools, so a
+        non-viewable buffer simply stays out of the MR set (staging path).
+        """
+        if isinstance(buffer, torch.Tensor):
+            if buffer.device.type != "cpu" or not buffer.is_contiguous():
+                return None
+            return buffer.view(torch.uint8).numpy()
+        if isinstance(buffer, np.ndarray):
+            if not buffer.flags["C_CONTIGUOUS"]:
+                return None
+            return buffer.view(np.uint8).reshape(-1)
+        return None
+
+    @staticmethod
+    def _numpy_view_to_storage_end(buffer: Any) -> Optional[np.ndarray]:
+        """Flat uint8 numpy view spanning [buffer.data_ptr(), storage end).
+
+        Host pool buffers are allocated with tail padding beyond the tensor
+        view (see ``alloc_host_pool_buffer`` in memory_pool_host.py): NDS IO
+        rounds the last batch segment of a non-aligned page UP and extends
+        short writes to value_size, both of which would otherwise run past the
+        MR at the pool's last page (find_mr_index "data range outside
+        registered MRs").  Registering up to the storage end keeps those
+        round-ups inside the MR.  Buffers without tail padding (or already
+        plain numpy arrays) simply yield a view of their own extent, identical
+        to ``_as_numpy_uint8``.
+        """
+        if isinstance(buffer, torch.Tensor):
+            if buffer.device.type != "cpu" or not buffer.is_contiguous():
+                return None
+            storage = buffer.untyped_storage()
+            base = buffer.data_ptr()
+            length = storage.data_ptr() + storage.nbytes() - base
+            if length <= 0:
+                return None
+            flat = torch.empty(0, dtype=torch.uint8).set_(
+                storage, base - storage.data_ptr(), (length,)
+            )
+            return flat.numpy()
+        if isinstance(buffer, np.ndarray):
+            if not buffer.flags["C_CONTIGUOUS"]:
+                return None
+            return buffer.view(np.uint8).reshape(-1)
+        return None
+
+    def finalize_registration(self) -> None:
+        """Trigger NDS init after all host pools are registered.
+
+        Called by the cache controller once every pool buffer (anchor + extra)
+        has been collected via ``register_mem_pool_host`` /
+        ``register_mem_host_pool_v2``.  If the NDS box is unreachable, the
+        failure is logged but **not** propagated: the server still starts, and
+        IO calls degrade to cache miss via the existing unhealthy path.  This
+        preserves the startup-fault-tolerance of the old lazy-init design.
+        """
+        # Typo guard for explicit pool_nsid dicts: entries whose key never
+        # matched a registered pool name are silently useless otherwise.
+        if isinstance(self.config.pool_nsid, dict):
+            registered = {
+                _pool_name_str(n) for n in getattr(self, "registered_pools", {})
+            }
+            unmatched = [k for k in self.config.pool_nsid if k not in registered]
+            if unmatched:
+                logger.warning(
+                    "pool_nsid entries %s did not match any registered host "
+                    "pool (registered: %s); check for typos — these pools "
+                    "will use nsid=%d",
+                    unmatched,
+                    sorted(registered),
+                    self.config.nsid,
+                )
+        # Single-file provisioning reference (interleaved multi-process logs
+        # are hard to read); written by the rank-0 process only.
+        self._write_pool_nsid_guide()
+        try:
+            self._ensure_nds_initialized()
+        except Exception as e:
+            logger.error(
+                "NDS init at startup failed; backend will degrade to cache "
+                "miss until recovery: %s",
+                e,
+            )
+
+    def _ensure_nds_initialized(self) -> None:
+        """Register all collected pool buffers as NDS memory regions (once).
+
+        Called eagerly by ``finalize_registration`` at startup (after all
+        pools are registered) and as a lazy fallback from IO paths.  When the
+        underlying pynds_kv build cannot register all buffers, it falls back
+        to the anchor buffer only and the remaining pools keep using staging
+        copies (see ``init_once_multi``).
+        """
+        if self._nds_init_done:
+            return
+        with self._nds_init_lock:
+            if self._nds_init_done:
+                return
+            # Optional rank-staggered init (SGLANG_HICACHE_KV_INIT_STAGGER_S,
+            # seconds per rank, default 0 = no stagger) reduces contention
+            # during concurrent connection setup. Key it off the node-unique
+            # GPU ordinal, not tp_rank: under DP attention every scheduler
+            # has attn tp_rank == 0.
+            stagger = float(
+                os.environ.get("SGLANG_HICACHE_KV_INIT_STAGGER_S", "0")
+            )
+            if stagger > 0:
+                stagger_rank = self._local_gpu_index()
+                if stagger_rank > 0:
+                    delay = stagger * stagger_rank
+                    logger.info(
+                        "NDS init stagger: gpu index %d waiting %.1fs before init",
+                        stagger_rank,
+                        delay,
+                    )
+                    time.sleep(delay)
+            # Optional per-process start_core shift (nds_core_stride > 0 or
+            # "auto"): the vendor SDK pins its internal IO threads from
+            # start_core in nds_config.conf, and every process reads the
+            # same file, so all processes pile onto the same cores.  One
+            # GPU == one scheduler process for TP, PP, and DP alike, so the
+            # shift is keyed off the process's CUDA device ordinal — unique
+            # per process on the node (tp_rank alone would repeat across PP
+            # stages / DP replicas).
+            #
+            # NUMA-aware placement is preferred: the rank's core window is
+            # placed inside its GPU's NUMA node, keeping the SDK threads on
+            # the same node as the GPU (and typically the RDMA NIC's PCIe
+            # attachment).  This is also *required* when SGLANG_NUMA_BIND_V2
+            # numactl-confines the process to that node — an SDK
+            # pthread_setaffinity to cores outside the bind mask would fail
+            # and the threads would float unbound.  With "auto" the stride
+            # is derived from the node's affinity-visible physical core
+            # count divided by its GPU count, so no manual sizing is
+            # needed.  When the topology cannot be queried: manual stride
+            # falls back to the legacy global linear offset; "auto" passes
+            # the base conf through unchanged (no sane window exists).
+            nds_config_path = self.config.nds_config_path
+            stride_cfg = self.config.nds_core_stride
+            if stride_cfg:
+                gpu_index = self._local_gpu_index()
+                absolute_core = numa_local_start_core(gpu_index, stride_cfg)
+                if absolute_core is not None:
+                    nds_config_path = materialize_per_rank_nds_config_absolute(
+                        nds_config_path, absolute_core
+                    )
+                elif stride_cfg == "auto":
+                    logger.warning(
+                        "nds_core_stride=auto but NUMA topology unavailable; "
+                        "using the shared base conf (start_core unchanged)"
+                    )
+                else:
+                    core_offset = gpu_index * stride_cfg
+                    nds_config_path = materialize_per_rank_nds_config(
+                        nds_config_path, core_offset
+                    )
+            registered = init_once_multi(
+                list(self._pending_mr_buffers),
+                nds_config_path,
+                timeout=self.config.timeout,
+            )
+            if registered < len(self._mr_ranges):
+                if self._staging_buffer is None or self._staging_size == 0:
+                    # No staging buffer (e.g. the DeepSeek-V4 logical-anchor
+                    # stack): pools past the registered prefix have no safe IO
+                    # path because unregistered memory cannot be used for NDS
+                    # transfers. Refuse to come up: finalize_registration and
+                    # the lazy IO paths catch this and degrade to cache miss.
+                    raise RuntimeError(
+                        f"NDS registered only {registered} of "
+                        f"{len(self._mr_ranges)} host buffers and no staging "
+                        f"buffer is available (logical anchor); refusing to "
+                        f"run IO against unregistered pool memory"
+                    )
+                logger.warning(
+                    "NDS registered %d of %d host buffers; the remaining "
+                    "pools will use staging copies",
+                    registered,
+                    len(self._mr_ranges),
+                )
+                self._mr_ranges = self._mr_ranges[:registered]
+                # Keep the pending lists in sync with reality so later
+                # consumers (e.g. _warmup_buffer) never pick a buffer whose
+                # MR registration failed.
+                self._pending_mr_buffers = self._pending_mr_buffers[:registered]
+                self._pending_mr_nsids = self._pending_mr_nsids[:registered]
+            self._nds_init_done = True
+            # Data-plane smoke test right after init (see _warmup_nds_io).
+            # Warmup failures must not escape: they are logged and the
+            # backend degrades to cache miss via the health tracking.
+            try:
+                self._warmup_nds_io()
+            except Exception as e:
+                logger.error(
+                    "NDS warmup IO failed on rank %d: %s",
+                    self.storage_config.tp_rank,
+                    e,
+                )
+
+    # Warmup block_id base: high 48 bits all-ones keeps it clear of
+    # encode_block_id outputs (tp_rank<<64 | sha256-truncated), the low 16
+    # bits carry tp_rank * 1024 + a per-MR sequence number so concurrent
+    # rank warmups never share a key (tp_size <= 64; per-MR sequences stay
+    # < 1024 for any realistic warmup_io_keys, otherwise warmup truncates
+    # with a warning).  Ids may repeat across MRs, which is harmless: each
+    # MR round targets its pool's own namespace, and even for pools sharing
+    # one nsid the pattern is deterministic and the box does not overwrite
+    # existing keys, so the round-trip still verifies.  Stays < 2^64 so
+    # older 64-bit pynds_kv builds also accept it.
+    _WARMUP_BLOCK_ID_BASE = 0xFFFFFFFFFFFF0000
+
+    def _warmup_nds_io(self) -> None:
+        """Real batch_put/batch_get round-trips right after NDS init.
+
+        Data-plane smoke test: init success and is_exists only exercise the
+        control path, so round-trips verify MR registration, RDMA connection
+        setup and scatter IO before the first serving request.
+
+        Uses ``warmup_io_keys`` keys per MR to establish each hash-ring
+        endpoint's lazy RDMA connection before concurrent serving IO starts.
+        Every registered MR gets its own round-trip because the vendor client
+        also creates per-MR data channels lazily.
+
+        Each key round-trips 1 MiB; the wrapper pads shorter writes to the
+        full slot and reads return the leading bytes. Each MR round uses its
+        pool's own namespace so per-pool connections are warmed as well.
+        """
+        if not self.config.warmup_io_on_init or self._warmup_done:
+            return
+        self._warmup_done = True
+        nkeys = self.config.warmup_io_keys
+        length = 1 << 20
+        # Key-identity rank: the node-unique GPU ordinal, not tp_rank —
+        # under DP attention attn tp_rank is 0 in every scheduler, which
+        # made all ranks warm up the same block_ids concurrently.
+        rank = self._local_gpu_index()
+        pattern = ((np.arange(length, dtype=np.uint32) % 251) + 1).astype(np.uint8)
+
+        # One warmup round per (registered MR buffer, pool nsid) pair (flat
+        # byte views; all collected buffers are contiguous by construction).
+        # _pending_mr_nsids is appended alongside _pending_mr_buffers at
+        # registration and trimmed with it after partial init, so the lists
+        # stay in lockstep; zip is safe.  Falls back to the legacy single
+        # staging/pool buffer (anchor nsid) when the MR list is empty.
+        mr_rounds = [
+            (b.reshape(-1), nsid)
+            for b, nsid in zip(self._pending_mr_buffers, self._pending_mr_nsids)
+            if b.size >= length
+        ]
+        if not mr_rounds:
+            buf = self._warmup_buffer(nkeys * length)
+            if buf is not None:
+                mr_rounds = [(buf, self.config.nsid)]
+        if not mr_rounds:
+            logger.warning(
+                "NDS warmup skipped on rank %d: no registered buffer with "
+                "%d bytes available",
+                rank,
+                length,
+            )
+            return
+
+        # Per-key ids: tp_rank * 1024 + seq in the low bits, seq local to
+        # each MR round.  With tp_size <= 64 the rank offset keeps concurrent
+        # rank warmups on disjoint keys; within a rank, ids repeat across
+        # MRs, which is harmless (deterministic pattern, namespaces usually
+        # differ, and the box does not overwrite existing keys anyway).
+        total_bytes = 0
+        total_keys = 0
+        for mr_idx, (buf, nsid) in enumerate(mr_rounds):
+            keys_for_buf = min(nkeys, buf.size // length)
+            if keys_for_buf <= 0:
+                continue
+            if keys_for_buf > 1024:
+                logger.warning(
+                    "NDS warmup key-id budget exceeded on rank %d; warming "
+                    "only 1024 keys for MR %d/%d",
+                    rank,
+                    mr_idx,
+                    len(mr_rounds),
+                )
+                keys_for_buf = 1024
+            logger.info(
+                "NDS warmup MR %d/%d on rank %d: %d keys x %d bytes nsid=%d",
+                mr_idx,
+                len(mr_rounds),
+                rank,
+                keys_for_buf,
+                length,
+                nsid,
+            )
+            block_ids = [
+                self._WARMUP_BLOCK_ID_BASE | (rank * 1024 + i)
+                for i in range(keys_for_buf)
+            ]
+            buffers = [buf[i * length : (i + 1) * length] for i in range(keys_for_buf)]
+            offsets = [0] * keys_for_buf
+            lengths = [length] * keys_for_buf
+            nsids = [nsid] * keys_for_buf
+            for b in buffers:
+                b[:] = pattern
+            ret = self.pynds.batch_put(block_ids, buffers, offsets, lengths, nsids)
+            if ret != 0:
+                raise RuntimeError(f"warmup batch_put returned {ret}")
+            for b in buffers:
+                b[:] = 0
+            ret = self.pynds.batch_get(block_ids, buffers, offsets, lengths, nsids)
+            if ret != 0:
+                raise RuntimeError(f"warmup batch_get returned {ret}")
+            for i, b in enumerate(buffers):
+                if not np.array_equal(b, pattern):
+                    raise RuntimeError(f"warmup round-trip data mismatch at key {i}")
+            total_bytes += keys_for_buf * length
+            total_keys += keys_for_buf
+        logger.info(
+            "NDS warmup IO ok: rank=%d round-tripped %d bytes in %d keys "
+            "across %d MRs nsids=%s",
+            rank,
+            total_bytes,
+            total_keys,
+            len(mr_rounds),
+            sorted({nsid for _, nsid in mr_rounds}),
+        )
+
+    def _warmup_buffer(self, length: int) -> Optional[np.ndarray]:
+        """Pick a registered-MR scratch buffer of at least ``length`` bytes.
+
+        Preference order: the host-pool staging buffer, then the host pool
+        base.  (The shm staging segment preference from the read-sharing
+        branch does not exist on this branch.)
+
+        The warmup slices the returned buffer by byte count, so every branch
+        must return a **flat 1-D** view: pool buffers are collected as
+        multi-dim numpy arrays (e.g. (pages, layers, 1, item_bytes)), and
+        slicing a multi-dim array along axis 0 does not yield byte ranges.
+        All collected buffers are contiguous (enforced at registration), so
+        ``reshape(-1)`` is a zero-copy view.
+        """
+        if self._staging_buffer is not None and self._staging_size >= length:
+            return self._staging_buffer[:length]
+        pool = self.mem_pool_host
+        kv_buffer = getattr(pool, "kv_buffer", None) if pool is not None else None
+        arr = self._as_numpy_uint8(kv_buffer) if kv_buffer is not None else None
+        if arr is not None and arr.size >= length:
+            return arr.reshape(-1)[:length]
+        # Logical-anchor stacks (e.g. DeepSeek-V4) have no anchor buffer;
+        # fall back to the largest sub-pool buffer collected for NDS init.
+        candidates = [
+            b.reshape(-1) for b in self._pending_mr_buffers if b.size >= length
+        ]
+        if candidates:
+            return max(candidates, key=lambda b: b.size)[:length]
+        return None
+
+    def _local_gpu_index(self) -> int:
+        """Ordinal of the GPU this scheduler process owns on the local node.
+
+        One GPU == one process for TP, PP, and DP deployments alike, so the
+        CUDA device ordinal is unique per NDS-initializing process and is the
+        natural key for per-process resources such as NDS ``start_core``
+        ranges.  Falls back to ``tp_rank`` (with a warning) when CUDA is
+        unavailable, e.g. CPU-only test environments.
+
+        The result is cached from the first call.  The first call happens on
+        the scheduler main thread (pool registration / finalize at startup),
+        where ``torch.cuda.current_device()`` reflects the model runner's
+        ``set_device(gpu_id)``.  This matters because PyTorch's current
+        device is **thread-local**: the lazy NDS init path runs on storage
+        IO threads which never called ``set_device`` and therefore may all
+        report device 0. Cache the node-local GPU ordinal on the main thread
+        so every rank uses a distinct per-process NDS configuration.
+        """
+        if self._node_gpu_index is not None:
+            return self._node_gpu_index
+        index: Optional[int] = None
+        try:
+            if torch.cuda.is_available():
+                index = torch.cuda.current_device()
+        except Exception:
+            index = None
+        if index is None:
+            logger.warning(
+                "CUDA unavailable; falling back to tp_rank=%d for NDS core "
+                "offset",
+                self.storage_config.tp_rank,
+            )
+            index = self.storage_config.tp_rank
+        self._node_gpu_index = index
+        return index
+
+    def _get_suffixed_key(self, key: str) -> str:
+        """Return the key with the model/tp/pp suffix appended."""
+        return key + self.config_suffix
+
+    def _get_component_key(self, key: str, component_name: Optional[str] = None) -> str:
+        """Return the suffixed key for a pool component.
+
+        The KV component uses the bare suffixed key; extra pools use
+        ``{key}.{component_name}`` with the model/tp/pp suffix appended so they
+        do not collide with KV block_ids or with each other.
+        """
+        if component_name is None or component_name in ("__default__", "kv", PoolName.KV):
+            return self._get_suffixed_key(key)
+        return self._get_suffixed_key(f"{key}.{component_name}")
+
+    def _hash_keys_to_block_ids(self, keys: List[str]) -> List[int]:
+        """Convert SGLang hash keys into NDS block_ids."""
+        return [
+            encode_block_id(self._get_suffixed_key(key), self._key_rank)
+            for key in keys
+        ]
+
+    def _allocate_staging_buffer(self, mem_pool_host: Any) -> None:
+        """Allocate a contiguous staging buffer inside the registered host pool MR.
+
+        The staging buffer is used for NDS operations whose source/target tensors
+        are not contiguous or fall outside the registered MR.
+        """
+        size_per_token = getattr(mem_pool_host, "size_per_token", 0)
+        page_size = getattr(mem_pool_host, "page_size", 1)
+        if size_per_token <= 0 or page_size <= 0:
+            self._staging_buffer = None
+            self._staging_size = 0
+            return
+
+        staging_size_mb = int(
+            os.environ.get(
+                "SGLANG_HICACHE_KV_STAGING_SIZE_MB", str(STAGING_SIZE_MB_DEFAULT)
+            )
+        )
+        if staging_size_mb <= 0:
+            self._staging_buffer = None
+            self._staging_size = 0
+            return
+
+        page_bytes = page_size * size_per_token
+        staging_bytes = staging_size_mb * 1024 * 1024
+        staging_pages = max(1, (staging_bytes + page_bytes - 1) // page_bytes)
+        staging_tokens = staging_pages * page_size
+
+        alloc = getattr(mem_pool_host, "alloc", None)
+        if alloc is None:
+            self._staging_buffer = None
+            self._staging_size = 0
+            return
+
+        staging_indices = alloc(staging_tokens)
+        if staging_indices is None:
+            raise RuntimeError(
+                f"Failed to allocate {staging_pages} staging pages from host pool"
+            )
+
+        kv_bytes = mem_pool_host.kv_buffer
+        if isinstance(kv_bytes, torch.Tensor):
+            kv_bytes = kv_bytes.detach().cpu().contiguous().view(torch.uint8).reshape(-1)
+        else:
+            kv_bytes = torch.from_numpy(kv_bytes).view(torch.uint8).reshape(-1)
+        staging_start_byte = int(staging_indices[0].item()) * size_per_token
+        staging_end_byte = staging_start_byte + staging_pages * page_bytes
+        self._staging_buffer = kv_bytes[staging_start_byte:staging_end_byte].numpy()
+        self._staging_size = staging_end_byte - staging_start_byte
+        if envs.SGLANG_HICACHE_KV_DEBUG_LOG.get():
+            logger.info(
+                "[NDS MR] rank=%d staging=%#x size=%d pages=%d",
+                self.storage_config.tp_rank,
+                self._staging_buffer.ctypes.data,
+                self._staging_size,
+                staging_pages,
+            )
+
+    def _tensor_needs_staging(self, tensor: torch.Tensor) -> bool:
+        """Return True if the tensor is not contiguous or not inside any registered MR."""
+        if not tensor.is_contiguous():
+            return True
+        ranges = self._mr_ranges
+        if not ranges:
+            mr_base = getattr(self, "_mr_base", None)
+            mr_size = getattr(self, "_mr_size", None)
+            if mr_base is None or mr_size is None or mr_size == 0:
+                return True
+            ranges = [(mr_base, mr_size)]
+        buf = tensor.detach().cpu().view(torch.uint8).numpy()
+        addr = buf.ctypes.data
+        end = addr + buf.nbytes
+        for base, size in ranges:
+            if addr >= base and end <= base + size:
+                return False
+        return True
+
+    def _prepare_set_buffers(
+        self, values: List[torch.Tensor]
+    ) -> tuple[List[np.ndarray], List[int]]:
+        """Return numpy buffers and lengths for pynds_kv.batch_put.
+
+        Tensors that are not contiguous or fall outside the registered MR are
+        copied into the staging buffer so that NDS receives valid addresses.
+        """
+        if self._staging_buffer is None or self._staging_size == 0:
+            lengths = []
+            buffers = []
+            for tensor in values:
+                tensor = self._cpu_tensor(tensor).contiguous()
+                contiguous = tensor.view(torch.uint8)
+                buffers.append(contiguous.numpy())
+                lengths.append(contiguous.numel())
+            return buffers, lengths
+
+        needs_staging = [self._tensor_needs_staging(v) for v in values]
+        if not any(needs_staging):
+            lengths = []
+            buffers = []
+            for tensor in values:
+                tensor = self._cpu_tensor(tensor)
+                contiguous = tensor.view(torch.uint8)
+                buffers.append(contiguous.numpy())
+                lengths.append(contiguous.numel())
+            return buffers, lengths
+
+        lengths = [v.numel() * v.element_size() for v in values]
+        total_length = sum(lengths)
+        if total_length > self._staging_size:
+            raise RuntimeError(
+                f"Staging buffer too small: need {total_length}, "
+                f"have {self._staging_size}"
+            )
+
+        offset = 0
+        for tensor, length in zip(values, lengths):
+            staging_slice = self._staging_buffer[offset : offset + length]
+            torch.from_numpy(staging_slice).copy_(
+                self._cpu_tensor(tensor).contiguous().view(torch.uint8).reshape(-1)
+            )
+            offset += length
+
+        offset = 0
+        buffers = []
+        for length in lengths:
+            buffers.append(self._staging_buffer[offset : offset + length])
+            offset += length
+        return buffers, lengths
+
+    def _prepare_get_buffers(
+        self, targets: List[torch.Tensor]
+    ) -> tuple[List[np.ndarray], List[int], List[torch.Tensor]]:
+        """Return numpy buffers, lengths, and tracked targets for pynds_kv.batch_get.
+
+        Targets that are not contiguous or outside the registered MR are backed
+        by the staging buffer.  The returned target list must be passed to
+        ``_finalize_get_buffers`` after ``batch_get`` to copy staging data back.
+        """
+        if self._staging_buffer is None or self._staging_size == 0:
+            lengths = []
+            buffers = []
+            tracked = []
+            for tensor in targets:
+                cpu_tensor = self._cpu_tensor(tensor).contiguous()
+                contiguous = cpu_tensor.view(torch.uint8)
+                buffers.append(contiguous.numpy())
+                lengths.append(contiguous.numel())
+                tracked.append(cpu_tensor)
+            return buffers, lengths, tracked
+
+        needs_staging = [self._tensor_needs_staging(t) for t in targets]
+        lengths = [t.numel() * t.element_size() for t in targets]
+
+        if not any(needs_staging):
+            buffers = []
+            tracked = []
+            for tensor in targets:
+                cpu_tensor = self._cpu_tensor(tensor)
+                contiguous = cpu_tensor.view(torch.uint8)
+                buffers.append(contiguous.numpy())
+                tracked.append(cpu_tensor)
+            return buffers, lengths, tracked
+
+        total_length = sum(lengths)
+        if total_length > self._staging_size:
+            raise RuntimeError(
+                f"Staging buffer too small: need {total_length}, "
+                f"have {self._staging_size}"
+            )
+
+        buffers = []
+        offset = 0
+        for length in lengths:
+            buffers.append(self._staging_buffer[offset : offset + length])
+            offset += length
+        return buffers, lengths, targets
+
+    def _finalize_get_buffers(
+        self,
+        targets: List[torch.Tensor],
+        lengths: List[int],
+        use_staging: bool,
+    ) -> List[torch.Tensor]:
+        """Copy data from staging back to the original targets if necessary."""
+        if not use_staging:
+            return [t.view(t.dtype).reshape(t.shape) for t in targets]
+
+        results: List[torch.Tensor] = []
+        offset = 0
+        for tensor, length in zip(targets, lengths):
+            staging_slice = self._staging_buffer[offset : offset + length]
+            cpu_tensor = self._cpu_tensor(tensor).contiguous()
+            cpu_bytes = cpu_tensor.view(torch.uint8).reshape(-1)
+            cpu_bytes.copy_(torch.from_numpy(staging_slice))
+            results.append(cpu_tensor.view(tensor.dtype).reshape(tensor.shape))
+            offset += length
+        return results
+
+    def _cpu_tensor(self, tensor: torch.Tensor) -> torch.Tensor:
+        """Ensure a tensor is on CPU before converting to numpy."""
+        if tensor.device.type != "cpu":
+            tensor = tensor.cpu()
+        return tensor
+
+    def _kv_split_enabled(self, pool: Optional[Any] = None) -> bool:
+        """Return True when the pool is an MHA pool in a page-first layout.
+
+        MHA host pools fuse K and V into a single buffer whose leading dim is
+        2, so any page sliced from it is non-contiguous.  In page-first
+        layouts, however, ``k_buffer`` and ``v_buffer`` are each contiguous
+        sub-buffers, and a page sliced from either one stays contiguous and
+        inside the registered MR.  In that case every page is stored as two
+        NDS keys ("<key>.k" / "<key>.v") instead of one.
+        """
+        pool = self.mem_pool_host if pool is None else pool
+        if pool is None:
+            return False
+        if getattr(pool, "layout", None) not in _PAGE_FIRST_LAYOUTS:
+            return False
+        return isinstance(getattr(pool, "k_buffer", None), torch.Tensor) and isinstance(
+            getattr(pool, "v_buffer", None), torch.Tensor
+        )
+
+    def _kv_page_views(self, index: int, pool: Optional[Any] = None) -> Optional[list]:
+        """Return (suffix, view) pairs covering one page, all contiguous + in-MR.
+
+        For MHA page-first pools this is the K and V half-page views carved
+        directly out of the registered host pool buffer.  For single-buffer
+        pools (e.g. MLA) in page-first layouts it is the whole-page view.
+        Returns None when no zero-copy view is available for the page.
+        """
+        pool = self.mem_pool_host if pool is None else pool
+        if pool is None or getattr(pool, "layout", None) not in _PAGE_FIRST_LAYOUTS:
+            return None
+        page_size = getattr(pool, "page_size", 1) or 1
+        if self._kv_split_enabled(pool):
+            if pool.layout == "page_first":
+                views = [
+                    (".k", pool.k_buffer[index : index + page_size]),
+                    (".v", pool.v_buffer[index : index + page_size]),
+                ]
+            else:  # page_first_direct: index is a token index, dim 0 is pages
+                real_index = index // page_size
+                views = [
+                    (".k", pool.k_buffer[real_index : real_index + 1]),
+                    (".v", pool.v_buffer[real_index : real_index + 1]),
+                ]
+        else:
+            get_data_page = getattr(pool, "get_data_page", None)
+            if get_data_page is None:
+                return None
+            try:
+                views = [("", get_data_page(index, flat=True))]
+            except Exception:
+                return None
+        if any(self._tensor_needs_staging(view) for _, view in views):
+            return None
+        return views
+
+    def _split_flat_tensor(self, tensor: torch.Tensor) -> List[torch.Tensor]:
+        """Split a flat MHA page into its K and V byte halves.
+
+        The flat layout of an MHA page is always the K part followed by the V
+        part, regardless of the host pool layout.  For a contiguous input the
+        halves are views into the same memory.
+        """
+        flat = self._cpu_tensor(tensor).contiguous().view(torch.uint8).reshape(-1)
+        half = flat.numel() // 2
+        return [flat[:half], flat[half:]]
+
+    def _set_kv_pages(
+        self,
+        suffixed_keys: List[str],
+        page_starts: List[int],
+        host_pool: Any,
+    ) -> bool:
+        """Store KV-pool pages, zero-copy via in-MR views when possible.
+
+        Key encoding must stay consistent with ``batch_exists``: MHA
+        page-first pools store each page as "<key>.k" + "<key>.v", everything
+        else stores the bare suffixed key.
+        """
+        views_per_key = [self._kv_page_views(s, host_pool) for s in page_starts]
+        if all(views is not None for views in views_per_key):
+            flat_keys: List[str] = []
+            flat_values: List[torch.Tensor] = []
+            for sk, views in zip(suffixed_keys, views_per_key):
+                flat_keys.extend(sk + suffix for suffix, _ in views)
+                flat_values.extend(view for _, view in views)
+            return self._batch_set_raw(flat_keys, flat_values)
+
+        # Fallback: materialize flat pages and let the staging path handle
+        # out-of-MR / non-contiguous buffers.  In split mode the flat page is
+        # still stored as K/V halves to keep the keyspace consistent.
+        values = [
+            host_pool.get_data_page(start, flat=True) for start in page_starts
+        ]
+        if self._kv_split_enabled(host_pool):
+            flat_keys = []
+            flat_values = []
+            for sk, value in zip(suffixed_keys, values):
+                for suffix, part in zip(
+                    _KV_SPLIT_SUFFIXES, self._split_flat_tensor(value)
+                ):
+                    flat_keys.append(sk + suffix)
+                    flat_values.append(part)
+            return self._batch_set_raw(flat_keys, flat_values)
+        return self._batch_set_raw(suffixed_keys, values)
+
+    def _get_kv_pages(
+        self,
+        suffixed_keys: List[str],
+        page_starts: List[int],
+        host_pool: Any,
+    ) -> List[bool]:
+        """Load KV-pool pages into the host pool, zero-copy when possible."""
+        views_per_key = [self._kv_page_views(s, host_pool) for s in page_starts]
+        if all(views is not None for views in views_per_key):
+            flat_keys: List[str] = []
+            flat_targets: List[torch.Tensor] = []
+            spans: List[int] = []
+            for sk, views in zip(suffixed_keys, views_per_key):
+                spans.append(len(views))
+                for suffix, view in views:
+                    flat_keys.append(sk + suffix)
+                    flat_targets.append(view)
+            fetched = self._batch_get_raw(flat_keys, flat_targets)
+            # Views were written in place; the data is already in the pool.
+            results: List[bool] = []
+            pos = 0
+            for span in spans:
+                results.append(all(f is not None for f in fetched[pos : pos + span]))
+                pos += span
+            return results
+
+        # Fallback: read into flat pages, then copy back into the pool.
+        targets = [
+            host_pool.get_data_page(start, flat=True) for start in page_starts
+        ]
+        if self._kv_split_enabled(host_pool):
+            flat_keys = []
+            flat_targets = []
+            for sk, target in zip(suffixed_keys, targets):
+                for suffix, part in zip(
+                    _KV_SPLIT_SUFFIXES, self._split_flat_tensor(target)
+                ):
+                    flat_keys.append(sk + suffix)
+                    flat_targets.append(part)
+            fetched = self._batch_get_raw(flat_keys, flat_targets)
+            results = []
+            for i, target in enumerate(targets):
+                parts = fetched[2 * i : 2 * i + 2]
+                ok = all(p is not None for p in parts)
+                if ok:
+                    host_pool.set_from_flat_data_page(page_starts[i], target)
+                results.append(ok)
+            return results
+
+        fetched = self._batch_get_raw(suffixed_keys, targets)
+        results = []
+        for i, res in enumerate(fetched):
+            if res is None:
+                results.append(False)
+                continue
+            host_pool.set_from_flat_data_page(page_starts[i], res)
+            results.append(True)
+        return results
+
+    def _check_mr(
+        self, label: str, buffers: List[np.ndarray], lengths: List[int]
+    ) -> None:
+        """Log whether the buffers are inside the NDS-registered memory region.
+
+        This is a diagnostic helper to detect unregistered host buffers that
+        would cause NDS RDMA "Work Request Flushed Error".
+        """
+        if not envs.SGLANG_HICACHE_KV_DEBUG_LOG.get():
+            return
+        ranges = self._mr_ranges
+        if not ranges:
+            mr_base = getattr(self, "_mr_base", None)
+            mr_size = getattr(self, "_mr_size", None)
+            if mr_base is None or mr_size is None:
+                logger.warning("[NDS MR] %s called before register_mem_pool_host", label)
+                return
+            ranges = [(mr_base, mr_size)]
+        for i, (buf, length) in enumerate(zip(buffers, lengths)):
+            addr = buf.ctypes.data
+            end = addr + length
+            in_mr = any(
+                addr >= base and end <= base + size for base, size in ranges
+            )
+            if not in_mr or length < 0:
+                logger.error(
+                    "[NDS MR OOB] %s rank=%d buf[%d] addr=%#x-%#x length=%d MRs=%s",
+                    label,
+                    self.storage_config.tp_rank,
+                    i,
+                    addr,
+                    end,
+                    length,
+                    [(hex(b), hex(b + s)) for b, s in ranges],
+                )
+            else:
+                logger.info(
+                    "[NDS MR OK] %s rank=%d buf[%d] addr=%#x-%#x length=%d",
+                    label,
+                    self.storage_config.tp_rank,
+                    i,
+                    addr,
+                    end,
+                    length,
+                )
+
+    def close(self) -> None:
+        """Shut down the IO pools and the pynds client."""
+        if self._get_io_pool is not None:
+            self._get_io_pool.shutdown(wait=True)
+            self._get_io_pool = None
+        if self._file_io_pool is not None:
+            self._file_io_pool.shutdown(wait=True)
+            self._file_io_pool = None
+        self.pynds.close()
+
+    def _assign_pool_nsid(self, host_pool_name: Any, host_pool: Any) -> None:
+        """Assign a per-pool NDS namespace under ``pool_nsid`` routing.
+
+        Explicit dict entries are preloaded in ``__init__``; here we only
+        handle ``"auto"`` mode, which assigns ``pool_nsid_base + n`` in
+        registration order while skipping values already reserved by
+        ``nsid`` / ``indexer_nsid`` / earlier assignments.  The assignment is
+        logged together with the pool's page size so the box-side namespace
+        (and its valueSize) can be provisioned from the log output alone —
+        the operator never has to know the model's pool names up front.
+        """
+        name = _pool_name_str(host_pool_name)
+        if name in self._pool_nsid_map:
+            # Explicit dict entry (preloaded) or an already-assigned auto
+            # entry: just record the guide row once.
+            if name not in self._pool_nsid_guide_rows:
+                self._pool_nsid_guide_rows[name] = (
+                    self._pool_nsid_map[name],
+                    self._pool_page_bytes(host_pool),
+                    self._pool_host_bytes(host_pool),
+                    getattr(host_pool, "size_per_token", None),
+                )
+            return
+        if not self._pool_nsid_auto:
+            return
+        if name in _INDEXER_POOL_NAMES and self.config.indexer_nsid is not None:
+            # indexer_nsid already routes this pool to its own namespace.
+            return
+        reserved = {self.config.nsid, self.config.indexer_nsid} | set(
+            self._pool_nsid_map.values()
+        )
+        candidate = self._next_auto_nsid
+        while candidate in reserved:
+            candidate += 1
+        self._pool_nsid_map[name] = candidate
+        self._next_auto_nsid = candidate + 1
+        page_bytes = self._pool_page_bytes(host_pool)
+        self._pool_nsid_guide_rows[name] = (
+            candidate,
+            page_bytes,
+            self._pool_host_bytes(host_pool),
+            getattr(host_pool, "size_per_token", None),
+        )
+        if page_bytes:
+            logger.info(
+                "pool_nsid auto: pool %s -> nsid=%d (page_bytes=%d); configure "
+                "the box namespace and value_size_kb_nsid%d to cover %d KB",
+                name,
+                candidate,
+                page_bytes,
+                candidate,
+                self._suggest_value_size_kb(page_bytes),
+            )
+        else:
+            logger.info("pool_nsid auto: pool %s -> nsid=%d", name, candidate)
+
+    @staticmethod
+    def _pool_page_bytes(host_pool: Any) -> Optional[int]:
+        """Best-effort page size of a host pool in bytes, for logging."""
+        try:
+            dummy = host_pool.get_dummy_flat_data_page()
+            return dummy.numel() * dummy.element_size()
+        except Exception:
+            return None
+
+    @staticmethod
+    def _pool_host_bytes(host_pool: Any) -> Optional[int]:
+        """Best-effort total host buffer size of a pool in bytes.
+
+        This is the per-rank physical memory that gets pinned (faulted in
+        and locked) by ``ibv_reg_mr`` when the pool is registered as an NDS
+        MR — the real cost of moving a pool from file storage onto the box.
+        """
+        if host_pool is None:
+            return None
+        try:
+            get_buffers = getattr(host_pool, "get_hybrid_pool_buffer", None)
+            if get_buffers is not None:
+                buffers = get_buffers() or []
+                if buffers:
+                    return int(
+                        sum(b.numel() * b.element_size() for b in buffers)
+                    )
+        except Exception:
+            pass
+        try:
+            size = getattr(host_pool, "size", 0)
+            size_per_token = getattr(host_pool, "size_per_token", 0)
+            if size and size_per_token:
+                return int(size) * int(size_per_token)
+        except Exception:
+            pass
+        return None
+
+    def _suggest_value_size_kb(self, page_bytes: int) -> int:
+        """Suggested box-side valueSize (KB) for a pool page.
+
+        ``ceil(page_bytes/1024)`` rounded up to the ``pool_nsid_align_kb``
+        multiple — operators prefer round numbers on the box (e.g. 6289 KB
+        -> 6400 KB with the default 128 KB alignment).
+        """
+        raw_kb = (page_bytes + 1023) // 1024
+        align = self.config.pool_nsid_align_kb
+        return ((raw_kb + align - 1) // align) * align
+
+    def _write_pool_nsid_guide(self) -> None:
+        """Write the pool -> nsid provisioning guide file (once, rank 0).
+
+        With one scheduler process per GPU, the per-pool assignment logs
+        from 8+ processes interleave and are hard to read; this file is the
+        single authoritative provisioning reference.  All processes compute
+        identical assignments (same pools, same registration order), so only
+        the tp_rank 0 process writes; concurrent writes across DP groups are
+        made safe by an atomic tmp-file + rename.
+        """
+        if self.config.pool_nsid is None and not self._any_file_storage_enabled():
+            return
+        if self.config.pool_nsid_guide_path == "":
+            return  # explicitly disabled
+        if self.storage_config.tp_rank != 0:
+            return
+        path = self.config.pool_nsid_guide_path or "pool_nsid_guide.txt"
+        lines = [
+            "# NDS namespace provisioning guide (sglang hicache kv backend)",
+            f"# model suffix: {self.config_suffix}",
+            "# For every pool stored on the KV box (storage=nds), create a",
+            "# namespace whose valueSize covers the pool page size.  Pools",
+            "# stored as local files (storage=file) are also listed with their",
+            "# suggested valueSize so they can be moved back onto the box",
+            "# without re-measuring: pick an unused nsid, set pool_nsid and",
+            "# value_size_kb_nsid<N> accordingly, and drop the pool_storage",
+            "# entry.",
+            "# The suggested value is ceil(page_bytes/1024) rounded up to",
+            f"# pool_nsid_align_kb={self.config.pool_nsid_align_kb} KB.",
+            "#",
+            "# Decision aid for box vs file (per pool):",
+            "# - BENEFIT side: data volume per request = hit_tokens x",
+            "#   bytes/token (KiB/token column).  RDMA to the box pays off",
+            "#   for large volumes/pages and is REQUIRED for cross-node or",
+            "#   cross-instance sharing (local files are per-node only).",
+            "#   KiB/token is normalized per anchor (real) token for every",
+            "#   pool — state pools store one state per swa page but their",
+            "#   size_per_token is already expressed per anchor token.",
+            "#   Actual IO is quantized to whole pages: short hits/short",
+            "#   tail chunks read/write a full page, so the token-based",
+            "#   estimate underestimates for short sequences.",
+            "# - COST side: a box pool is registered as an NDS MR —",
+            "#   ibv_reg_mr faults in and PINS host_GiB of RAM per rank at",
+            "#   startup (total = host_GiB x rank_count), consumes one box",
+            "#   namespace, and adds one MR (vendor clients have shown",
+            "#   resource limits: EAGAIN on the 3rd+ MR data channel).",
+            "# - Sharing one nsid across pools: valueSize must cover the",
+            "#   largest page; smaller pages are padded up on write",
+            "#   (write amplification ~= valueSize / page_bytes).",
+            "#",
+            "# nds_wrapper.conf lines to add:",
+        ]
+        rows = [("anchor KV pool", self.config.nsid,
+                 self._pool_page_bytes(getattr(self, "mem_pool_host", None)),
+                 self._pool_host_bytes(getattr(self, "mem_pool_host", None)),
+                 getattr(getattr(self, "mem_pool_host", None),
+                         "size_per_token", None))]
+        if self.config.indexer_nsid is not None:
+            rows.append(("indexer pool(s)", self.config.indexer_nsid,
+                         None, None, None))
+        for name, (nsid, page_bytes, host_bytes, token_bytes) in \
+                self._pool_nsid_guide_rows.items():
+            rows.append((name, nsid, page_bytes, host_bytes, token_bytes))
+        conf_lines = []
+        table = ["", f"{'storage':>8}  {'nsid':>10}  {'pool':<28}  "
+                     f"{'page_bytes':>12}  {'KiB/token':>10}  "
+                     f"{'host_GiB':>9}  suggested value_size_kb"]
+        # When several pools share one nsid (allowed; config logs a warning),
+        # emit a single conf line per nsid sized for the LARGEST page —
+        # wrapper pads smaller writes up to value_size, so the max covers all.
+        nsid_max_page: dict = {}
+        nsid_pools: dict = {}
+        nds_host_total = 0
+        file_host_total = 0
+        for pool, nsid, page_bytes, host_bytes, _tb in rows:
+            if nsid is None:
+                file_host_total += host_bytes or 0
+                continue  # file-backed pool; handled separately below
+            nds_host_total += host_bytes or 0
+            nsid_pools.setdefault(nsid, []).append(pool)
+            if page_bytes:
+                nsid_max_page[nsid] = max(nsid_max_page.get(nsid, 0), page_bytes)
+        emitted = set()
+        file_conf_comments = []
+        for pool, nsid, page_bytes, host_bytes, token_bytes in rows:
+            suggested = (
+                str(self._suggest_value_size_kb(page_bytes))
+                if page_bytes
+                else "(page size unknown)"
+            )
+            page_str = str(page_bytes) if page_bytes else "-"
+            host_str = f"{host_bytes / 1024**3:.2f}" if host_bytes else "-"
+            tok_str = (
+                f"{token_bytes / 1024:.2f}"
+                if token_bytes
+                else "-"
+            )
+            if nsid is None:
+                # File-backed pool: no nsid today.  Emit a commented conf
+                # template sized for this pool so moving it back to the box
+                # is a copy-paste with a chosen nsid.
+                if page_bytes:
+                    file_conf_comments.append(
+                        f"# value_size_kb_nsid<N>="
+                        f"{self._suggest_value_size_kb(page_bytes)}"
+                        f"  # pool '{pool}' (currently file); pick an unused"
+                        f" nsid and set pool_nsid to move it onto the box"
+                    )
+                table.append(
+                    f"{'file':>8}  {'-':>10}  {pool:<28}  {page_str:>12}  "
+                    f"{tok_str:>10}  {host_str:>9}  {suggested}"
+                )
+                continue
+            if page_bytes and nsid not in emitted:
+                emitted.add(nsid)
+                conf_suggested = str(
+                    self._suggest_value_size_kb(nsid_max_page[nsid])
+                )
+                if len(nsid_pools[nsid]) > 1:
+                    conf_lines.append(
+                        f"# nsid {nsid} shared by pools "
+                        f"{', '.join(nsid_pools[nsid])} — valueSize must "
+                        f"cover the largest page; smaller pools are "
+                        f"padded up on write (write amplification)"
+                    )
+                conf_lines.append(f"value_size_kb_nsid{nsid}={conf_suggested}")
+            table.append(
+                f"{'nds':>8}  {nsid:>10}  {pool:<28}  {page_str:>12}  "
+                f"{tok_str:>10}  {host_str:>9}  {suggested}"
+            )
+        lines.extend(conf_lines)
+        if file_conf_comments:
+            lines.append("# pools currently on local file storage"
+                         " (template if moved onto the box):")
+            lines.extend(file_conf_comments)
+        lines.extend(table)
+        lines.append("")
+        lines.append("# Per-rank pinned RAM for box pools (NDS MRs): "
+                     f"{nds_host_total / 1024**3:.2f} GiB across "
+                     f"{len(self._pending_mr_buffers)} MR(s); file pools "
+                     f"hold {file_host_total / 1024**3:.2f} GiB unpinned.")
+        lines.append("# Cluster-wide pinned RAM = the above x rank_count.")
+        lines.append("")
+        tmp_path = f"{path}.tmp.{os.getpid()}"
+        try:
+            with open(tmp_path, "w", encoding="utf-8") as f:
+                f.write("\n".join(lines))
+            os.replace(tmp_path, path)
+            logger.info("pool_nsid provisioning guide written to %s", path)
+        except Exception as e:
+            logger.warning("failed to write pool_nsid guide %s: %s", path, e)
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+
+    def _nsid_for_pool(self, name: Any) -> int:
+        """Return the NDS namespace for a pool's keys.
+
+        Lookup order: ``pool_nsid`` (explicit dict or auto-assigned map) >
+        ``indexer_nsid`` (DSA indexer pool) > ``config.nsid``.  The KV pool
+        and any pool without a mapping always use ``config.nsid``.
+        """
+        mapped = self._pool_nsid_map.get(_pool_name_str(name))
+        if mapped is not None:
+            return mapped
+        if (
+            name in _INDEXER_POOL_NAMES
+            and self.config.indexer_nsid is not None
+        ):
+            return self.config.indexer_nsid
+        return self.config.nsid
+
+    # ------------------------------------------------------------------
+    # Local-file storage for the DSA INDEXER pool
+    # ------------------------------------------------------------------
+
+    def _indexer_file_enabled(self) -> bool:
+        """Return True when INDEXER pool pages are stored as local files."""
+        return self.config.indexer_storage == "file"
+
+    def _pool_uses_file_storage(self, name: Any) -> bool:
+        """Return True when the given pool's pages are stored as local files.
+
+        Two configuration routes land here: the legacy
+        ``indexer_storage="file"`` (INDEXER / DEEPSEEK_V4_C4_INDEXER pools)
+        and the per-pool ``pool_storage={"<pool>": "file"}`` override.
+        """
+        if name in _INDEXER_POOL_NAMES and self._indexer_file_enabled():
+            return True
+        pool_storage = self.config.pool_storage
+        return (
+            isinstance(pool_storage, dict)
+            and pool_storage.get(_pool_name_str(name)) == "file"
+        )
+
+    def _any_file_storage_enabled(self) -> bool:
+        """Return True when any pool uses local-file storage."""
+        return self._indexer_file_enabled() or bool(self.config.pool_storage)
+
+    def _file_store_dir(self, name: Any = None) -> str:
+        """Directory holding a pool's page files.
+
+        Legacy indexer pools keep the historical flat layout directly under
+        ``indexer_storage_path``; ``pool_storage`` pools get a per-pool
+        subdirectory so the format-stamp wipe is scoped to one pool.
+        """
+        root = self.config.indexer_storage_path
+        if name is None or name in _INDEXER_POOL_NAMES:
+            return root
+        return os.path.join(root, _pool_name_str(name))
+
+    def _has_logical_anchor(self) -> bool:
+        """Return True when the anchor host pool holds no physical KV tensor.
+
+        DeepSeek-V4 HiCache uses a pure-logical anchor pool (LogicalHostPool)
+        that only manages page indices; all real data lives in the sub-pools
+        (SWA / C4 / C128 / state pools) and moves through the v2 per-pool IO
+        path. The v1 bare-key KV path must therefore degenerate to a no-op
+        success, and hit detection is driven entirely by the sidecar pools.
+        """
+        pool = getattr(self, "mem_pool_host", None)
+        return pool is not None and getattr(pool, "kv_buffer", None) is None
+
+    def _check_indexer_file_format(self, host_pool: Any, pool_name: Any = None) -> None:
+        """Wipe stale page files when the on-disk format no longer matches.
+
+        The file store has no other invalidation: files persist across
+        restarts and are never rewritten once present.  A stamp file records
+        the format version plus the pool geometry (dtype / size_per_token /
+        page_size); on mismatch every stored page in the pool's directory is
+        wiped once at startup so stale or incompatible files cannot poison
+        cache hits.  The check is idempotent and safe to run on every TP rank
+        concurrently.  ``pool_name`` selects the per-pool directory (legacy
+        indexer pools keep the flat root layout).
+        """
+        store_dir = self._file_store_dir(pool_name)
+        fingerprint = (
+            f"v{INDEXER_FILE_FORMAT_VERSION}:"
+            f"{getattr(host_pool, 'dtype', '?')}:"
+            f"{getattr(host_pool, 'size_per_token', '?')}:"
+            f"{getattr(host_pool, 'page_size', '?')}"
+        )
+        stamp_path = os.path.join(store_dir, _INDEXER_FORMAT_STAMP_FILE)
+        try:
+            try:
+                with open(stamp_path, "r", encoding="utf-8") as f:
+                    recorded = f.read().strip()
+            except FileNotFoundError:
+                recorded = None
+            if recorded == fingerprint:
+                return
+            removed = 0
+            for name in os.listdir(store_dir):
+                if name.endswith(".bin") or name.endswith(".tmp"):
+                    try:
+                        os.remove(os.path.join(store_dir, name))
+                        removed += 1
+                    except OSError:
+                        pass
+            logger.warning(
+                "indexer file store format mismatch (recorded=%r, "
+                "current=%r): wiped %d stale files under %s",
+                recorded,
+                fingerprint,
+                removed,
+                store_dir,
+            )
+            with open(stamp_path, "w", encoding="utf-8") as f:
+                f.write(fingerprint)
+        except OSError as e:
+            logger.warning("indexer file format stamp check failed: %s", e)
+
+    def _indexer_file_path(self, storage_key: str, pool_name: Any = None) -> str:
+        """Map an already component-suffixed storage key to its file path."""
+        safe = storage_key.replace("/", "_")
+        return os.path.join(self._file_store_dir(pool_name), f"{safe}.bin")
+
+    def _file_batch_exists(
+        self, storage_keys: List[str], pool_name: Any = None
+    ) -> int:
+        """Return the number of consecutive existing page files from the start.
+
+        Mirrors the prefix-hit semantics of ``_batch_exists_raw``.
+        """
+        total = 0
+        for key in storage_keys:
+            if not os.path.exists(self._indexer_file_path(key, pool_name)):
+                break
+            total += 1
+        return total
+
+    def _pool_exists_prefix(self, name: Any, component_keys: List[str]) -> int:
+        """Prefix-exists query routed per pool: local files or NDS."""
+        if self._pool_uses_file_storage(name):
+            return self._file_batch_exists(component_keys, name)
+        return self._batch_exists_raw(component_keys, nsid=self._nsid_for_pool(name))
+
+    def _write_indexer_file(
+        self, key: str, value: torch.Tensor, pool_name: Any = None
+    ) -> bool:
+        """Write one page to its local file (tmp + atomic rename)."""
+        path = self._indexer_file_path(key, pool_name)
+        if os.path.exists(path):
+            return True
+        tmp = f"{path}.{os.getpid()}.{time.time_ns()}.tmp"
+        try:
+            buf = self._cpu_tensor(value).contiguous().view(torch.uint8).numpy()
+            with open(tmp, "wb") as f:
+                f.write(buf)
+            os.replace(tmp, path)
+            return True
+        except Exception as e:
+            logger.warning("indexer file write failed for %s: %s", key, e)
+            try:
+                os.unlink(tmp)
+            except OSError:
+                pass
+            return False
+
+    def _file_batch_set(
+        self,
+        storage_keys: List[str],
+        values: List[torch.Tensor],
+        pool_name: Any = None,
+    ) -> List[bool]:
+        """Write pages to local files (tmp + atomic rename).
+
+        Existing files are not rewritten (content is immutable per key).
+        Per-key results, unlike the all-or-nothing NDS batch path.  Keys are
+        independent files, so writes run on ``_file_io_pool`` when configured
+        (results keep the input key order).
+        """
+        if self._file_io_pool is None or len(storage_keys) <= 1:
+            return [
+                self._write_indexer_file(key, value, pool_name)
+                for key, value in zip(storage_keys, values)
+            ]
+        return list(
+            self._file_io_pool.map(
+                self._write_indexer_file,
+                storage_keys,
+                values,
+                [pool_name] * len(storage_keys),
+            )
+        )
+
+    def _file_read_page(
+        self, storage_key: str, dtype: torch.dtype, numel: int, pool_name: Any = None
+    ) -> Optional[torch.Tensor]:
+        """Read one page file back into a CPU tensor of the given shape."""
+        path = self._indexer_file_path(storage_key, pool_name)
+        try:
+            with open(path, "rb") as f:
+                data = f.read()
+        except FileNotFoundError:
+            return None
+        except OSError as e:
+            logger.warning("indexer file read failed for %s: %s", storage_key, e)
+            return None
+        expected = numel * dtype.itemsize
+        if len(data) != expected:
+            logger.warning(
+                "indexer file %s size mismatch: got %d bytes, expected %d",
+                path,
+                len(data),
+                expected,
+            )
+            return None
+        # bytearray keeps the tensor writable and owns the memory.
+        return torch.frombuffer(bytearray(data), dtype=dtype)
+
+    def _batch_exists_raw(self, suffixed_keys: List[str], nsid: Optional[int] = None) -> int:
+        """Return the number of consecutive existing suffixed keys from the start."""
+        if not suffixed_keys:
+            return 0
+        if not self._read_allowed():
+            logger.info(
+                "batch_exists short-circuited (read gate): %d keys skipped",
+                len(suffixed_keys),
+            )
+            return 0
+        eff_nsid = self.config.nsid if nsid is None else nsid
+        total = 0
+        try:
+            self._ensure_nds_initialized()
+            for i in range(0, len(suffixed_keys), MAX_BATCH_SIZE):
+                chunk = suffixed_keys[i : i + MAX_BATCH_SIZE]
+                block_ids = [
+                    encode_block_id(key, self._key_rank) for key in chunk
+                ]
+                ret = self.pynds.is_exists(block_ids, eff_nsid)
+                if envs.SGLANG_HICACHE_KV_DEBUG_LOG.get():
+                    logger.info(
+                        "kv_exists nsid=%d keys=%d first_block_id=%d "
+                        "last_block_id=%d ret=%d",
+                        eff_nsid,
+                        len(chunk),
+                        block_ids[0] if block_ids else -1,
+                        block_ids[-1] if block_ids else -1,
+                        ret,
+                    )
+                if ret < 0:
+                    return max(0, total)
+                total += ret
+                if ret < len(chunk):
+                    break
+            return max(0, total)
+        except Exception as e:
+            logger.error(
+                "_batch_exists_raw failed for %d keys: %s", len(suffixed_keys), e
+            )
+            return 0
+
+    def _record_io_stats(self, is_get: bool, nbytes: int, dur: float) -> None:
+        """Accumulate per-call IO stats and emit a periodic bandwidth summary.
+
+        Called for every pynds batch_get/batch_put (success or failure);
+        bytes are only counted on success so aggregate bandwidth reflects
+        actually transferred data over wall-clock IO time (including retry
+        backoff, which is what the request path experiences).
+
+        Two bandwidth figures are reported: ``agg_bw`` (cumulative bytes over
+        cumulative per-call durations) and ``win_bw`` (bytes since the last
+        summary over elapsed wall time).  With parallel sub-batch reads the
+        per-call durations overlap, so ``win_bw`` is the effective bandwidth
+        comparable to NIC counters.  ``span``/``span_bw`` cover the whole
+        run: wall time from the first call to this summary, and total bytes
+        over that span -- the "how long was the KV box busy in total" figure.
+        """
+        now = time.monotonic()
+        emit = False
+        win_bytes = 0
+        win_dur = 0.0
+        span = 0.0
+        with self._stats_lock:
+            if is_get:
+                self._get_calls += 1
+                self._get_bytes += nbytes
+                self._get_time += dur
+                if self._get_first_ts is None:
+                    self._get_first_ts = now
+                if self._get_win_start is None:
+                    self._get_win_start = now
+                self._get_win_bytes += nbytes
+                tag, calls, total_bytes, total_time = (
+                    "kv_get_total",
+                    self._get_calls,
+                    self._get_bytes,
+                    self._get_time,
+                )
+                if calls % _STATS_LOG_INTERVAL == 0:
+                    win_bytes = self._get_win_bytes
+                    win_dur = now - self._get_win_start
+                    span = now - self._get_first_ts
+                    self._get_win_bytes = 0
+                    self._get_win_start = now
+                    emit = True
+            else:
+                self._set_calls += 1
+                self._set_bytes += nbytes
+                self._set_time += dur
+                if self._set_first_ts is None:
+                    self._set_first_ts = now
+                if self._set_win_start is None:
+                    self._set_win_start = now
+                self._set_win_bytes += nbytes
+                tag, calls, total_bytes, total_time = (
+                    "kv_set_total",
+                    self._set_calls,
+                    self._set_bytes,
+                    self._set_time,
+                )
+                if calls % _STATS_LOG_INTERVAL == 0:
+                    win_bytes = self._set_win_bytes
+                    win_dur = now - self._set_win_start
+                    span = now - self._set_first_ts
+                    self._set_win_bytes = 0
+                    self._set_win_start = now
+                    emit = True
+        if not emit:
+            return
+        if not envs.SGLANG_HICACHE_KV_DEBUG_LOG.get():
+            return
+        agg_bw = total_bytes / total_time / 1e6 if total_time > 0 else 0.0
+        win_bw = win_bytes / win_dur / 1e6 if win_dur > 0 else 0.0
+        span_bw = total_bytes / span / 1e6 if span > 0 else 0.0
+        logger.info(
+            "%s calls=%d total_bytes=%d total_time=%.3fs agg_bw=%.1fMB/s "
+            "win_bytes=%d win_dur=%.3fs win_bw=%.1fMB/s "
+            "span=%.3fs span_bw=%.1fMB/s",
+            tag,
+            calls,
+            total_bytes,
+            total_time,
+            agg_bw,
+            win_bytes,
+            win_dur,
+            win_bw,
+            span,
+            span_bw,
+        )
+
+    def _batch_get_raw(
+        self,
+        suffixed_keys: List[str],
+        target_locations: Optional[Any],
+        nsid: Optional[int] = None,
+    ) -> List[Optional[torch.Tensor]]:
+        """Retrieve multiple already-suffixed keys into the provided target tensors."""
+        if target_locations is None or len(target_locations) != len(suffixed_keys):
+            raise ValueError(
+                "target_locations must be provided and match the number of keys"
+            )
+
+        if not self._read_allowed():
+            logger.info(
+                "batch_get short-circuited (read gate): %d keys skipped",
+                len(suffixed_keys),
+            )
+            return [None] * len(suffixed_keys)
+
+        eff_nsid = self.config.nsid if nsid is None else nsid
+        try:
+            self._ensure_nds_initialized()
+            # MLA latent KV is rank-replicated, so every TP rank reads the
+            # same key space (see _key_rank) and ranks tend to issue identical
+            # batch_get bursts simultaneously; the NDS box flow-controls many
+            # concurrent requests for the same block.  Rotate each rank's
+            # read order by a rank-derived shift so concurrent ranks start at
+            # different keys.  The original order is restored before return.
+            n = len(suffixed_keys)
+            order: Optional[List[int]] = None
+            if n > 1 and self.storage_config.tp_size > 1:
+                shift = (
+                    (n * self.storage_config.tp_rank)
+                    // self.storage_config.tp_size
+                ) % n
+                if shift:
+                    order = list(range(n))
+                    order = order[shift:] + order[:shift]
+                    suffixed_keys = [suffixed_keys[i] for i in order]
+                    target_locations = [target_locations[i] for i in order]
+            # Phase 1 (serial): plan sub-batches.  Zero-copy reads issue the
+            # whole chunk as ONE batchGet: targets are already in-MR views,
+            # so the staging window is irrelevant and the C++ two-phase
+            # submit pipelines all REQs of the call at once (deeper pipeline
+            # per call, fewer calls).  The legacy staging-window split only
+            # applies when some target actually needs the staging buffer,
+            # which is reused from offset 0 per sub-batch and therefore
+            # requires both the split and serial execution below.
+            sub_batches: List[tuple] = []  # (sub_block_ids, sub_targets, use_staging)
+            for i in range(0, n, MAX_BATCH_SIZE):
+                chunk_keys = suffixed_keys[i : i + MAX_BATCH_SIZE]
+                chunk_targets = target_locations[i : i + MAX_BATCH_SIZE]
+                block_ids = [
+                    encode_block_id(key, self._key_rank)
+                    for key in chunk_keys
+                ]
+
+                if self._staging_buffer is not None and self._staging_size > 0:
+                    needs_staging = [
+                        self._tensor_needs_staging(t) for t in chunk_targets
+                    ]
+                else:
+                    needs_staging = [False] * len(chunk_targets)
+
+                if not any(needs_staging):
+                    sub_batches.append((block_ids, chunk_targets, False))
+                    continue
+
+                # Split chunk further if it does not fit in staging buffer.
+                start = 0
+                while start < len(chunk_keys):
+                    end = start + 1
+                    total = (
+                        chunk_targets[start].numel()
+                        * chunk_targets[start].element_size()
+                    )
+                    while (
+                        end < len(chunk_keys)
+                        and total
+                        + chunk_targets[end].numel() * chunk_targets[end].element_size()
+                        <= self._staging_size
+                    ):
+                        total += (
+                            chunk_targets[end].numel()
+                            * chunk_targets[end].element_size()
+                        )
+                        end += 1
+
+                    sub_targets = chunk_targets[start:end]
+                    sub_batches.append(
+                        (
+                            block_ids[start:end],
+                            sub_targets,
+                            any(needs_staging[start:end]),
+                        )
+                    )
+                    start = end
+
+            # Capture the caller's request id up front: pool worker threads
+            # do not inherit the thread-local IO rid.
+            rid = get_io_request_id() or "-"
+            any_staging = any(sb[2] for sb in sub_batches)
+
+            def _read_sub_batch(sub_block_ids, sub_targets, use_staging):
+                """Prepare buffers, read one sub-batch with bounded retry,
+                and finalize.  Returns finalized per-key tensors, or None on
+                failure (the caller maps the whole batch to cache-miss).
+
+                Safe to run on a _get_io_pool worker for zero-copy
+                sub-batches: buffers are disjoint views of distinct targets,
+                pynds_kv.batchGet is thread-safe (two-phase submit in the
+                calling thread), and PyndsClient's semaphore caps the global
+                in-flight count.
+                """
+                sub_buffers, sub_lengths, tracked = self._prepare_get_buffers(
+                    sub_targets
+                )
+                sub_offsets = [0] * len(sub_block_ids)
+                sub_nsids = [eff_nsid] * len(sub_block_ids)
+
+                # Bounded retry with exponential backoff + jitter: the
+                # NDS box rejects read bursts under flow control (seen as
+                # non-zero batch_get ret when all TP ranks of an MLA
+                # model read the same keys at once), and such rejections
+                # are usually transient.  Buffers are fully overwritten
+                # by a successful retry, so reusing them is safe.
+                ret = -1
+                attempts = 0
+                io_start = time.monotonic()
+                for attempt in range(self.config.get_retry_count):
+                    attempts = attempt + 1
+                    ret = self.pynds.batch_get(
+                        sub_block_ids,
+                        sub_buffers,
+                        sub_offsets,
+                        sub_lengths,
+                        sub_nsids,
+                    )
+                    if ret == 0:
+                        break
+                    if attempt + 1 < self.config.get_retry_count:
+                        delay = self.config.get_retry_backoff * (2**attempt)
+                        time.sleep(delay + random.uniform(0, delay))
+                # io_dur spans all attempts including backoff sleeps --
+                # this is the effective read time the request experiences.
+                io_dur = time.monotonic() - io_start
+                sub_bytes = sum(sub_lengths)
+                if envs.SGLANG_HICACHE_KV_DEBUG_LOG.get():
+                    bw = sub_bytes / io_dur / 1e6 if io_dur > 0 else 0.0
+                    logger.info(
+                        "kv_get nsid=%d keys=%d total_bytes=%d io=%.3fs "
+                        "bw=%.1fMB/s attempts=%d staging=%d rid=%s "
+                        "first_block_id=%d last_block_id=%d ret=%d",
+                        eff_nsid,
+                        len(sub_block_ids),
+                        sub_bytes,
+                        io_dur,
+                        bw,
+                        attempts,
+                        1 if use_staging else 0,
+                        rid,
+                        sub_block_ids[0] if sub_block_ids else -1,
+                        sub_block_ids[-1] if sub_block_ids else -1,
+                        ret,
+                    )
+                self._record_io_stats(
+                    is_get=True,
+                    nbytes=sub_bytes if ret == 0 else 0,
+                    dur=io_dur,
+                )
+                if ret != 0:
+                    logger.warning(
+                        "batch_get failed for chunk of %d keys with return "
+                        "code %d after %d attempts",
+                        len(sub_block_ids),
+                        ret,
+                        self.config.get_retry_count,
+                    )
+                    return None
+                return self._finalize_get_buffers(tracked, sub_lengths, use_staging)
+
+            results: List[Optional[torch.Tensor]] = []
+            if any_staging or self._get_io_pool is None or len(sub_batches) <= 1:
+                # Serial path: staging buffer reuse requires strictly ordered
+                # sub-batches; also used when the pool is disabled or there
+                # is nothing to parallelize.
+                for sub_block_ids, sub_targets, use_staging in sub_batches:
+                    finalized = _read_sub_batch(
+                        sub_block_ids, sub_targets, use_staging
+                    )
+                    if finalized is None:
+                        return [None] * n
+                    results.extend(finalized)
+            else:
+                # Parallel path: submit all zero-copy sub-batches, gather in
+                # submission order so per-key ordering is preserved.  Any
+                # failed sub-batch fails the whole batch (same all-or-nothing
+                # semantics as the serial path).
+                futures = [
+                    self._get_io_pool.submit(_read_sub_batch, *sb)
+                    for sb in sub_batches
+                ]
+                for fut in futures:
+                    finalized = fut.result()
+                    if finalized is None:
+                        return [None] * n
+                    results.extend(finalized)
+            if order is not None:
+                restored: List[Optional[torch.Tensor]] = [None] * n
+                for pos, orig in enumerate(order):
+                    restored[orig] = results[pos]
+                results = restored
+            return results
+        except Exception as e:
+            logger.error("batch_get failed for %d keys: %s", len(suffixed_keys), e)
+            return [None] * len(suffixed_keys)
+
+    def _write_allowed(self) -> bool:
+        """Return True when a write should be attempted.
+
+        Healthy client: always allowed.  Unhealthy client: short-circuit to
+        fail fast, but let one write through every
+        ``config.unhealthy_probe_interval`` seconds as a probe — a successful
+        probe flips the client back to healthy via ``_record_success``.  The
+        lock ensures at most one probe is let through per interval even with
+        concurrent writers (backup thread, draft writes).
+        """
+        if self.pynds.is_healthy():
+            return True
+        now = time.monotonic()
+        with self._probe_lock:
+            if now - self._last_probe < self.config.unhealthy_probe_interval:
+                return False
+            self._last_probe = now
+            return True
+
+    def _read_allowed(self) -> bool:
+        """Return True when a read (batch_get / batch_exists) should be attempted.
+
+        Mirrors _write_allowed for the read path.  While the read failure
+        counter stays below config.read_failure_threshold, reads always go
+        through — transient flow-control rejections (e.g. MLA ranks bursting
+        on the shared key space) recover on the built-in retry and must not
+        gate prefetch.  Once the threshold is reached, the box is assumed
+        down: reads fail fast to cache miss, and one read per
+        config.read_probe_interval seconds is let through as a probe.  The
+        NDS client reconnects on its own (~10-15s), so the probe cadence is
+        matched to that window; a successful probe resets the counter via
+        PyndsClient._record_success, reopening reads (and recovering the
+        write gate as well).
+        """
+        if self.pynds.read_failure_count() < self.config.read_failure_threshold:
+            return True
+        now = time.monotonic()
+        with self._read_probe_lock:
+            if now - self._last_read_probe < self.config.read_probe_interval:
+                return False
+            self._last_read_probe = now
+            return True
+
+    def _batch_set_raw(
+        self,
+        suffixed_keys: List[str],
+        values: Optional[List[torch.Tensor]],
+        nsid: Optional[int] = None,
+    ) -> bool:
+        """Store multiple already-suffixed keys."""
+        if values is None or len(values) != len(suffixed_keys):
+            raise ValueError("values must be provided and match the number of keys")
+
+        if not self._write_allowed():
+            logger.info(
+                "batch_set short-circuited (pynds unhealthy): %d keys skipped",
+                len(suffixed_keys),
+            )
+            return False
+
+        eff_nsid = self.config.nsid if nsid is None else nsid
+        try:
+            self._ensure_nds_initialized()
+            # Plan sub-batches: zero-copy writes issue the whole chunk as
+            # ONE batchPut (values are already in-MR views, so the staging
+            # window is irrelevant).  The staging-window split only applies
+            # when some value actually needs the staging buffer, which is
+            # reused from offset 0 per sub-batch.
+            sub_batches: List[tuple] = []  # (sub_keys, sub_block_ids, sub_values, use_staging)
+            for i in range(0, len(suffixed_keys), MAX_BATCH_SIZE):
+                chunk_keys = suffixed_keys[i : i + MAX_BATCH_SIZE]
+                chunk_values = values[i : i + MAX_BATCH_SIZE]
+                block_ids = [
+                    encode_block_id(key, self._key_rank)
+                    for key in chunk_keys
+                ]
+
+                if self._staging_buffer is not None and self._staging_size > 0:
+                    needs_staging = [
+                        self._tensor_needs_staging(v) for v in chunk_values
+                    ]
+                else:
+                    needs_staging = [False] * len(chunk_values)
+
+                if not any(needs_staging):
+                    sub_batches.append((chunk_keys, block_ids, chunk_values, False))
+                    continue
+
+                # Split chunk further if it does not fit in staging buffer.
+                start = 0
+                while start < len(chunk_keys):
+                    end = start + 1
+                    total = (
+                        chunk_values[start].numel() * chunk_values[start].element_size()
+                    )
+                    while (
+                        end < len(chunk_keys)
+                        and total
+                        + chunk_values[end].numel() * chunk_values[end].element_size()
+                        <= self._staging_size
+                    ):
+                        total += (
+                            chunk_values[end].numel() * chunk_values[end].element_size()
+                        )
+                        end += 1
+
+                    sub_values = chunk_values[start:end]
+                    sub_batches.append(
+                        (
+                            chunk_keys[start:end],
+                            block_ids[start:end],
+                            sub_values,
+                            any(needs_staging[start:end]),
+                        )
+                    )
+                    start = end
+
+            rid = get_io_request_id() or "-"
+            for sub_keys, sub_block_ids, sub_values, use_staging in sub_batches:
+                sub_buffers, sub_lengths = self._prepare_set_buffers(sub_values)
+                sub_offsets = [0] * len(sub_keys)
+                sub_nsids = [eff_nsid] * len(sub_keys)
+
+                io_start = time.monotonic()
+                ret = self.pynds.batch_put(
+                    sub_block_ids, sub_buffers, sub_offsets, sub_lengths, sub_nsids
+                )
+                io_dur = time.monotonic() - io_start
+                sub_bytes = sum(sub_lengths)
+                if envs.SGLANG_HICACHE_KV_DEBUG_LOG.get():
+                    bw = sub_bytes / io_dur / 1e6 if io_dur > 0 else 0.0
+                    logger.info(
+                        "kv_set nsid=%d keys=%d total_bytes=%d io=%.3fs "
+                        "bw=%.1fMB/s staging=%d rid=%s "
+                        "first_block_id=%d last_block_id=%d ret=%d",
+                        eff_nsid,
+                        len(sub_keys),
+                        sub_bytes,
+                        io_dur,
+                        bw,
+                        1 if use_staging else 0,
+                        rid,
+                        sub_block_ids[0] if sub_block_ids else -1,
+                        sub_block_ids[-1] if sub_block_ids else -1,
+                        ret,
+                    )
+                self._record_io_stats(
+                    is_get=False,
+                    nbytes=sub_bytes if ret == 0 else 0,
+                    dur=io_dur,
+                )
+                if ret != 0:
+                    logger.warning(
+                        "batch_put failed for chunk of %d keys with return code %d",
+                        len(sub_keys),
+                        ret,
+                    )
+                    return False
+            return True
+        except Exception as e:
+            logger.error("batch_set failed for %d keys: %s", len(suffixed_keys), e)
+            return False
+
+    def exists(self, key: str) -> bool:
+        """Check if a single key exists in the KV backend.
+
+        In K/V-split mode a page counts as existing only when both its ".k"
+        and ".v" parts are present.
+        """
+        if not self._read_allowed():
+            return False
+        try:
+            if self._kv_split_enabled():
+                suffixed = self._get_suffixed_key(key)
+                block_ids = [
+                    encode_block_id(suffixed + suffix, self._key_rank)
+                    for suffix in _KV_SPLIT_SUFFIXES
+                ]
+                return self.pynds.is_exists(block_ids) >= len(_KV_SPLIT_SUFFIXES)
+            block_ids = self._hash_keys_to_block_ids([key])
+            ret = self.pynds.is_exists(block_ids)
+            return ret >= 1
+        except Exception as e:
+            logger.error("exists failed for key %s: %s", key, e)
+            return False
+
+    def batch_exists(
+        self,
+        keys: List[str],
+        extra_info: Optional[HiCacheStorageExtraInfo] = None,
+    ) -> int:
+        """Return the number of consecutive existing keys from the start.
+
+        In K/V-split mode the hit count is the minimum prefix of the ".k" and
+        ".v" queries so a page only counts when both halves are present.
+        """
+        suffixed = [self._get_suffixed_key(key) for key in keys]
+        if self._kv_split_enabled():
+            k_hit = self._batch_exists_raw([sk + ".k" for sk in suffixed])
+            if k_hit == 0:
+                return 0
+            v_hit = self._batch_exists_raw([sk + ".v" for sk in suffixed])
+            return min(k_hit, v_hit)
+        return self._batch_exists_raw(suffixed)
+
+    def get(
+        self,
+        key: str,
+        target_location: Optional[Any] = None,
+        target_sizes: Optional[Any] = None,
+    ) -> Optional[torch.Tensor]:
+        """Retrieve a single key. Returns None if missing."""
+        if target_location is None:
+            return None
+        results = self.batch_get([key], [target_location], target_sizes)
+        return results[0] if results else None
+
+    def batch_get(
+        self,
+        keys: List[str],
+        target_locations: Optional[Any] = None,
+        target_sizes: Optional[Any] = None,
+    ) -> List[Optional[torch.Tensor]]:
+        """Retrieve multiple keys into the provided target tensors.
+
+        In K/V-split mode each contiguous CPU target is read as two half-page
+        parts ("<key>.k" / "<key>.v") written back into the target in place.
+
+        Note:
+            When the input tensors are non-contiguous or on GPU, the returned
+            tensors may be CPU copies into which pynds_kv wrote the data. Callers
+            should use the returned tensors rather than the original inputs; the
+            v2 controller does this via ``set_from_flat_data_page``.
+        """
+        if self._has_logical_anchor():
+            # DeepSeek-V4 logical anchor: the KV component holds no physical
+            # data; the dummy target pages are pure success markers and the
+            # real pages arrive via batch_get_v2 on the sub-pools.
+            if target_locations is not None:
+                return list(target_locations)
+            return [torch.empty(0, dtype=torch.uint8) for _ in keys]
+        suffixed = [self._get_suffixed_key(k) for k in keys]
+        if (
+            self._kv_split_enabled()
+            and target_locations is not None
+            and len(target_locations) == len(keys)
+            and all(
+                t.device.type == "cpu" and t.is_contiguous()
+                for t in target_locations
+            )
+        ):
+            flat_keys: List[str] = []
+            flat_targets: List[torch.Tensor] = []
+            for sk, target in zip(suffixed, target_locations):
+                for suffix, part in zip(
+                    _KV_SPLIT_SUFFIXES, self._split_flat_tensor(target)
+                ):
+                    flat_keys.append(sk + suffix)
+                    flat_targets.append(part)
+            fetched = self._batch_get_raw(flat_keys, flat_targets)
+            results: List[Optional[torch.Tensor]] = []
+            for i, target in enumerate(target_locations):
+                parts = fetched[2 * i : 2 * i + 2]
+                ok = all(p is not None for p in parts)
+                results.append(target if ok else None)
+            return results
+        return self._batch_get_raw(suffixed, target_locations)
+
+    def batch_exists_v2(
+        self,
+        keys: List[str],
+        pool_transfers: Optional[List[PoolTransfer]] = None,
+        extra_info: Optional[HiCacheStorageExtraInfo] = None,
+    ) -> PoolTransferResult:
+        """Check which cache pages exist, respecting per-pool hit policies.
+
+        The KV pool is queried first.  If ``pool_transfers`` contains extra
+        pools, their availability further constrains the usable prefix length.
+        For ``ALL_PAGES`` policy the component keys are checked with a single
+        batched prefix query over the KV-hit prefix (``transfer.keys`` is only
+        populated at transfer time and is None during prefetch hit queries);
+        for ``TRAILING_PAGES`` only the last ``len(transfer.keys)`` pages of
+        each candidate prefix are checked.  Extra-pool component keys are
+        queried in the namespace returned by ``_nsid_for_pool`` (e.g. the DSA
+        indexer pool may live in a separate ``indexer_nsid``).
+        """
+        if self._has_logical_anchor():
+            # Logical anchor (DeepSeek-V4): no physical KV objects exist under
+            # the bare keys, so the usable prefix is determined entirely by
+            # the required sub-pool (sidecar) objects below.
+            kv_hit = len(keys)
+        else:
+            kv_hit = self.batch_exists(keys, extra_info)
+        extra_pool_hit_pages: dict[str, int] = {}
+        final_pages = kv_hit
+
+        for transfer in pool_transfers or []:
+            if final_pages == 0:
+                break
+            name = transfer.name
+            if name in (PoolName.KV, "__default__"):
+                # The KV pool is already accounted for in kv_hit via
+                # batch_exists (K/V-split aware).  Re-checking bare component
+                # keys here would never hit in split mode.
+                boundary = kv_hit
+            elif transfer.hit_policy == PoolHitPolicy.ALL_PAGES:
+                # transfer.keys is only populated at transfer time; during
+                # prefetch hit queries it is None, in which case the whole
+                # KV-hit prefix must be checked (aligned with hf3fs, which
+                # uses keys[:kv_pages] from the main key list).
+                upper = (
+                    kv_hit if not transfer.keys else min(kv_hit, len(transfer.keys))
+                )
+                component_keys = [
+                    self._get_component_key(keys[i], name) for i in range(upper)
+                ]
+                boundary = self._pool_exists_prefix(name, component_keys)
+            else:  # trailing_pages
+                trailing = max(1, len(transfer.keys) if transfer.keys else 1)
+                boundary = 0
+                for prefix_len in range(kv_hit, 0, -1):
+                    start = max(0, prefix_len - trailing)
+                    component_keys = [
+                        self._get_component_key(keys[i], name)
+                        for i in range(start, prefix_len)
+                    ]
+                    if self._pool_exists_prefix(name, component_keys) == len(
+                        component_keys
+                    ):
+                        boundary = prefix_len
+                        break
+            if boundary:
+                extra_pool_hit_pages[name] = boundary
+            final_pages = min(final_pages, boundary)
+
+        return PoolTransferResult(final_pages, extra_pool_hit_pages)
+
+    def _get_v2_host_pool(self, name: str) -> Any:
+        """Return the host pool registered for the given pool name."""
+        if not hasattr(self, "registered_pools") or name not in self.registered_pools:
+            raise ValueError(f"host pool {name} not registered for v2 transfer")
+        return self.registered_pools[name]
+
+    def _validate_v2_indices(
+        self, host_indices: Optional[torch.Tensor], num_keys: int, page_size: int
+    ) -> bool:
+        """Validate host_indices length matches expected number of entries."""
+        if host_indices is None:
+            return False
+        expected = num_keys * page_size
+        if host_indices.numel() != expected:
+            logger.error(
+                "v2 indices length mismatch: expected %d, got %d",
+                expected,
+                host_indices.numel(),
+            )
+            return False
+        return True
+
+    def _get_indexer_file_pages(
+        self,
+        host_pool: Any,
+        keys: List[str],
+        host_indices: torch.Tensor,
+        page_size: int,
+        pool_name: Any,
+    ) -> List[bool]:
+        """Restore pages from local files into the host pool.
+
+        File reads run on ``_file_io_pool`` when configured (each page is an
+        independent file); the copies into the host pool stay in the calling
+        thread so worker threads never write the pool.
+        """
+        page_offsets = [
+            host_indices[i * page_size].item() for i in range(len(keys))
+        ]
+        flat_pages = [
+            host_pool.get_data_page(page_offset, flat=True)
+            for page_offset in page_offsets
+        ]
+        storage_keys = [self._get_component_key(key, pool_name) for key in keys]
+        if self._file_io_pool is not None and len(keys) > 1:
+            fetched_pages = list(
+                self._file_io_pool.map(
+                    self._file_read_page,
+                    storage_keys,
+                    [page.dtype for page in flat_pages],
+                    [page.numel() for page in flat_pages],
+                    [pool_name] * len(keys),
+                )
+            )
+        else:
+            fetched_pages = [
+                self._file_read_page(storage_key, page.dtype, page.numel(), pool_name)
+                for storage_key, page in zip(storage_keys, flat_pages)
+            ]
+        successes: List[bool] = []
+        for key, page_offset, fetched in zip(keys, page_offsets, fetched_pages):
+            if fetched is None:
+                successes.append(False)
+                continue
+            try:
+                host_pool.set_from_flat_data_page(page_offset, fetched)
+                successes.append(True)
+            except Exception as e:
+                logger.warning(
+                    "indexer file page restore failed for key %s: %s",
+                    key,
+                    e,
+                )
+                successes.append(False)
+        return successes
+
+    def batch_get_v2(
+        self,
+        transfers: List[PoolTransfer],
+        extra_info: Optional[HiCacheStorageExtraInfo] = None,
+    ) -> dict[str, List[bool]]:
+        """Read data from storage into host memory for each PoolTransfer.
+
+        KV-pool transfers go through ``_get_kv_pages`` (zero-copy K/V views
+        for MHA page-first pools).  Extra pools use component-suffixed keys
+        and flat data pages from their registered host pools.
+        """
+        results: dict[str, List[bool]] = {}
+        for transfer in transfers:
+            host_pool = self._get_v2_host_pool(transfer.name)
+            keys = transfer.keys or []
+            page_size = getattr(host_pool, "page_size", 1) or 1
+            if not self._validate_v2_indices(
+                transfer.host_indices, len(keys), page_size
+            ):
+                results[transfer.name] = [False] * len(keys)
+                continue
+
+            host_indices = transfer.host_indices
+            page_starts = [
+                int(host_indices[i * page_size]) for i in range(len(keys))
+            ]
+            if transfer.name in (PoolName.KV, "__default__"):
+                storage_keys = [self._get_suffixed_key(k) for k in keys]
+                results[transfer.name] = self._get_kv_pages(
+                    storage_keys, page_starts, host_pool
+                )
+                continue
+
+            if self._pool_uses_file_storage(transfer.name):
+                # Pages are restored from local files, not the KV box.
+                results[transfer.name] = self._get_indexer_file_pages(
+                    host_pool, keys, host_indices, page_size, transfer.name
+                )
+                continue
+
+            target_locations = [
+                host_pool.get_data_page(host_indices[i * page_size].item(), flat=True)
+                for i in range(len(keys))
+            ]
+            storage_keys = [self._get_component_key(k, transfer.name) for k in keys]
+            fetched = self._batch_get_raw(
+                storage_keys, target_locations, nsid=self._nsid_for_pool(transfer.name)
+            )
+            successes: List[bool] = []
+            for i, result in enumerate(fetched):
+                if result is None:
+                    successes.append(False)
+                    continue
+                page_offset = host_indices[i * page_size].item()
+                host_pool.set_from_flat_data_page(page_offset, result)
+                successes.append(True)
+            results[transfer.name] = successes
+        return results
+
+    def batch_set_v2(
+        self,
+        transfers: List[PoolTransfer],
+        extra_info: Optional[HiCacheStorageExtraInfo] = None,
+    ) -> dict[str, List[bool]]:
+        """Write data from host memory to storage for each PoolTransfer.
+
+        KV-pool transfers go through ``_set_kv_pages`` (zero-copy K/V views
+        for MHA page-first pools).  Extra pools use component-suffixed keys.
+        The current implementation treats each PoolTransfer as an
+        all-or-nothing batch: a single pynds_kv failure causes the whole
+        transfer to be reported as failed for every key.
+        """
+        results: dict[str, List[bool]] = {}
+        for transfer in transfers:
+            host_pool = self._get_v2_host_pool(transfer.name)
+            keys = transfer.keys or []
+            page_size = getattr(host_pool, "page_size", 1) or 1
+            if not self._validate_v2_indices(
+                transfer.host_indices, len(keys), page_size
+            ):
+                results[transfer.name] = [False] * len(keys)
+                continue
+
+            host_indices = transfer.host_indices
+            page_starts = [
+                int(host_indices[i * page_size]) for i in range(len(keys))
+            ]
+            if transfer.name in (PoolName.KV, "__default__"):
+                storage_keys = [self._get_suffixed_key(k) for k in keys]
+                all_ok = self._set_kv_pages(storage_keys, page_starts, host_pool)
+                results[transfer.name] = [all_ok] * len(keys)
+                continue
+
+            if self._pool_uses_file_storage(transfer.name):
+                # Pages are written to local files, not the KV box.
+                values = [
+                    host_pool.get_data_page(host_indices[i * page_size].item(), flat=True)
+                    for i in range(len(keys))
+                ]
+                storage_keys = [self._get_component_key(k, transfer.name) for k in keys]
+                results[transfer.name] = self._file_batch_set(
+                    storage_keys, values, transfer.name
+                )
+                continue
+
+            values = [
+                host_pool.get_data_page(host_indices[i * page_size].item(), flat=True)
+                for i in range(len(keys))
+            ]
+            storage_keys = [self._get_component_key(k, transfer.name) for k in keys]
+            all_ok = self._batch_set_raw(
+                storage_keys, values, nsid=self._nsid_for_pool(transfer.name)
+            )
+            results[transfer.name] = [all_ok] * len(keys)
+        return results
+
+    def set(
+        self,
+        key: str,
+        value: Optional[Any] = None,
+        target_location: Optional[Any] = None,
+        target_sizes: Optional[Any] = None,
+    ) -> bool:
+        """Store a single key."""
+        if value is None:
+            return False
+        return self.batch_set([key], [value], target_sizes=target_sizes)
+
+    def batch_set(
+        self,
+        keys: List[str],
+        values: Optional[List[torch.Tensor]] = None,
+        target_locations: Optional[Any] = None,
+        target_sizes: Optional[Any] = None,
+    ) -> bool:
+        """Store multiple keys.
+
+        In K/V-split mode each flat page value is stored as two half-page
+        parts ("<key>.k" / "<key>.v") so the keyspace stays consistent with
+        the zero-copy v1 path and with ``batch_exists``.
+        """
+        if values is None:
+            return False
+        if self._has_logical_anchor():
+            # DeepSeek-V4 logical anchor: no physical KV pages to store; the
+            # sub-pool data is written via batch_set_v2.  Report success so
+            # the backup flow completes and sidecar writes proceed.
+            return True
+        suffixed = [self._get_suffixed_key(k) for k in keys]
+        if self._kv_split_enabled() and len(values) == len(keys):
+            flat_keys: List[str] = []
+            flat_values: List[torch.Tensor] = []
+            for sk, value in zip(suffixed, values):
+                for suffix, part in zip(
+                    _KV_SPLIT_SUFFIXES, self._split_flat_tensor(value)
+                ):
+                    flat_keys.append(sk + suffix)
+                    flat_values.append(part)
+            return self._batch_set_raw(flat_keys, flat_values)
+        return self._batch_set_raw(suffixed, values)
+
+    def _validate_v1_indices(
+        self, keys: List[str], host_indices: Optional[Any]
+    ) -> bool:
+        """Validate host_indices length matches num_keys * page_size."""
+        pool = getattr(self, "mem_pool_host", None)
+        if pool is None or host_indices is None:
+            return False
+        page_size = getattr(pool, "page_size", 1) or 1
+        expected = len(keys) * page_size
+        actual = host_indices.numel() if hasattr(host_indices, "numel") else -1
+        if actual != expected:
+            logger.error(
+                "v1 indices length mismatch: expected %d, got %d", expected, actual
+            )
+            return False
+        return True
+
+    def batch_set_v1(
+        self,
+        keys: List[str],
+        host_indices: torch.Tensor,
+        extra_info: Optional[HiCacheStorageExtraInfo] = None,
+    ) -> List[bool]:
+        """Store KV pages addressed by host_indices.
+
+        Uses contiguous in-MR K/V views for MHA page-first pools (zero-copy),
+        falling back to flat pages + staging for other layouts.
+        """
+        if self._has_logical_anchor():
+            # DeepSeek-V4 logical anchor: no physical KV pages; success markers
+            # only, real data moves via batch_set_v2 on the sub-pools.
+            return [True] * len(keys)
+        if not self._validate_v1_indices(keys, host_indices):
+            return [False] * len(keys)
+        pool = self.mem_pool_host
+        page_size = getattr(pool, "page_size", 1) or 1
+        page_starts = [int(host_indices[i * page_size]) for i in range(len(keys))]
+        storage_keys = [self._get_suffixed_key(k) for k in keys]
+        ok = self._set_kv_pages(storage_keys, page_starts, pool)
+        return [ok] * len(keys)
+
+    def batch_get_v1(
+        self,
+        keys: List[str],
+        host_indices: torch.Tensor,
+        extra_info: Optional[HiCacheStorageExtraInfo] = None,
+    ) -> List[bool]:
+        """Load KV pages into the host pool slots addressed by host_indices.
+
+        Uses contiguous in-MR K/V views for MHA page-first pools (zero-copy),
+        falling back to flat pages + staging for other layouts.
+        """
+        if self._has_logical_anchor():
+            # DeepSeek-V4 logical anchor: no physical KV pages; success markers
+            # only, real data arrives via batch_get_v2 on the sub-pools.
+            return [True] * len(keys)
+        if not self._validate_v1_indices(keys, host_indices):
+            return [False] * len(keys)
+        pool = self.mem_pool_host
+        page_size = getattr(pool, "page_size", 1) or 1
+        page_starts = [int(host_indices[i * page_size]) for i in range(len(keys))]
+        storage_keys = [self._get_suffixed_key(k) for k in keys]
+        return self._get_kv_pages(storage_keys, page_starts, pool)
