+            block_ids,
+            buffers,
+            offsets,
+            lengths,
+            nsids,
+        )
+        t_dur = time.time() - t_start
+        if ret != 0:
+            logger.warning(
+                "pynds_kv.batchGet (async prefetch) failed, ret=%d "
+                "(after %d attempts). "
+                "Some prefetched blocks may have been lost from KV box. "
+                "Removing all prefetched keys from dict and unpinning memory.",
+                ret,
+                self._get_retry_count,
