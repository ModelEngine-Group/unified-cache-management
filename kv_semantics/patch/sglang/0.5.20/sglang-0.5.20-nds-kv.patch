+# SPDX-License-Identifier: Apache-2.0
+
+# Standard
+import logging
+import os
+import re
+import tempfile
+import threading
+from typing import Any, Callable, List, Optional
+
+# Third Party
+import numpy as np
+
+logger = logging.getLogger(__name__)
+
+# Global guard to ensure pynds_kv.init() is called exactly once.
+_pynds_initialized = False
+_pynds_init_failed = False
+_pynds_registered_mrs = 0
+_init_lock = threading.Lock()
+
+
+def _call_with_timeout(
+    func: Callable[..., Any], timeout: float, *args: Any, **kwargs: Any
+) -> Any:
+    """Run ``func`` in a daemon thread and return its result or raise an exception.
+
+    If the thread is still alive after ``timeout`` seconds, a
+    :class:`TimeoutError` is raised instead of waiting for the stuck call.
+    This avoids the indefinite ``shutdown(wait=True)`` hang that occurs when
+    a :class:`ThreadPoolExecutor` context manager wraps a blocking call.
+    """
+    result: dict[str, Any] = {"value": None, "exception": None}
+
+    def _target() -> None:
+        try:
+            result["value"] = func(*args, **kwargs)
+        except Exception as exc:
+            result["exception"] = exc
+
+    thread = threading.Thread(target=_target, daemon=True)
+    thread.start()
+    thread.join(timeout=timeout)
+    if thread.is_alive():
+        raise TimeoutError(f"pynds_kv call timed out after {timeout}s")
+    if result["exception"] is not None:
+        raise result["exception"]
+    return result["value"]
+
+
+_START_CORE_PATTERN = re.compile(r"^(\s*start_core\s*=\s*)(\d+)(.*)$")
+
+
+def _read_base_start_core(base_path: str) -> int:
+    """Return the base ``start_core`` value from ``nds_config.conf``."""
+    with open(base_path, "r", encoding="utf-8") as f:
+        for line in f:
+            m = _START_CORE_PATTERN.match(line.rstrip("\n"))
+            if m:
+                return int(m.group(2))
+    raise ValueError(f"start_core not found in {base_path}")
+
+
+def _write_conf_with_start_core(base_path: str, new_core: int) -> str:
+    """Write a per-rank copy of ``base_path`` with ``start_core = new_core``.
+
+    The rewritten copy is placed **next to the original file** (same
+    directory) because pynds_kv loads ``nds_wrapper.conf`` from the directory
+    containing the nds_config path — copying elsewhere would silently drop
+    the wrapper IO tuning.
+
+    The per-rank copy is a derived artifact whose source of truth is the
+    base conf the deployer edits, so an existing copy is always overwritten
+    to avoid reusing stale core assignments.
+
+    The write is atomic (tmp file + ``os.replace`` in the same directory)
+    because processes that compute the same ``start_core`` target the same
+    file name. A naive ``open(w)`` truncate+write could let a concurrent
+    reader observe a torn or empty file.
+    """
+    with open(base_path, "r", encoding="utf-8") as f:
+        lines = f.readlines()
+
+    base_core: Optional[int] = None
+    for i, line in enumerate(lines):
+        m = _START_CORE_PATTERN.match(line.rstrip("\n"))
+        if m:
+            base_core = int(m.group(2))
+            lines[i] = f"{m.group(1)}{new_core}{m.group(3)}\n"
+            break
+    if base_core is None:
+        raise ValueError(f"start_core not found in {base_path}")
+
+    root, ext = os.path.splitext(base_path)
+    new_path = f"{root}.core{new_core}{ext}"
+    fd, tmp_path = tempfile.mkstemp(
+        prefix=f".{os.path.basename(new_path)}.", dir=os.path.dirname(new_path) or "."
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.write("".join(lines))
+        os.replace(tmp_path, new_path)
+    except BaseException:
+        try:
+            os.unlink(tmp_path)
+        except OSError:
+            pass
+        raise
+    logger.info(
+        "wrote per-rank NDS config %s (start_core %d -> %d)",
+        new_path,
+        base_core,
+        new_core,
+    )
+    return new_path
+
+
+def materialize_per_rank_nds_config(base_path: str, core_offset: int) -> str:
+    """Write a copy of ``nds_config.conf`` with ``start_core`` shifted.
+
+    The vendor NDS SDK pins its internal IO threads to physical cores starting
+    at the ``start_core`` key in ``nds_config.conf``.  Multi-GPU launches one
+    process per TP rank and every process reads the same conf, so all ranks
+    pin their SDK threads onto the same cores and starve each other.  Shifting
+    ``start_core`` by a per-rank offset gives each process its own core range.
+
+    Prefer NUMA-aware placement (``numa_local_start_core`` +
+    ``materialize_per_rank_nds_config_absolute``) when the topology is
+    available; this linear offset mode is the fallback for hosts where the
+    NUMA topology cannot be queried.
+
+    Args:
+        base_path: Path to the shared ``nds_config.conf``.
+        core_offset: Value added to the base ``start_core``.  0 returns
+            ``base_path`` unchanged (no rewrite needed).
+
+    Returns:
+        Path to the conf the caller should pass to ``pynds_kv.init`` —
+        ``base_path`` itself when ``core_offset == 0``, otherwise the
+        per-rank copy named ``<base>.core<new_start_core><ext>``.
+
+    Raises:
+        ValueError: If ``core_offset > 0`` but no ``start_core`` key exists
+            in the base conf (a deployment error that must stay loud).
+    """
+    if core_offset == 0:
+        return base_path
+    if core_offset < 0:
+        raise ValueError(f"core_offset must be non-negative, got {core_offset}")
+
+    try:
+        base_core = _read_base_start_core(base_path)
+    except ValueError as e:
+        raise ValueError(
+            f"{e}; cannot apply per-rank core offset {core_offset}"
+        ) from e
+    return _write_conf_with_start_core(base_path, base_core + core_offset)
+
+
+def materialize_per_rank_nds_config_absolute(
+    base_path: str, start_core: int
+) -> str:
+    """Write a copy of ``nds_config.conf`` with an absolute ``start_core``.
+
+    Unlike :func:`materialize_per_rank_nds_config` (which shifts the base
+    value by an offset), this sets ``start_core`` verbatim — used with
+    :func:`numa_local_start_core`, which computes a core id inside the GPU's
+    NUMA node directly from the host topology.
+
+    Args:
+        base_path: Path to the shared ``nds_config.conf``.
+        start_core: Absolute physical core id to write.
+
+    Returns:
+        Path to the per-rank copy named ``<base>.core<start_core><ext>``.
+
+    Raises:
+        ValueError: If ``start_core`` is negative or the base conf has no
+            ``start_core`` key (a deployment error that must stay loud).
+    """
+    if start_core < 0:
+        raise ValueError(f"start_core must be non-negative, got {start_core}")
+    return _write_conf_with_start_core(base_path, start_core)
+
+
+def numa_local_start_core(gpu_ordinal: int, stride: Any) -> Optional[int]:
+    """Absolute ``start_core`` for this rank inside its GPU's NUMA node.
+
+    The vendor SDK pins its IO threads to physical cores starting at
+    ``start_core``; those cores must live in the same NUMA node as the GPU
+    (and as the RDMA NIC's PCIe attachment) or every RDMA touchdown crosses
+    the inter-socket link.  Worse, when SGLang's NUMA bind
+    (``SGLANG_NUMA_BIND_V2``) numactl-confines the scheduler process to the
+    GPU's node, an SDK ``pthread_setaffinity`` targeting cores outside that
+    node fails outright and the threads float unbound.
+
+    GPUs sharing a NUMA node are assigned disjoint windows of ``stride``
+    physical cores each, in device-ordinal order: the p-th GPU on the node
+    gets ``cores[p*stride]`` as its ``start_core``.  Hyperthread siblings are
+    excluded (physical cores only, via lscpu topology).
+
+    Args:
+        gpu_ordinal: The process's CUDA device index on the local node.
+        stride: Number of physical cores reserved per process, or the string
+            ``"auto"`` to derive the window from the node's affinity-visible
+            physical core count divided by its GPU count (no manual sizing;
+            the operator caps the vendor SDK's pinned-thread count at the
+            derived stride).  A manual stride must be >= the number of cores
+            the SDK pins per process.
+
+    Returns:
+        The absolute core id for this rank's ``start_core``, or ``None``
+        when the topology cannot be determined (no CUDA, pynvml missing,
+        lscpu failure, unknown GPU→node mapping) — the caller then falls
+        back to the legacy linear offset mode (manual stride) or passes the
+        base conf through unchanged (``"auto"``).
+
+    Raises:
+        ValueError: If a manual ``stride <= 0``, or the GPU's NUMA node does
+            not have enough physical cores for all its GPUs at the
+            effective stride — a deployment error that must stay loud rather
+            than silently overlapping two ranks onto the same cores.
+    """
+    if stride == "auto":
+        pass  # effective stride derived below from the node topology
+    elif stride <= 0:
+        raise ValueError(f"stride must be positive, got {stride}")
+
+    # Lazy imports: keeps this module importable without torch/pynvml and
+    # avoids pulling server_args into lightweight test contexts.  The query
+    # helpers resolve CUDA_VISIBLE_DEVICES reordering internally.
+    import torch
+
+    from sglang.srt.utils.common import get_physical_cpus_by_numa
+    from sglang.srt.utils.numa_utils import _query_numa_node_for_gpu
+
+    try:
+        gpu_count = torch.cuda.device_count()
+        node_by_gpu: dict[int, Optional[int]] = {}
+        for dev in range(gpu_count):
+            nodes = _query_numa_node_for_gpu(dev)
+            node_by_gpu[dev] = nodes[0] if nodes else None
+        node_cores_map = get_physical_cpus_by_numa()
+    except Exception as e:
+        logger.warning(
+            "NUMA topology query failed (%s); falling back to linear "
+            "start_core offset",
+            e,
+        )
+        return None
+
+    my_node = node_by_gpu.get(gpu_ordinal)
+    if my_node is None or any(n is None for n in node_by_gpu.values()):
+        logger.warning(
+            "NUMA node unknown for some GPUs (gpu %d -> %s); falling back "
+            "to linear start_core offset",
+            gpu_ordinal,
+            node_by_gpu,
+        )
+        return None
+
+    cores = sorted(node_cores_map.get(my_node) or [])
+    if not cores:
+        logger.warning(
+            "no physical cores found for NUMA node %d; falling back to "
+            "linear start_core offset",
+            my_node,
+        )
+        return None
+
+    peers = sorted(d for d, n in node_by_gpu.items() if n == my_node)
+    pos = peers.index(gpu_ordinal)
+
+    if stride == "auto":
+        # Derive the per-process window from the node's affinity-visible
+        # physical core count instead of requiring a manual stride.  The
+        # core list is already intersected with the process affinity mask
+        # (get_physical_cpus_by_numa), so this adapts to numactl-bound
+        # deployments automatically: node-level binds share the full node
+        # (cores // peers per rank), per-rank binds see only their own
+        # subset (any window inside it stays disjoint from other ranks).
+        # The operator is expected to cap the vendor SDK's pinned-thread
+        # count at the resulting stride.
+        stride = len(cores) // len(peers)
+        if stride == 0:
+            raise ValueError(
+                f"NUMA node {my_node} has only {len(cores)} physical cores "
+                f"for {len(peers)} GPUs; cannot assign even one core per "
+                f"process (nds_core_stride=auto)"
+            )
+        logger.info(
+            "nds_core_stride=auto: node %d has %d physical cores for %d "
+            "GPUs -> stride %d",
+            my_node,
+            len(cores),
+            len(peers),
+            stride,
+        )
+
+    first = pos * stride
+    if first + stride > len(cores):
+        raise ValueError(
+            f"NUMA node {my_node} has only {len(cores)} physical cores, but "
+            f"GPU {gpu_ordinal} (position {pos} among {len(peers)} GPUs on "
+            f"the node) needs cores [{first}, {first + stride}) at stride "
+            f"{stride}; reduce nds_core_stride or rebalance GPUs across nodes"
+        )
+
+    start = cores[first]
+    logger.info(
+        "NUMA-aware NDS start_core: GPU %d on node %d, position %d/%d, "
+        "cores [%d, %d), start_core=%d",
+        gpu_ordinal,
+        my_node,
+        pos,
+        len(peers),
+        first,
+        first + stride,
+        start,
+    )
+    return start
+
+
+def init_once(
+    buffer: Any,
+    buffer_size: int,
+    nds_config_path: Optional[str] = None,
+    timeout: float = 30.0,
+) -> None:
+    """Initialize pynds_kv exactly once across all backend instances.
+
+    Args:
+        buffer: A buffer-like object (e.g. numpy ndarray) to register as MR.
+            For generic-copy backends that use per-call buffers, this can be a
+            small dummy buffer (e.g. 1024 bytes).
+        buffer_size: Size of the buffer in bytes.
+        nds_config_path: Path to the NDS configuration file.
+        timeout: Timeout in seconds for the pynds_kv.init call.
+    """
+    global _pynds_initialized, _pynds_init_failed, _pynds_registered_mrs
+    with _init_lock:
+        if _pynds_initialized:
+            return
+        if _pynds_init_failed:
+            raise RuntimeError("pynds_kv.init previously failed; refusing to retry")
+        # pynds_kv is an optional runtime dependency; import here to avoid
+        # breaking environments where it is not installed.
+        import pynds_kv
+
+        try:
+            ret = _call_with_timeout(
+                pynds_kv.init, timeout, buffer, buffer_size, nds_config_path
+            )
+        except Exception:
+            _pynds_init_failed = True
+            raise
+        if ret != 0:
+            _pynds_init_failed = True
+            raise RuntimeError(f"pynds_kv.init failed with return code {ret}")
+        _pynds_initialized = True
+        _pynds_registered_mrs = 1
+        logger.info("pynds_kv initialized successfully")
+
+
+def init_once_multi(
+    buffers: List[Any],
+    nds_config_path: Optional[str] = None,
+    timeout: float = 30.0,
+) -> int:
+    """Initialize pynds_kv once, registering one or more buffers as NDS MRs.
+
+    DSA models have a second host buffer (indexer cache) that should be
+    RDMA-registered alongside the anchor KV host pool so its pages can move
+    zero-copy.  All buffers are registered in a single ``pynds_kv.init_multi``
+    call (mr_id = registration order).
+
+    If multi-MR registration fails (or the installed pynds_kv build predates
+    ``init_multi``), the call falls back to registering only the first buffer
+    and returns 1; callers should treat the remaining buffers as
+    out-of-MR (staging copies).
+
+    Args:
+        buffers: Non-empty list of buffer-like objects (numpy arrays).
+        nds_config_path: Path to the NDS configuration file.
+        timeout: Timeout in seconds for the pynds_kv init call.
+
+    Returns:
+        The number of memory regions actually registered (``len(buffers)``
+        on full success, 1 on fallback).
+    """
+    global _pynds_initialized, _pynds_init_failed, _pynds_registered_mrs
+    with _init_lock:
+        if _pynds_initialized:
+            return _pynds_registered_mrs
+        if _pynds_init_failed:
+            raise RuntimeError("pynds_kv.init previously failed; refusing to retry")
+        import pynds_kv
+
+        buffers = list(buffers)
+        if not buffers:
+            raise ValueError("init_once_multi requires at least one buffer")
+        lengths = [b.nbytes for b in buffers]
+
+        if len(buffers) == 1:
+            # Single buffer: use the original init entry point.
+            try:
+                ret = _call_with_timeout(
+                    pynds_kv.init, timeout, buffers[0], lengths[0], nds_config_path
+                )
+            except Exception:
+                _pynds_init_failed = True
+                raise
+            if ret != 0:
+                _pynds_init_failed = True
+                raise RuntimeError(f"pynds_kv.init failed with return code {ret}")
+            _pynds_initialized = True
+            _pynds_registered_mrs = 1
+            logger.info("pynds_kv initialized successfully (1 MR)")
+            return 1
+
+        init_multi = getattr(pynds_kv, "init_multi", None)
+        ret = -1
+        if init_multi is not None:
+            try:
+                ret = _call_with_timeout(
+                    init_multi, timeout, buffers, lengths, nds_config_path
+                )
+            except Exception:
+                _pynds_init_failed = True
+                raise
+        if ret == 0:
+            _pynds_initialized = True
+            _pynds_registered_mrs = len(buffers)
+            logger.info(
+                "pynds_kv initialized successfully with %d MRs", len(buffers)
+            )
+            return len(buffers)
+
+        # Fallback: register only the anchor buffer; the rest will stage.
+        if init_multi is None:
+            logger.warning(
+                "installed pynds_kv has no init_multi; falling back to "
+                "single-MR init (extra pools will use staging copies)"
+            )
+        else:
+            logger.warning(
+                "pynds_kv.init_multi failed with return code %s; falling back "
+                "to single-MR init (extra pools will use staging copies)",
+                ret,
+            )
+        try:
+            ret = _call_with_timeout(
+                pynds_kv.init, timeout, buffers[0], lengths[0], nds_config_path
+            )
+        except Exception:
+            _pynds_init_failed = True
+            raise
+        if ret != 0:
+            _pynds_init_failed = True
+            raise RuntimeError(f"pynds_kv.init failed with return code {ret}")
+        _pynds_initialized = True
+        _pynds_registered_mrs = 1
+        logger.info("pynds_kv initialized successfully (1 MR, fallback)")
+        return 1
+
+
+class PyndsClient:
+    """Thread-safe client wrapper around pynds_kv with timeout and health tracking.
+
+    Read and write health are tracked separately: write (``batch_put``)
+    failures mark the client unhealthy after ``failure_threshold`` consecutive
+    failures, which gates the backup path; read (``batch_get``/``is_exists``)
+    failures only degrade to cache misses and never flip ``_healthy`` — the
+    NDS box flow-controls read bursts (e.g. MLA TP ranks reading the shared
+    rank-replicated key space), and flapping reads must not stall writes.
+
+    Args:
+        nsid: Namespace ID for NDS.
+        timeout: Timeout in seconds for each pynds_kv call.
+        max_workers: Maximum number of concurrent pynds_kv calls allowed.
+            If <= 0, no concurrency limit is enforced.
+        failure_threshold: Consecutive write failures before marking the
+            backend unhealthy.  Read failures are counted separately and do
+            not affect health.
+    """
+
+    def __init__(
+        self,
+        nsid: int,
+        timeout: float = 30.0,
+        max_workers: int = 32,
+        failure_threshold: int = 1,
+    ):
+        self.nsid = nsid
+        self.timeout = timeout
+        self.max_workers = max_workers
+        self.failure_threshold = failure_threshold
+        self._consecutive_failures = 0
+        self._consecutive_read_failures = 0
+        self._healthy = True
+        self._health_lock = threading.Lock()
+        if max_workers > 0:
+            self._semaphore = threading.Semaphore(max_workers)
+        else:
+            self._semaphore = None
+
+    def is_healthy(self) -> bool:
+        """Return True if the backend is considered healthy."""
+        with self._health_lock:
+            return self._healthy
+
+    def read_failure_count(self) -> int:
+        """Current consecutive read-path failure count.
+
+        Used by the storage backend's read circuit breaker: reads are gated
+        once this reaches the configured threshold, and one probe read per
+        probe interval is let through while gated.
+        """
+        with self._health_lock:
+            return self._consecutive_read_failures
+
+    def close(self) -> None:
+        """No-op: the client no longer owns a thread pool."""
+        pass
+
+    def _call(
+        self,
+        func: Callable[..., Any],
+        *args: Any,
+        _on_failure: Optional[Callable[[], None]] = None,
+        **kwargs: Any,
+    ) -> Any:
+        """Run a pynds_kv call with a timeout and track failures.
+
+        A semaphore caps the number of concurrent pynds_kv calls to
+        ``max_workers``.  The semaphore is acquired before the daemon thread is
+        spawned and released after the thread finishes, including on timeout.
+
+        ``_on_failure`` overrides the failure recorder (default
+        ``_record_failure``); read entry points pass ``_record_read_failure``
+        so that read-side timeouts do not gate the write path.
+
+        Note:
+            A timed-out daemon thread may continue executing the underlying C
+            call in the background.  The semaphore limits new calls but does
+            not cancel in-flight ones.
+        """
+        record = self._record_failure if _on_failure is None else _on_failure
+        if self._semaphore is None:
+            try:
+                return _call_with_timeout(func, self.timeout, *args, **kwargs)
+            except Exception as e:
+                record()
+                raise e
+
+        with self._semaphore:
+            try:
+                return _call_with_timeout(func, self.timeout, *args, **kwargs)
+            except Exception as e:
+                record()
+                raise e
+
+    def _record_failure(self) -> None:
+        with self._health_lock:
+            self._consecutive_failures += 1
+            if self._consecutive_failures >= self.failure_threshold:
+                if self._healthy:
+                    logger.error(
+                        "pynds_kv backend marked unhealthy after %d "
+                        "consecutive failures",
+                        self._consecutive_failures,
+                    )
+                self._healthy = False
+
+    def _record_read_failure(self) -> None:
+        """Count a read-path failure without flipping the backend unhealthy.
+
+        Read failures (batch_get / is_exists) degrade to cache misses, so they
+        must not gate writes: when the NDS box flow-controls read bursts (e.g.
+        all TP ranks of an MLA model reading the same rank-replicated key
+        space), flapping reads would otherwise stall the backup path through
+        the unhealthy circuit breaker.  The counter is logged every 10
+        consecutive failures and reset by ``_record_success``.
+        """
+        with self._health_lock:
+            self._consecutive_read_failures += 1
+            if self._consecutive_read_failures % 10 == 1:
+                logger.warning(
+                    "pynds_kv read path failing: %d consecutive failures "
+                    "(reads degrade to cache miss; writes stay enabled)",
+                    self._consecutive_read_failures,
+                )
+
+    def _record_success(self) -> None:
+        with self._health_lock:
+            if not self._healthy:
+                logger.info("pynds_kv backend recovered to healthy")
+            self._consecutive_failures = 0
+            self._consecutive_read_failures = 0
+            self._healthy = True
+
+    def is_exists(self, block_ids: List[int], nsid: Optional[int] = None) -> int:
+        """Check how many consecutive block_ids exist in NDS.
+
+        Args:
+            block_ids: Block IDs to query.
+            nsid: Namespace override; defaults to the client's configured nsid.
+                DSA indexer-pool keys may live in a separate namespace whose
+                valueSize matches the indexer page size.
+        """
+        import pynds_kv
+
+        ret = self._call(
+            pynds_kv.is_exists,
+            block_ids,
+            self.nsid if nsid is None else nsid,
+            _on_failure=self._record_read_failure,
+        )
+        if ret < 0:
+            self._record_read_failure()
+        else:
+            self._record_success()
+        return ret
+
+    def batch_get(
+        self,
+        block_ids: List[int],
+        buffers: List[np.ndarray],
+        offsets: List[int],
+        lengths: List[int],
+        nsids: List[int],
+    ) -> int:
+        """Batch read blocks from NDS into the provided buffers."""
+        import pynds_kv
+
+        ret = self._call(
+            pynds_kv.batchGet,
+            block_ids,
+            buffers,
+            offsets,
+            lengths,
+            nsids,
+            _on_failure=self._record_read_failure,
+        )
+        if ret != 0:
+            self._record_read_failure()
+        else:
+            self._record_success()
+        return ret
+
+    def batch_put(
+        self,
+        block_ids: List[int],
+        buffers: List[np.ndarray],
+        offsets: List[int],
+        lengths: List[int],
+        nsids: List[int],
+    ) -> int:
+        """Batch write blocks from the provided buffers into NDS."""
+        import pynds_kv
+
+        ret = self._call(pynds_kv.batchPut, block_ids, buffers, offsets, lengths, nsids)
+        if ret != 0:
+            self._record_failure()
+        else:
+            self._record_success()
+        return ret
