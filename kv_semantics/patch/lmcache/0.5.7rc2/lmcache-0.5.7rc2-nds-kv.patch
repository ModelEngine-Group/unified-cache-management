+                                "on_complete_callback failed for key %s: %s",
+                                key,
+                                e,
+                            )
+            except Exception as e:
+                logger.error("batched_put_blocking failed: %s", e)
+            finally:
+                for memory_obj in filtered_objs:
+                    memory_obj.ref_count_down()
+                for key in filtered_keys:
+                    self.kv_worker.remove_put_task(key)
