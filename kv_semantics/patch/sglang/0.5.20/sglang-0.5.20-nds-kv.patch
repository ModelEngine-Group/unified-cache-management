+             limits (in-flight prefetch budget or host memory pressure).
+             Worth retrying while the request waits in the queue.
+    DONE:    prefetch completed / not applicable. Never retry.
+    """
+
+    NONE = auto()
+    ISSUED = auto()
+    BLOCKED = auto()
+    DONE = auto()
