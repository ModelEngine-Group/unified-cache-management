{
  "title": "UCM Pipeline Store",
  "metrics": [
    {
      "name": "ucm:cache_lookup_hit_blocks_total",
      "type": "counter",
      "op": "rate",
      "unit": "blocks/s",
      "group_by": ["worker_id"]
    },
    {
      "name": "ucm:cache_lookup_miss_blocks_total",
      "type": "counter",
      "op": "rate",
      "unit": "blocks/s",
      "group_by": ["worker_id"]
    },
    {
      "name": "ucm:cache_load_bytes_total",
      "type": "counter",
      "op": "rate",
      "scale": 1e-9,
      "unit": "GB/s",
      "group_by": ["worker_id"]
    },
    {
      "name": "ucm:cache_dump_bytes_total",
      "type": "counter",
      "op": "rate",
      "scale": 1e-9,
      "unit": "GB/s",
      "group_by": ["worker_id"]
    },
    {
      "name": "ucm:cache_lookup_duration_ms",
      "type": "histogram",
      "avg": true,
      "quantiles": [0.5, 0.9, 0.99],
      "unit": "ms",
      "group_by": ["worker_id"]
    },
    {
      "name": "ucm:cache_load_duration_ms",
      "type": "histogram",
      "avg": true,
      "quantiles": [0.5, 0.9, 0.99],
      "unit": "ms",
      "group_by": ["worker_id"]
    },
    {
      "name": "ucm:cache_dump_duration_ms",
      "type": "histogram",
      "avg": true,
      "quantiles": [0.5, 0.9, 0.99],
      "unit": "ms",
      "group_by": ["worker_id"]
    },
    {
      "name": "ucm:posix_load_task_duration_ms",
      "type": "histogram",
      "avg": true,
      "quantiles": [0.5, 0.9, 0.99],
      "unit": "ms",
      "group_by": ["worker_id"]
    },
    {
      "name": "ucm:posix_dump_task_duration_ms",
      "type": "histogram",
      "avg": true,
      "quantiles": [0.5, 0.9, 0.99],
      "unit": "ms",
      "group_by": ["worker_id"]
    }
  ]
}
