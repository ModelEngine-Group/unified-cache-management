+    def group_kv_pull(self, metadata: OdKvStorageConnectorMetadata):
+        kv_pulls = collections.defaultdict(list)
+        tp_rank = self._tp_rank
+        for req_id, meta in metadata.pd_disagg_request_meta.items():
+            # logger.debug(
+                # "start_load_kv for request %s from remote engine. "
+                # "Num local_block_ids: %s.", req_id, len(meta.local_block_ids))
+            path = make_zmq_path("tcp", meta.remote_host,
+                meta.remote_port + self._dp_rank * self._pp_size * self._tp_size + self._pp_rank * self._tp_size + self._tp_rank)
+            kv_pulls[path].append((req_id, meta))
+
+        return kv_pulls
+
+    def start_pd_pull_layer(
+        self,
+        forward_context: "ForwardContext",
+        connector_metadata: OdKvStorageConnectorMetadata,
+    ) -> None:
+        grouped_req = self.group_kv_pull(connector_metadata)
+        if not grouped_req:
+            return
+
+        context, ret = acl.rt.get_context()
+        if ret != 0:
+            raise RuntimeError(f"get ACL context failed: ret={ret}")
+
+        def wait_task(wait_queue, stream_idx, context):
+            while True:
+                task = wait_queue.get()
+                try:
+                    if task is None:
+                        return
+
+                    io_metadata_list, future = task
+                    try:
+                        ret = acl.rt.set_context(context)
+                        if ret != 0:
+                            raise RuntimeError(
+                                f"set wait thread ACL context failed: ret={ret}"
+                            )
+
+                        self._read_blocks_wait_task(io_metadata_list, stream_idx)
+                    except Exception as exc:
+                        future.set_exception(exc)
+                    else:
+                        future.set_result(None)
+                finally:
+                    wait_queue.task_done()
+
+        def send_task(path, metas, stream_idx, context, wait_queue, io_seq):
+            try:
+                ret = acl.rt.set_context(context)
+                if ret != 0:
+                    raise RuntimeError(
+                        f"set send thread ACL context failed: ret={ret}"
+                    )
+
+                self._read_blocks(path, metas, stream_idx, wait_queue, io_seq)
+            finally:
+                wait_queue.put(None)
+
+        for path, metas in grouped_req.items():
+            stream_idx = self._pd_async_load_stream_prev
+            io_seq = self._io_seq
+            self._io_seq += 1
+            wait_queue = queue.Queue(maxsize=16)
+
+            wait_thread = threading.Thread(
+                target=wait_task,
+                args=(wait_queue, stream_idx, context),
+                name="wait_thread",
+            )
+            send_thread = threading.Thread(
+                target=send_task,
+                args=(path, metas, stream_idx, context, wait_queue, io_seq),
+                name="send_thread",
+            )
+
+            wait_thread.start()
+            try:
+                send_thread.start()
+            except Exception:
+                wait_queue.put(None)
+                raise
+            self._pd_async_load_stream_prev = (
+                stream_idx + 1
+            ) % len(self._pd_async_load_stream)
+
