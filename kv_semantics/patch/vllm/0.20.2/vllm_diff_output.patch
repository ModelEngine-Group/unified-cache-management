+    @timeit
+    def start_load_kv(self, forward_context: "ForwardContext",
+                      connector_metadata: OdKvStorageConnectorMetadata) -> None:
+        """Start loading the KV cache from the connector buffer to vLLM's 
+        paged KV buffer.
+
+        Args:
+            forward_context (ForwardContext): the forward context.
+            **kwargs: additional arguments for the load operation
+
+        Note:
+            The number of elements in kv_caches and layer_names should be 
+            the same.
+        """
+        tp_rank = self._tp_rank
+
+
+        # OD_DEBUG
+        if self._kv_role == "kv_consumer":
+            self._load_input = []
+            self._store_input = []
+            req_ids = list(connector_metadata.pd_disagg_request_meta.keys())
+            if req_ids:
+                self._batch_id = self._storage_interface._str_to_int_id(req_ids[0])
+                if self._tp_rank == 0:
+                    for req_id in req_ids:
+                        logger.error(
+                            "[OD] batch_id: %s, req_id: %s",
+                            self._storage_interface._str_to_int_id(req_id), req_id)
+
+            self.start_pd_pull_layer(
+                forward_context,
+                connector_metadata,
+            )
+            return
+        # prefill prefix cache
+        
+        # call load
+        req_ids = list(connector_metadata.request_meta.keys())
+
+        if not req_ids:
+            self._load_input = []
+            self._store_input = []
+            return
+
+        self._batch_id = self._storage_interface._str_to_int_id(req_ids[0])
+        self._batch_to_req[self._batch_id] = req_ids
+        io_seq = self._io_seq
+        self._io_seq += 1
+
+        hit_hashes = []
+        hit_block_ids = []
+        store_hashes = []
+        store_block_ids = []
+        for _, req_meta in connector_metadata.request_meta.items():
+            hit_hashes.extend([int(x) for x in req_meta.storage_hit_block_ids[0]])
+            hit_block_ids.extend(req_meta.storage_hit_block_ids[1])
+            store_hashes.extend([int(x) for x in req_meta.persistent_block_ids[0]])
+            store_block_ids.extend(req_meta.persistent_block_ids[1])
+
+        hit_block_num = len(hit_hashes)
+        store_block_num = len(store_hashes)
+
+        self._load_input = []
+        self._store_input = []
+
+        # make load input
+        if len(hit_hashes) > 0:
+            for i in range(self._kv_cache_layer_num):
+                # req_id
+                # mr_id_list
+                # block_hash_list
+                # hbm_addr_list
+                # storage_offset_list
+                # length_list
+                self.prepare_xds_input(self._load_input, i, hit_hashes, hit_block_ids, "prefix_load", self._batch_id, io_seq)
+        # make store input
+        if len(store_hashes) > 0:# and self._kv_role == "kv_producer":
+            for i in range(self._kv_cache_layer_num):
+                self.prepare_xds_input(self._store_input, i, store_hashes, store_block_ids, "prefix_save", self._batch_id, io_seq)
+        if len(hit_hashes) > 0:
+            #logger.warning(f"the input paras for a read: {self._load_input[0]}")
+            self._async_layer_load_task_queue.enqueue(self._async_submit_load_task)
+        return
+
