+            self.kv_lock.acquire()
+            self.dict[key].unpin()
+            self.kv_lock.release()
+
+        return memory_objs
+
+    async def batched_async_contains(
+        self,
+        lookup_id: str,
+        keys: list[CacheEngineKey],
+        pin: bool = False,
+    ) -> int:
