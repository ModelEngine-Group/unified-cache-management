+import queue
+import threading
+import traceback
+from vllm.logger import init_logger
+import os
+logger = init_logger(__name__)
+
+
+class TaskQueue:
+    def __init__(self):
+        self._queue = queue.Queue()
+        self._worker_thread = threading.Thread(target=self._process_queue)
+        self._running = False
+        self._start_lock = threading.Lock()
+
+    def enqueue(self, func, *args, **kwargs):
+        """put func and its params into queue"""
+        self._queue.put((func, args, kwargs))
+
+    def _process_queue(self):
+        """retrieve func and execute"""
+        while self._running:
+            func, args, kwargs = self._queue.get()
+            if func is None:
+                self._queue.task_done()
+                break
+            try:
+                func(*args, **kwargs)
+            except Exception as e:
+                bt = traceback.print_exc()
+                logger.warning(f"execute func {func.__name__} failed with exception: {e}, trace: {bt}")
+            finally:
+                self._queue.task_done()  # 标记任务完成，允许 join() 阻塞
+
+    def start_worker(self):
+        """start working thread"""
+        with self._start_lock:
+            if not self._running:
+                self._running = True
+                self._worker_thread.start()
+
+    def join(self):
+        """block until all func in queue processed"""
+        self._queue.join()
+
+    def stop(self):
+        """stop working process. will wait until current func finishes processing"""
+        with self._start_lock:
+            if self._running:
+                self._running = False
+                self._queue.put((None, None, None))
+                self._worker_thread.join()
