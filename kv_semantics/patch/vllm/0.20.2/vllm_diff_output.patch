+
+        # mla
+        self._use_mla = vllm_config.model_config.use_mla
+
+        pass
+
+
+    #@timeit
+    def xds_init(self, base_addr: list[int], kv_len: list[int]) -> int:
+        ''' 
+            同步接口, 调用2层接口
+            INPUT:
+                model_name: kvs_0/kvs_1，或直接输入自定义模型名称
+                base_addr: kvcache多段起始地址list
+                kv_len: kvcache多段mem空间size list
+            OUTPUT:
+                status (1 succeed, 0 failed)
+        '''
+        ret = 0
+        if self.device_type == "npu":
+            ret = rdma.aiv_init(base_addr, kv_len)
+        elif self.device_type == "cuda":
+            ret = kvs_torch.kvcache_init(base_addr, kv_len)
+            pass
+        # CPU has already warned
+        return ret
+        pass
+
+    def split_uint128(self, num):
+            # 提取低 64 位：与 64 个 1 进行按位与操作
+            # 0xFFFFFFFFFFFFFFFF 等同于 (1 << 64) - 1
+            lower_64 = num & 0xFFFFFFFFFFFFFFFF
+            # 提取高 64 位：向右平移 64 位
+            upper_64 = num >> 64
+            upper_16 = upper_64 & 0xFFFF
+            return lower_64, upper_16
+
+    def batch_get_block_key(self, block_hash_list: list[int]) -> list[rdma.BlockKey]:
+        if len(block_hash_list) == 0:
+            return []
+        # fence of passing BlockKey into func
+        if isinstance(block_hash_list[0], rdma.BlockKey):
+            return block_hash_list
+        return [rdma.BlockKey(*self.split_uint128(block_hash)) for block_hash in block_hash_list]
+
+
+    def batch_split_key_low_high(self, block_hash_list: list[int]) -> tuple[list[int], list[int]]:
+        lower_64s = []
+        upper_64s = []
+        for block_hash in block_hash_list:
+            low64, up64 = self.split_uint128(block_hash)
+            lower_64s.append(low64)
+            upper_64s.append(up64)
+        return lower_64s, upper_64s
+
+
+    #@timeit
