{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "images": {
      "type": "object",
      "properties": {
        "registry": {"type": "string"},
        "pullPolicy": {"type": "string"},
        "image": {"type": "string", "minLength": 1},
        "mooncakeMasterImage": {"type": "string"},
        "engine": {"$ref": "#/definitions/imageReference"},
        "mooncakeMaster": {"$ref": "#/definitions/imageReference"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "imageReference": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {"required": ["tag"]},
        {"required": ["digest"]}
      ]
    }
  }
}
