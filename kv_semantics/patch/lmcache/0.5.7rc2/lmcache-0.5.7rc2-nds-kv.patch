+        buffers = []
+        offsets = []
+        lengths = []
+        nsids = []
+
+        for key, memory_obj in zip(keys, memory_objs, strict=False):
+            buffer = memory_obj.byte_array
+            block_ids.append(self._encode_block_id(key))
+            buffers.append(buffer)
+            offsets.append(0)
+            lengths.append(len(buffer))
+            nsids.append(self.nsid)
+
+        t_batchput_start = time.time()
+        logger.debug("pynds_kv.batchPut")
