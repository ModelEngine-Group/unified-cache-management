          "expr": "max (ucm:dramstore_task_queue_size{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}) / clamp_min(max (ucm:dramstore_task_queue_capacity{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}), 1e-9)",
          "legendFormat": "DramStore task queue",
          "refId": "A"
        },
        {
          "expr": "max (ucm:dramstore_completion_queue_size{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}) / clamp_min(max (ucm:dramstore_completion_queue_capacity{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}), 1e-9)",
          "legendFormat": "DramStore completion queue",
          "refId": "B"
        },
        {
          "expr": "max (ucm:dramstore_transport_queue_size{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}) / clamp_min(max (ucm:dramstore_transport_queue_capacity{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}), 1e-9)",
          "legendFormat": "DramStore transport queue",
          "refId": "C"
        },
        {
          "expr": "max (ucm:drampool_queue_request_size{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}) / clamp_min(max (ucm:drampool_queue_request_capacity{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}), 1e-9)",
          "legendFormat": "DramPool request queue",
          "refId": "D"
        },
        {
          "expr": "max (ucm:drampool_queue_completion_size{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}) / clamp_min(max (ucm:drampool_queue_completion_capacity{job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\",engine=~\"$engine\",worker_rank=~\"$worker_rank\"}), 1e-9)",
