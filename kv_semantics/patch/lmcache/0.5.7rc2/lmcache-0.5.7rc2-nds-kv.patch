+        block_ids = []
+        buffers = []
+        offsets = []
+        lengths = []
+        nsids = []
+
+        for key, mem_obj in pairs:
+            block_ids.append(self._encode_block_id(key))
+            buffers.append(mem_obj.byte_array)
+            offsets.append(0)
+            lengths.append(len(mem_obj.byte_array))
+            nsids.append(self.nsid)
