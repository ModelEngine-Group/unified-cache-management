+import time
+from functools import wraps
+from collections import defaultdict
+from threading import Lock
+import atexit
+
+total_time = defaultdict(float)   # 总耗时
+call_count = defaultdict(int)     # 调用次数
+max_time = defaultdict(float)     # 单次最大耗时
+min_time = defaultdict(float)     # 单次最小耗时
+
+
+def timeit(func):
+    @wraps(func)
+    def wrapper(*args,**kwargs):
+        start = time.perf_counter()
+        result = func(*args, **kwargs)
+        elapsed = time.perf_counter() - start
+
+        func_name = f"{func.__module__}.{func.__qualname__}"  # 唯一标识函数
+
+        total_time[func_name] += elapsed
+        call_count[func_name] += 1
+
+        # 更新最大和最小耗时
+        if call_count[func_name] == 1:
+            max_time[func_name] = elapsed
+            min_time[func_name] = elapsed
+        else:
+            if elapsed > max_time[func_name]:
+                max_time[func_name] = elapsed
+            if elapsed < min_time[func_name]:
+                min_time[func_name] = elapsed
+
+        #print(f"[单次] {func_name} 耗时: {elapsed:.4f}s")
+        return result
+    return wrapper
+
+
+def print_time_stats(tp_rank=0):
+    sorted_total = sorted(total_time.items(), key=lambda x: x[1], reverse=True)
+    # 各列宽度定义
+
+    func_width = 70
+    col_width = 20
+    sep = " | "
+    total_width = (col_width + len(sep)) * 6 - len(sep)
+
+    output_lines = []
+
+    # 标题行
+    header = (
+        f"rank {tp_rank}{sep}"
+        f"{'函数名':<{func_width}}{sep}"
+        f"{'总耗时(s)':<{col_width}}{sep}"
+        f"{'平均耗时(s)':<{col_width}}{sep}"
+        f"{'最大耗时(s)':<{col_width}}{sep}"
+        f"{'最小耗时(s)':<{col_width}}{sep}"
+        f"{'调用次数':<{col_width}}"
+    )
+    print("\n" + header)
+    print("-" * total_width)
+
+    output_lines.append("\n" + header)
+    output_lines.append("-" * total_width)
+
+    # 数据行
+    for func_name, total in sorted_total:
+        count = call_count[func_name]
+        avg = total / count if count > 0 else 0
+        max_t = max_time[func_name]
+        min_t = min_time[func_name]
+
+        row = (
+            f"rank {tp_rank}{sep}"
+            f"{func_name:<{func_width}}{sep}"
+            f"{total:<{col_width}.4f}{sep}"
+            f"{avg:<{col_width}.4f}{sep}"
+            f"{max_t:<{col_width}.4f}{sep}"
+            f"{min_t:<{col_width}.4f}{sep}"
+            f"{count:<{col_width}d}"
+        )
+        print(row)
+        output_lines.append(row)
+
+    with open("/vllm-workspace/vllm_func.txt", 'a', encoding='utf-8') as f:
+        for line in output_lines:
+            print(line, file=f)
+            
+
+def clean_time_stats():
+    global total_time, call_count, max_time, min_time
+    total_time = defaultdict(float)
+    call_count = defaultdict(int)
+    max_time = defaultdict(float)
+    min_time = defaultdict(float)
