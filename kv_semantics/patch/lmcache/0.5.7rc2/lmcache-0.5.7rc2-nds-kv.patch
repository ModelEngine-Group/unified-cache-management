+    def batched_put_blocking(
+        self,
+        keys: list[CacheEngineKey],
+        memory_objs: List[MemoryObj],
+    ) -> None:
+        # Third Party
+        import pynds_kv
+
+        self._ensure_nds_initialized()
+
+        if not keys or not memory_objs:
+            return
