{
  "id": null,
  "uid": "sglang-dashboard",
  "title": "SGLang + UCM / Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "tags": [
    "sglang",
    "ucm"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "options": [],
        "hide": 0
      },
      {
        "name": "sglang_prefix",
        "label": "SGLang prefix",
        "type": "textbox",
        "query": "sglang:",
        "current": {
          "text": "sglang:",
          "value": "sglang:"
        },
        "hide": 2
      },
      {
        "name": "ucm_prefix",
        "label": "UCM prefix",
        "type": "textbox",
        "query": "ucm:",
        "current": {
          "text": "ucm:",
          "value": "ucm:"
        },
        "hide": 2
      },
      {
        "name": "model_name",
        "label": "model_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"${sglang_prefix}.*|${ucm_prefix}.*\",model_name!=\"\"}, model_name)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"${sglang_prefix}.*|${ucm_prefix}.*\",model_name!=\"\"}, model_name)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"${sglang_prefix}.*|${ucm_prefix}.*\",model_name=~\"$model_name\"}, job)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"${sglang_prefix}.*|${ucm_prefix}.*\",model_name=~\"$model_name\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"${sglang_prefix}.*|${ucm_prefix}.*\",model_name=~\"$model_name\",job=~\"$job\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"${sglang_prefix}.*|${ucm_prefix}.*\",model_name=~\"$model_name\",job=~\"$job\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "worker_id",
        "label": "worker_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({__name__=~\"${ucm_prefix}.*\",job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\"}, worker_id)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"${ucm_prefix}.*\",job=~\"$job\",instance=~\"$instance\",model_name=~\"$model_name\"}, worker_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "About this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Serving performance and UCM summary. Native serving panels use job / instance / model_name; worker_id filters UCM metrics. Connector throughput counts successful bytes, while request duration includes failed attempts. Storage health=1 means the breaker is enabled, not that every I/O succeeded. Open HiCache for cache scheduling, or Connector & Store for physical I/O and backend diagnostics. Missing series remain No data."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
