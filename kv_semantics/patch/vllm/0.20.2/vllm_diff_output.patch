+def align_to_block_size(num_tokens: int, block_size) -> int:
+    """Align the number of tokens to the block size.
+    """
+    return (num_tokens - 1) // block_size * block_size
+
+
+def get_shared_mem_resources(shm_name, shm_size, engine_id):
+    """
+    create shared memory
+    """
+    # 1. initialize
+    try:
+        shm = shared_memory.SharedMemory(name=shm_name + engine_id, create=True, size=shm_size)
+        shm.buf[:shm_size] = b'\x00' * shm_size # creator clean the memory
+    except FileExistsError:
+        # sleep for a while to wait shm created
+        time.sleep(5)
+        shm = shared_memory.SharedMemory(name=shm_name + engine_id)
+    
+    int64_view = shm.buf.cast('q')
+    return shm, int64_view
+
+
+def get_event_pipe(pipe_path):
+    """
+    safely create pipe and avoid racing
+    """
+    try:
+        # try create pipe
+        os.mkfifo(pipe_path, mode=0o666)
+        print(f"[*] pip {pipe_path} successfully created")
+    except FileExistsError:
+        # if exist, then check if it's a real pipe
+        if not stat.S_ISFIFO(os.stat(pipe_path).st_mode):
+            raise RuntimeError(f"path {pipe_path} exists and is not a FIFO pipe")
+        print(f"[*] pipe {pipe_path} exists，just use it")
+    
+    return pipe_path
+
