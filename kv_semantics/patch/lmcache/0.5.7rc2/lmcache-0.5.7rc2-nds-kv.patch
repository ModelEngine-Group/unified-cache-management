+from lmcache.v1.storage_backend.pd_backend import (
+    AllocRequest,
+    AllocResponse,
+    PDMsg,
+    ProxyNotif,
+)
+
+if TYPE_CHECKING:
+    # First Party
+    from lmcache.inprocess.v1.cache_controller.worker import LMCacheWorker
+
+logger = init_logger(__name__)
+
+
+@dataclass
+class _RequestState:
+    """All batches and completion callbacks belonging to one PD request."""
+
+    keys: list[CacheEngineKey] = field(default_factory=list)
+    callbacks: list[
+        tuple[list[CacheEngineKey], Callable[[CacheEngineKey], None]]
+    ] = field(default_factory=list)
+    pending: int = 0
+    last_seen: bool = False
+    failed: bool = False
+    condition: threading.Condition = field(
+        default_factory=lambda: threading.Condition(threading.Lock())
+    )
+
+
+class NDSPDBackend(KVStorageBackend, AllocatorBackendInterface):
+    """Transfer disaggregated-prefill KV exclusively through an NDS disk frame.
+
+    The existing PD control channel carries allocation metadata only. The
+    sender writes every KV chunk to NDS and waits for request-wide visibility
+    before notifying the proxy. The receiver independently enforces the same
+    visibility barrier before every NDS read, so an early external scheduler
+    cannot expose a partially written request.
+    """
+
+    def __init__(
+        self,
+        config: LMCacheEngineConfig,
+        loop: asyncio.AbstractEventLoop,
+        local_cpu_backend: LocalCPUBackend,
+        dst_device: str,
+        lmcache_worker: Optional["LMCacheWorker"],
+        metadata: LMCacheMetadata,
+    ) -> None:
+        """Initialize shared NDS storage and the metadata-only PD channel.
+
+        :param config: LMCache and NDS PD configuration.
+        :param loop: Event loop retained by the underlying KV backend.
+        :param local_cpu_backend: Pinned-memory allocator and NDS staging pool.
+        :param dst_device: Device on which retrieved memory is consumed.
+        :param lmcache_worker: Optional controller worker.
+        :param metadata: Model and tensor-parallel metadata.
+        :raises ValueError: If the PD role or required endpoints are invalid.
+        """
+        super().__init__(
+            config,
+            loop,
+            local_cpu_backend,
+            dst_device,
+            lmcache_worker,
+            metadata,
+        )
+        self.pd_role = config.pd_role
+        self.tp_rank = metadata.worker_id
+        self._sync_timeout = config.kv_storage_pd_sync_timeout
+        self._closed = threading.Event()
+        self._requests: dict[str, _RequestState] = {}
+        self._requests_lock = threading.Lock()
+        self._pd_metadata: dict[CacheEngineKey, DiskCacheMetadata] = {}
+        self._pd_metadata_lock = threading.Lock()
+        self._metadata_sockets: dict[str, zmq.Socket] = {}
+        self._metadata_lock = threading.Lock()
+        self._proxy_lock = threading.Lock()
+        self._proxy_socket: Optional[zmq.Socket] = None
+        self._alloc_socket: Optional[zmq.Socket] = None
+        self._alloc_thread: Optional[threading.Thread] = None
+        self._zmq_context = get_zmq_context(use_asyncio=False)
+        self._put_executor = ThreadPoolExecutor(
+            max_workers=config.kv_storage_pynds_workers,
+            thread_name_prefix=f"nds-pd-tp{self.tp_rank}",
+        )
+
+        if self.pd_role not in ("sender", "receiver", "both"):
+            raise ValueError(f"Unsupported NDS PD role: {self.pd_role!r}")
+        if self.pd_role in ("sender", "both"):
+            if not config.pd_skip_proxy_notification:
+                if config.pd_proxy_host is None or config.pd_proxy_port is None:
+                    raise ValueError(
+                        "NDS PD sender requires pd_proxy_host and pd_proxy_port"
+                    )
+                proxy_url = f"{config.pd_proxy_host}:{config.pd_proxy_port}"
+                self._proxy_socket = get_zmq_socket(
+                    self._zmq_context, proxy_url, "tcp", zmq.PUSH, "connect"
+                )
+        if self.pd_role in ("receiver", "both"):
+            if config.pd_peer_host is None or config.pd_peer_alloc_port is None:
+                raise ValueError(
+                    "NDS PD receiver requires pd_peer_host and pd_peer_alloc_port"
+                )
+            alloc_url = (
+                f"{config.pd_peer_host}:{config.pd_peer_alloc_port[self.tp_rank]}"
+            )
+            self._alloc_socket = get_zmq_socket(
+                self._zmq_context, alloc_url, "tcp", zmq.REP, "bind"
+            )
+            self._alloc_socket.setsockopt(zmq.RCVTIMEO, 200)
+            self._alloc_thread = threading.Thread(
+                target=self._metadata_loop,
+                name=f"nds-pd-metadata-tp{self.tp_rank}",
+                daemon=True,
+            )
+            self._alloc_thread.start()
+
+    def __str__(self) -> str:
+        """Return the storage-manager location used by existing PD configs."""
+        return "PDBackend"
+
+    def initialize_allocator(
+        self, config: LMCacheEngineConfig, metadata: LMCacheMetadata
+    ) -> MemoryAllocatorInterface:
+        """Return the existing CPU allocator without creating a second pool.
+
+        :param config: Unused; the shared CPU backend is already initialized.
+        :param metadata: Unused; the shared CPU backend is already initialized.
+        :return: The pinned-memory allocator shared with NDS.
+        """
+        return self.local_cpu_backend.get_memory_allocator()
+
+    def get_memory_allocator(self) -> MemoryAllocatorInterface:
+        """Return the pinned-memory allocator used for NDS staging."""
+        return self.local_cpu_backend.get_memory_allocator()
+
+    def allocate(
+        self,
+        shapes: Union[torch.Size, list[torch.Size]],
+        dtypes: Union[torch.dtype, list[torch.dtype]],
+        fmt: MemoryFormat = MemoryFormat.KV_2LTD,
+        eviction: bool = True,
+        busy_loop: bool = True,
+    ) -> Optional[MemoryObj]:
+        """Allocate a staging object from the shared CPU pool.
+
+        :param shapes: One shape or one shape per KV group.
+        :param dtypes: One dtype or one dtype per KV group.
+        :param fmt: KV memory layout.
+        :param eviction: Whether allocation may evict CPU-cache entries.
+        :param busy_loop: Whether to wait for memory under pressure.
+        :return: An allocated object, or ``None`` when no memory is available.
+        """
+        return self.local_cpu_backend.allocate(
+            shapes, dtypes, fmt, eviction=eviction, busy_loop=busy_loop
+        )
+
+    def batched_allocate(
+        self,
+        shapes: Union[torch.Size, list[torch.Size]],
+        dtypes: Union[torch.dtype, list[torch.dtype]],
+        batch_size: int,
+        fmt: MemoryFormat = MemoryFormat.KV_2LTD,
+        eviction: bool = True,
+        busy_loop: bool = True,
+    ) -> Optional[list[MemoryObj]]:
+        """Allocate a batch from the shared CPU staging pool.
+
+        :param shapes: Shape of each object, or shapes of its KV groups.
+        :param dtypes: Dtype of each object, or dtypes of its KV groups.
+        :param batch_size: Number of objects to allocate.
+        :param fmt: KV memory layout.
+        :param eviction: Whether allocation may evict CPU-cache entries.
+        :param busy_loop: Whether to wait for memory under pressure.
+        :return: Allocated objects, or ``None`` when allocation fails.
+        """
+        return self.local_cpu_backend.batched_allocate(
+            shapes,
+            dtypes,
+            batch_size,
+            fmt,
+            eviction=eviction,
+            busy_loop=busy_loop,
+        )
+
+    def batched_submit_put_task(
+        self,
+        keys: Sequence[CacheEngineKey],
+        objs: List[MemoryObj],
+        transfer_spec: Any = None,
+        on_complete_callback: Optional[Callable[[CacheEngineKey], None]] = None,
+    ) -> Optional[list[Future]]:
+        """Register metadata, write one batch to NDS, and publish when complete.
+
+        The last-prefill future resolves only after all batches of its request
+        are visible and ``ProxyNotif`` has been sent. Completion callbacks are
+        likewise deferred until that request-wide barrier succeeds.
+
+        :param keys: Chunk keys in this prefill batch.
+        :param objs: KV objects to write to the disk frame.
+        :param transfer_spec: Receiver endpoints, request id, and last marker.
+        :param on_complete_callback: Optional per-key post-publication callback.
+        :return: One future for this batch, or ``None`` for a local request.
+        :raises ValueError: If a batch arrives after its last-prefill batch.
+        """
+        if transfer_spec is None or not keys:
+            return None
+
+        self._send_metadata(keys, objs, transfer_spec)
+        req_id = transfer_spec.req_id
+        is_last = transfer_spec.is_last_prefill
+        with self._requests_lock:
+            state = self._requests.get(req_id)
+            if state is None:
+                state = _RequestState()
+                self._requests[req_id] = state
+            if state.last_seen:
+                raise ValueError(f"NDS PD batch received after last prefill: {req_id}")
+            state.keys.extend(keys)
+            state.pending += 1
+            state.last_seen = is_last
+
+        for memory_obj in objs:
+            memory_obj.ref_count_up()
+        future: Future = Future()
+        try:
+            self._put_executor.submit(
+                self._put_batch,
+                state,
+                req_id,
+                list(keys),
+                objs,
+                is_last,
+                future,
+                on_complete_callback,
+            )
+        except RuntimeError:
+            for memory_obj in objs:
+                memory_obj.ref_count_down()
+            self._fail_unsubmitted_batch(state, future)
+        return [future]
+
+    def get_blocking(self, key: CacheEngineKey) -> Optional[MemoryObj]:
+        """Read one chunk only after its NDS key is visible.
+
+        :param key: Chunk key to retrieve.
+        :return: The retrieved object, or ``None`` if metadata is unavailable
+            or the visibility barrier times out.
+        """
+        if not self._install_pd_metadata([key]):
+            return None
+        if not self.wait_until_exists(
+            [key], self._sync_timeout, stop_event=self._closed
+        ):
+            return None
+        return super().get_blocking(key)
+
+    def batched_get_blocking(
+        self, keys: list[CacheEngineKey]
+    ) -> list[Optional[MemoryObj]]:
+        """Retrieve a batch only after every requested key exists in NDS.
+
+        :param keys: Chunk keys to retrieve from the disk frame.
+        :return: Retrieved objects, or an all-miss result when metadata is
+            incomplete, visibility times out, or shutdown interrupts the wait.
+        """
+        if not self._install_pd_metadata(keys):
+            return [None] * len(keys)
+        if not self.wait_until_exists(
+            keys, self._sync_timeout, stop_event=self._closed
+        ):
+            return [None] * len(keys)
+        return super().batched_get_blocking(keys)
+
+    async def batched_get_non_blocking(
+        self,
+        lookup_id: str,
+        keys: list[CacheEngineKey],
+        transfer_spec: Any = None,
+    ) -> list[MemoryObj]:
+        """Prefetch only after the request batch is fully visible in NDS.
+
+        :param lookup_id: Lookup identifier forwarded to the KV backend.
+        :param keys: Chunk keys to prefetch.
+        :param transfer_spec: Optional transfer specification.
+        :return: Prefetched objects, or an empty list when the gate fails.
+        """
+        if not self._install_pd_metadata(keys):
+            return []
+        if not self.wait_until_exists(
+            keys, self._sync_timeout, stop_event=self._closed
+        ):
+            return []
+        return await super().batched_get_non_blocking(
+            lookup_id, keys, transfer_spec
+        )
+
+    def remove(self, key: CacheEngineKey, force: bool = True) -> bool:
+        """Remove local key state and release its registered PD layout.
+
+        :param key: Chunk key to remove from this backend.
+        :param force: Whether cache-policy eviction accounting is required.
+        :return: ``True`` when the key was present and removed.
+        """
+        removed = super().remove(key, force=force)
+        if removed:
+            with self._pd_metadata_lock:
+                self._pd_metadata.pop(key, None)
+        return removed
+
+    def cancel_request(self, req_id: str) -> None:
+        """Cancel proxy publication and callbacks for an in-flight request.
+
+        :param req_id: Request identifier to cancel. NDS writes already in
+            progress are allowed to drain but can no longer publish the request.
+        """
+        with self._requests_lock:
+            state = self._requests.get(req_id)
+        if state is not None:
+            with state.condition:
+                state.failed = True
+                state.condition.notify_all()
+
+    def close(self) -> None:
+        """Stop publication, drain workers, and close PD control sockets."""
+        self._closed.set()
+        with self._requests_lock:
+            states = list(self._requests.values())
+        for state in states:
+            with state.condition:
+                state.failed = True
+                state.condition.notify_all()
+        self._put_executor.shutdown(wait=True)
+        if self._alloc_thread is not None:
+            self._alloc_thread.join(timeout=5.0)
+        if self._alloc_socket is not None:
+            self._alloc_socket.close(linger=0)
+        for socket in self._metadata_sockets.values():
+            socket.close(linger=0)
+        if self._proxy_socket is not None:
+            self._proxy_socket.close(linger=0)
+        self.kv_worker.close()
+        super().close()
+
+    def _send_metadata(
+        self,
+        keys: Sequence[CacheEngineKey],
+        memory_objs: list[MemoryObj],
+        transfer_spec: Any,
+    ) -> None:
+        """Send allocation layout to D without transferring KV payload."""
+        receiver_id = (
+            transfer_spec.receiver_host
+            + str(transfer_spec.receiver_init_port[self.tp_rank])
+        )
+        receiver_url = (
+            f"{transfer_spec.receiver_host}:"
+            f"{transfer_spec.receiver_alloc_port[self.tp_rank]}"
+        )
+        request = self._make_metadata_request(keys, memory_objs)
+        with self._metadata_lock:
+            socket = self._metadata_sockets.get(receiver_id)
+            if socket is None:
+                socket = get_zmq_socket(
+                    self._zmq_context,
+                    receiver_url,
+                    "tcp",
+                    zmq.REQ,
+                    "connect",
+                )
+                self._metadata_sockets[receiver_id] = socket
+            socket.send(msgspec.msgpack.encode(request))
+            response = msgspec.msgpack.decode(socket.recv(), type=PDMsg)
+        if not isinstance(response, AllocResponse):
+            raise TypeError("NDS PD metadata registration returned invalid response")
+
+    def _make_metadata_request(
+        self,
+        keys: Sequence[CacheEngineKey],
+        memory_objs: list[MemoryObj],
+    ) -> AllocRequest:
+        """Build a control-only allocation message with exact tail shape."""
+        first = memory_objs[0].metadata
+        shapes = first.shapes or [first.shape]
+        dtypes = first.dtypes or [first.dtype]
+        fmt = first.fmt
+        last_shape = memory_objs[-1].metadata.shape
+        return AllocRequest(
+            keys=[key.to_string() for key in keys],
+            fmt=fmt.value,
+            shape=list(shapes[0]),
+            dtype=TORCH_DTYPE_TO_STR_DTYPE[dtypes[0]],
+            last_chunk_toks=last_shape[fmt.token_dim()],
+            shapes=[list(shape) for shape in shapes],
+            dtypes=[TORCH_DTYPE_TO_STR_DTYPE[dtype] for dtype in dtypes],
+        )
+
+    def _metadata_loop(self) -> None:
+        """Receive exact allocation metadata; no payload or buffer allocation."""
+        assert self._alloc_socket is not None
+        while not self._closed.is_set():
+            try:
+                message = self._alloc_socket.recv()
+            except zmq.Again:
+                continue
+            except zmq.ZMQError:
+                if not self._closed.is_set():
+                    logger.exception("NDS PD metadata receive failed")
+                continue
+
+            try:
+                request = msgspec.msgpack.decode(message, type=PDMsg)
+                if not isinstance(request, AllocRequest):
+                    raise TypeError("Expected NDS PD AllocRequest")
+                self._register_metadata(request)
+            except Exception:
+                logger.exception("Failed to register NDS PD metadata")
+            try:
+                self._alloc_socket.send(
+                    msgspec.msgpack.encode(AllocResponse([], []))
+                )
+            except zmq.ZMQError:
+                if not self._closed.is_set():
+                    logger.exception("NDS PD metadata response failed")
+
+    def _register_metadata(self, request: AllocRequest) -> None:
+        """Recover per-key shapes, including the partial final chunk."""
+        fmt = MemoryFormat(request.fmt)
+        shape_groups = request.shapes or [request.shape]
+        dtype_names = request.dtypes or [request.dtype]
+        dtypes = [STR_DTYPE_TO_TORCH_DTYPE[name] for name in dtype_names]
+        if len(shape_groups) != len(dtypes):
+            raise ValueError("NDS PD metadata shapes/dtypes length mismatch")
+
+        for index, key_string in enumerate(request.keys):
+            mutable_shapes = [list(shape) for shape in shape_groups]
+            if index == len(request.keys) - 1:
+                token_dim = fmt.token_dim()
+                for shape in mutable_shapes:
+                    shape[token_dim] = request.last_chunk_toks
+            shapes = [torch.Size(shape) for shape in mutable_shapes]
+            size = sum(
+                shape.numel() * dtype.itemsize
+                for shape, dtype in zip(shapes, dtypes, strict=True)
+            )
+            metadata = DiskCacheMetadata(
+                "",
+                size,
+                shapes[0],
+                dtypes[0],
+                None,
+                fmt,
+                0,
+                shapes=shapes,
+                dtypes=dtypes,
+            )
+            key = CacheEngineKey.from_string(key_string)
+            with self._pd_metadata_lock:
+                self._pd_metadata[key] = metadata
+
+    def _install_pd_metadata(self, keys: Sequence[CacheEngineKey]) -> bool:
+        """Install registered layouts into the KV backend before allocation."""
+        with self._pd_metadata_lock:
+            metadata = [self._pd_metadata.get(key) for key in keys]
+        if any(item is None for item in metadata):
+            return False
+        with self.kv_lock:
+            for key, item in zip(keys, metadata, strict=True):
+                assert item is not None
+                self.dict[key] = DiskCacheMetadata(
+                    "",
+                    item.size,
+                    item.shape,
+                    item.dtype,
+                    item.cached_positions,
+                    item.fmt,
+                    0,
+                    shapes=item.shapes,
+                    dtypes=item.dtypes,
+                )
+        return True
+
+    def _put_batch(
+        self,
+        state: _RequestState,
+        req_id: str,
+        keys: list[CacheEngineKey],
+        memory_objs: list[MemoryObj],
+        is_last: bool,
+        future: Future,
+        callback: Optional[Callable[[CacheEngineKey], None]],
+    ) -> None:
+        """Write and fence one batch; the last worker publishes the request."""
+        error: Optional[RuntimeError] = None
+        try:
+            self.batched_put_blocking(keys, memory_objs)
+            if not self.wait_until_exists(
+                keys, self._sync_timeout, stop_event=self._closed
+            ):
+                error = RuntimeError(f"NDS PD batch visibility timed out: {req_id}")
+        except Exception:
+            logger.exception("NDS PD batch put failed for request %s", req_id)
+            error = RuntimeError(f"NDS PD batch put failed: {req_id}")
+        finally:
+            for memory_obj in memory_objs:
+                memory_obj.ref_count_down()
+
+        with state.condition:
+            state.pending -= 1
+            state.failed = state.failed or error is not None
+            if error is None and callback is not None:
+                state.callbacks.append((keys, callback))
+            state.condition.notify_all()
+            if not is_last:
+                if error is None:
+                    future.set_result(len(keys))
+                else:
+                    future.set_exception(error)
+                return
+            while state.pending > 0 and not self._closed.is_set():
+                state.condition.wait(timeout=0.1)
+            if state.pending > 0:
+                state.failed = True
+            failed = state.failed
+            request_keys = list(state.keys)
+            callbacks = list(state.callbacks)
+
+        if not failed and not self.wait_until_exists(
+            request_keys, self._sync_timeout, stop_event=self._closed
+        ):
+            failed = True
+            error = RuntimeError(f"NDS PD request visibility timed out: {req_id}")
+        if not failed:
+            try:
+                self._notify_proxy(req_id)
+                self._run_callbacks(callbacks)
+            except Exception:
+                logger.exception("NDS PD publication failed for request %s", req_id)
+                failed = True
+                error = RuntimeError(f"NDS PD publication failed: {req_id}")
+
+        with self._requests_lock:
+            self._requests.pop(req_id, None)
+        if failed:
+            future.set_exception(error or RuntimeError(f"NDS PD failed: {req_id}"))
+        else:
+            future.set_result(len(request_keys))
+
+    def _fail_unsubmitted_batch(
+        self, state: _RequestState, future: Future
+    ) -> None:
+        """Balance request accounting when executor submission is rejected."""
+        with state.condition:
+            state.pending -= 1
+            state.failed = True
+            state.condition.notify_all()
+        future.set_exception(RuntimeError("NDS PD put executor is closed"))
+
+    def _notify_proxy(self, req_id: str) -> None:
+        """Publish request readiness after the request-wide NDS fence."""
+        if self._proxy_socket is None:
+            return
+        message = msgspec.msgpack.encode(ProxyNotif(req_id=req_id))
+        with self._proxy_lock:
+            self._proxy_socket.send(message)
+
+    @staticmethod
+    def _run_callbacks(
+        callbacks: list[
+            tuple[list[CacheEngineKey], Callable[[CacheEngineKey], None]]
+        ],
+    ) -> None:
+        """Run per-key callbacks only after request-wide publication."""
+        for keys, callback in callbacks:
+            for key in keys:
+                try:
+                    callback(key)
+                except Exception as exc:
+                    logger.warning(
+                        "on_complete_callback failed for key %s: %s", key, exc
+                    )
